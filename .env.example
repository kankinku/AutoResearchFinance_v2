OPENAI_AUTH_MODE=oauth_proxy
OPENAI_BASE_URL=http://127.0.0.1:10531/v1
OPENAI_MODEL=gpt-5.4
OPENAI_OAUTH_PROXY_COMMAND=npx openai-oauth
OPENAI_OAUTH_AUTH_FILE=
# Optional manual chart override. Leave unset when using --target selection.
# AF_CHART_SYMBOL=QQQ
# AF_CHART_TIMEFRAME=120
# AF_CHART_TYPE=candles
# AF_MAX_TRADES=50
AF_EVALUATION_EXECUTOR=local-backtest
AF_PROMOTION_VERIFICATION_EXECUTOR=local-backtest
AF_AUTO_PROCESS_CALIBRATION=false
AF_CALIBRATION_BUDGET=3
AF_MUTATION_SCHEMA_MODE=strict
RESEARCH_REFRESH_EVERY_TASKS=3
ALPHAXIV_MCP_URL=https://api.alphaxiv.org/mcp/v1
ALPHAXIV_MCP_BEARER_TOKEN=
ALPHAXIV_AUTH_FILE=
ALPHAXIV_SESSION_FILE=
