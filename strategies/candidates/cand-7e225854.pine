//@version=5
strategy("AF Mutation Trend-Gated Exhaustion Repair [cand-7e225854]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0, process_orders_on_close=true)

fastLength = input.int(18, "Fast EMA", minval=2)
slowLength = input.int(50, "Slow EMA", minval=3)
rsiLength = input.int(14, "RSI Length", minval=2)
atrLength = input.int(14, "ATR Length", minval=2)
atrStopMult = input.float(2.4, "ATR Stop Mult", minval=0.5, step=0.1)
atrTrailTrigger = input.float(1.6, "ATR Profit Trigger", minval=0.5, step=0.1)
atrTrailMult = input.float(1.3, "ATR Trail Mult", minval=0.5, step=0.1)
maxBarsInTrade = input.int(24, "Max Bars In Trade", minval=2)
htfTf = input.timeframe("D", "Higher Timeframe")
htfLen = input.int(100, "HTF EMA Length", minval=10)
adxLen = input.int(14, "ADX Length", minval=2)
adxFloor = input.float(16.0, "ADX Floor", minval=5, step=0.5)
trendSlopeFloor = input.float(0.0, "Slow EMA Slope Floor %", step=0.01)
pullbackBandAtr = input.float(0.8, "Pullback Band ATR", minval=0.1, step=0.1)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
trComp1 = high - low
trComp2 = math.abs(high - close[1])
trComp3 = math.abs(low - close[1])
trRaw = math.max(trComp1, math.max(trComp2, trComp3))
trRma = ta.rma(trRaw, adxLen)
plusDI = trRma == 0 ? 0 : 100 * ta.rma(plusDM, adxLen) / trRma
minusDI = trRma == 0 ? 0 : 100 * ta.rma(minusDM, adxLen) / trRma
dx = (plusDI + minusDI == 0) ? 0 : 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adx = ta.rma(dx, adxLen)

htfClose = request.security(syminfo.tickerid, htfTf, close)
htfEma = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfLen))
htfBull = htfClose >= htfEma

slowSlopePct = slowEma[3] != 0 ? ((slowEma - slowEma[3]) / slowEma[3]) * 100 : 0.0
trendHealthy = close > slowEma and slowSlopePct > trendSlopeFloor and plusDI > minusDI and adx > adxFloor and htfBull
pullbackOk = close < fastEma + atrValue * pullbackBandAtr
momentumRecover = rsiValue > 52 and rsiValue > rsiValue[1]
entrySignal = ta.crossover(fastEma, slowEma) or (trendHealthy and pullbackOk and ta.crossover(rsiValue, 50))
longEntry = trendHealthy and momentumRecover and entrySignal

var int barsInTrade = 0
barsInTrade := strategy.position_size > 0 ? nz(barsInTrade[1]) + 1 : 0

if longEntry and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

var float highestSinceEntry = na
highestSinceEntry := strategy.position_size > 0 ? (na(highestSinceEntry[1]) ? high : math.max(highestSinceEntry[1], high)) : na

entryPrice = strategy.position_avg_price
baseStop = strategy.position_size > 0 ? entryPrice - atrValue * atrStopMult : na
profitTriggerReached = strategy.position_size > 0 and highestSinceEntry >= entryPrice + atrValue * atrTrailTrigger
trailStop = strategy.position_size > 0 ? highestSinceEntry - atrValue * atrTrailMult : na
activeStop = strategy.position_size > 0 ? (profitTriggerReached ? math.max(baseStop, trailStop) : baseStop) : na

exitTrendFail = strategy.position_size > 0 and (close < slowEma or plusDI < minusDI)
exitRsiFail = strategy.position_size > 0 and rsiValue < 46 and rsiValue < rsiValue[1]
exitTime = strategy.position_size > 0 and barsInTrade >= maxBarsInTrade
exitHardGate = strategy.position_size > 0 and not htfBull

if strategy.position_size > 0
    strategy.exit("XL", "Long", stop=activeStop)

if exitTrendFail or exitRsiFail or exitTime or exitHardGate
    strategy.close("Long")

plot(fastEma, "Fast EMA", color=color.new(color.teal, 0))
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0))
plot(htfEma, "HTF EMA", color=color.new(color.blue, 60))