//@version=5
strategy("AF Mock Candidate [cand-3c7d9856]-mutA [cand-c87074fc]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0)

fastLength = input.int(18, "Fast EMA", minval=2)
slowLength = input.int(50, "Slow EMA", minval=3)
rsiLength = input.int(14, "RSI Length", minval=2)
atrLength = input.int(14, "ATR Length", minval=2)
adxLen = input.int(14, "ADX Length", minval=2)
trendAdxMin = input.float(16.0, "Min ADX", minval=1, step=0.5)
entryRsiMin = input.float(53.0, "Entry RSI Min", minval=1, maxval=99, step=0.5)
exitRsiMin = input.float(46.0, "Exit RSI Min", minval=1, maxval=99, step=0.5)
extLookback = input.int(6, "Extension Lookback Bars", minval=2)
extMaxPct = input.float(2.2, "Max Short-Term Extension %", minval=0.2, step=0.1)
emaDistMaxPct = input.float(2.6, "Max Distance Above Fast EMA %", minval=0.2, step=0.1)
bbLength = input.int(20, "BB Length", minval=5)
bbMult = input.float(2.0, "BB Mult", minval=0.5, step=0.1)
bbWidthMin = input.float(0.018, "Min BB Width", minval=0.001, step=0.001)
stopAtrMult = input.float(2.0, "Stop ATR Mult", minval=0.5, step=0.1)
trailAtrMult = input.float(2.4, "Trail ATR Mult", minval=0.5, step=0.1)
profitLockAtr = input.float(1.6, "Profit Lock Activation ATR", minval=0.5, step=0.1)
maxBarsInTrade = input.int(18, "Max Bars In Trade", minval=2)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
trur = ta.rma(ta.tr(true), adxLen)
plusDI = trur != 0 ? 100 * ta.rma(plusDM, adxLen) / trur : 0.0
minusDI = trur != 0 ? 100 * ta.rma(minusDM, adxLen) / trur : 0.0
dx = (plusDI + minusDI != 0) ? 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI) : 0.0
adx = ta.rma(dx, adxLen)

bbBasis = ta.sma(close, bbLength)
bbDev = bbMult * ta.stdev(close, bbLength)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
bbWidth = bbBasis != 0 ? (bbUpper - bbLower) / bbBasis : 0.0

recentLowest = ta.lowest(low, extLookback)
shortRunExtPct = recentLowest != 0 ? (close / recentLowest - 1.0) * 100.0 : 0.0
emaDistPct = fastEma != 0 ? (close / fastEma - 1.0) * 100.0 : 0.0
lateEntryBlock = shortRunExtPct > extMaxPct or emaDistPct > emaDistMaxPct or close >= ta.highest(high, 3) * 0.998

trendUp = fastEma > slowEma and slowEma > slowEma[1]
trendStrength = adx > trendAdxMin and plusDI > minusDI
volatilityOk = bbWidth > bbWidthMin
momentumOk = rsiValue > entryRsiMin
pullbackOk = close <= high - 0.15 * atrValue

longEntry = strategy.position_size == 0 and trendUp and trendStrength and volatilityOk and momentumOk and pullbackOk and not lateEntryBlock

var int barsInTrade = 0
var float highestSinceEntry = na

inTrade = strategy.position_size > 0
newLong = inTrade and strategy.position_size[1] <= 0
flatNow = strategy.position_size == 0

if newLong
    barsInTrade := 0
    highestSinceEntry := high
else if inTrade
    barsInTrade += 1
    highestSinceEntry := na(highestSinceEntry) ? high : math.max(highestSinceEntry, high)
else
    barsInTrade := 0
    highestSinceEntry := na

if longEntry
    strategy.entry("Long", strategy.long)

entryPrice = strategy.position_avg_price
baseStop = inTrade ? entryPrice - atrValue * stopAtrMult : na
trailStop = inTrade and not na(highestSinceEntry) ? highestSinceEntry - atrValue * trailAtrMult : na
profitLockStop = inTrade and not na(highestSinceEntry) and highestSinceEntry - entryPrice > atrValue * profitLockAtr ? entryPrice + atrValue * 0.25 : na
activeStop = inTrade ? math.max(baseStop, na(trailStop) ? baseStop : trailStop) : na
activeStop := inTrade and not na(profitLockStop) ? math.max(activeStop, profitLockStop) : activeStop

if inTrade and not na(activeStop)
    strategy.exit("XL", "Long", stop=activeStop)

momentumFade = rsiValue < exitRsiMin and close < fastEma
trendBreak = fastEma < slowEma or plusDI < minusDI
stagnationExit = barsInTrade >= maxBarsInTrade and close < entryPrice + atrValue * 0.4
rangeWeakExit = bbWidth < bbWidthMin * 0.9 and close < fastEma

longExit = inTrade and (momentumFade or trendBreak or stagnationExit or rangeWeakExit)
if longExit
    strategy.close("Long")

plot(fastEma, color=color.new(color.teal, 0), title="Fast EMA")
plot(slowEma, color=color.new(color.orange, 0), title="Slow EMA")
plot(inTrade ? activeStop : na, color=color.new(color.red, 0), title="Active Stop", style=plot.style_linebr)
plot(bbUpper, color=color.new(color.blue, 80), title="BB Upper")
plot(bbLower, color=color.new(color.blue, 80), title="BB Lower")