//@version=5
strategy("AF Mutation Restore Trades [cand-mut-restore-trades-01] [cand-78787e59]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0, process_orders_on_close=true)

fastLength = input.int(20, "Fast EMA", minval=2)
slowLength = input.int(50, "Slow EMA", minval=3)
rsiLength = input.int(14, "RSI Length", minval=2)
atrLength = input.int(14, "ATR Length", minval=2)
trendLookback = input.int(5, "Trend Slope Lookback", minval=1)
pullbackRsiMax = input.int(48, "Pullback RSI Max", minval=5, maxval=70)
reclaimRsiMin = input.int(50, "Reclaim RSI Min", minval=5, maxval=80)
breakoutLookback = input.int(15, "Breakout Lookback", minval=2)
stopAtrMult = input.float(2.2, "Stop ATR Mult", minval=0.5, step=0.1)
targetAtrMult = input.float(3.0, "Target ATR Mult", minval=0.5, step=0.1)
maxBarsInTrade = input.int(18, "Max Bars In Trade", minval=1)
useTrendFilter = input.bool(true, "Use Trend Filter")

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

slowRising = slowEma > slowEma[trendLookback]
fastAboveSlow = fastEma > slowEma
trendOk = useTrendFilter ? (fastAboveSlow and slowRising) : true

pullbackSetup = trendOk and close > slowEma and low < fastEma and rsiValue <= pullbackRsiMax
reclaimSetup = trendOk and ta.crossover(close, fastEma) and rsiValue >= reclaimRsiMin
breakoutSetup = trendOk and close > ta.highest(high, breakoutLookback)[1] and rsiValue > 52
entrySignal = pullbackSetup or reclaimSetup or breakoutSetup

var int entryBarIndex = na
if strategy.position_size == 0 and entrySignal
    strategy.entry("Long", strategy.long)
    entryBarIndex := bar_index

if strategy.position_size == 0
    entryBarIndex := na

longStop = strategy.position_avg_price - atrValue * stopAtrMult
longTarget = strategy.position_avg_price + atrValue * targetAtrMult
if strategy.position_size > 0
    strategy.exit("Long Exit", "Long", stop=longStop, limit=longTarget)

barsHeld = strategy.position_size > 0 and not na(entryBarIndex) ? bar_index - entryBarIndex : 0
lossOfTrend = strategy.position_size > 0 and (ta.crossunder(close, slowEma) or (ta.crossunder(rsiValue, 45)))
timeExit = strategy.position_size > 0 and barsHeld >= maxBarsInTrade

if lossOfTrend or timeExit
    strategy.close("Long")

plot(fastEma, "Fast EMA", color=color.new(color.teal, 0), linewidth=2)
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0), linewidth=2)
plotshape(entrySignal and strategy.position_size == 0, title="Entry Signal", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), size=size.tiny)
plotshape(lossOfTrend, title="Loss Of Trend", style=shape.xcross, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny)
