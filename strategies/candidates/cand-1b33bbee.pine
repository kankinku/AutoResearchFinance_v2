//@version=5
strategy("AF Mock Candidate [cand-3c7d9856] Mut 01 [cand-1b33bbee]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0, process_orders_on_close=true)

fastLength = input.int(21, "Fast EMA", minval=2)
slowLength = input.int(55, "Slow EMA", minval=3)
trendLength = input.int(100, "Trend EMA", minval=20)
rsiLength = input.int(14, "RSI Length", minval=2)
adxLength = input.int(14, "ADX Length", minval=2)
adxMin = input.float(18.0, "Min ADX", minval=1, step=0.5)
atrLength = input.int(14, "ATR Length", minval=1)
extLookback = input.int(8, "Extension Lookback", minval=2)
extAtrMult = input.float(1.4, "Max Extension ATR", minval=0.2, step=0.1)
stopAtrMult = input.float(2.0, "Stop ATR Mult", minval=0.5, step=0.1)
targetAtrMult = input.float(3.2, "Target ATR Mult", minval=0.5, step=0.1)
breakevenTriggerAtr = input.float(1.2, "Breakeven Trigger ATR", minval=0.2, step=0.1)
maxBarsInTrade = input.int(18, "Max Bars In Trade", minval=2)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
trendEma = ta.ema(close, trendLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
tr = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
trRma = ta.rma(tr, adxLength)
plusDI = trRma == 0.0 ? 0.0 : 100.0 * ta.rma(plusDM, adxLength) / trRma
minusDI = trRma == 0.0 ? 0.0 : 100.0 * ta.rma(minusDM, adxLength) / trRma
dx = (plusDI + minusDI == 0.0) ? 0.0 : 100.0 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adx = ta.rma(dx, adxLength)

slowSlopeUp = slowEma > slowEma[3]
trendUp = close > trendEma and fastEma > slowEma and slowEma > trendEma and slowSlopeUp
notTrendDown = close >= trendEma or fastEma >= slowEma
trendStrengthOk = adx > adxMin and plusDI > minusDI
recentLowest = ta.lowest(close, extLookback)
priceExtension = close - recentLowest
notExtended = priceExtension < atrValue * extAtrMult
rsiRecover = rsiValue > 52 and rsiValue > rsiValue[1]
entrySignal = ta.crossover(fastEma, slowEma)
longEntry = entrySignal and trendUp and notTrendDown and trendStrengthOk and notExtended and rsiRecover

var int barsInTrade = 0
barsInTrade := strategy.position_size > 0 ? nz(barsInTrade[1]) + 1 : 0

if longEntry and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

avgPrice = strategy.position_avg_price
openProfitAtr = strategy.position_size > 0 ? (close - avgPrice) / atrValue : 0.0
breakevenStop = strategy.position_size > 0 and openProfitAtr >= breakevenTriggerAtr ? avgPrice : na
baseStop = strategy.position_size > 0 ? avgPrice - atrValue * stopAtrMult : na
finalStop = strategy.position_size > 0 ? math.max(baseStop, nz(breakevenStop, baseStop)) : na
finalTarget = strategy.position_size > 0 ? avgPrice + atrValue * targetAtrMult : na

if strategy.position_size > 0
    strategy.exit("XL", "Long", stop=finalStop, limit=finalTarget)

momentumLossExit = strategy.position_size > 0 and ((rsiValue < 47 and close < fastEma) or (fastEma < slowEma and close < slowEma))
timeStopExit = strategy.position_size > 0 and barsInTrade >= maxBarsInTrade
regimeFailExit = strategy.position_size > 0 and (adx < adxMin * 0.8 and close < slowEma)

if momentumLossExit or timeStopExit or regimeFailExit
    strategy.close("Long")

plot(fastEma, color=color.new(color.teal, 0), title="Fast EMA")
plot(slowEma, color=color.new(color.orange, 0), title="Slow EMA")
plot(trendEma, color=color.new(color.blue, 20), title="Trend EMA")