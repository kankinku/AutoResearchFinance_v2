//@version=5
strategy("AF Mock Candidate [cand-mut-extension-cooldown-exit] [cand-09b44c3a] [cand-a2881642]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0)

fastLength = input.int(21, "Fast EMA", minval=2)
slowLength = input.int(55, "Slow EMA", minval=3)
rsiLength = input.int(14, "RSI Length", minval=2)
adxLength = input.int(14, "ADX Length", minval=2)
atrLength = input.int(14, "ATR Length", minval=2)
trendLookback = input.int(20, "Trend Slope Lookback", minval=2)
extLookback = input.int(8, "Extension Lookback", minval=2)
maxExtensionPct = input.float(2.4, "Max Short-Term Extension %", minval=0.2, step=0.1)
extremeExtensionPct = input.float(3.2, "Extreme Extension %", minval=0.5, step=0.1)
extensionCooldownBars = input.int(3, "Extension Cooldown Bars", minval=0, maxval=20)
minRsi = input.int(52, "Min RSI For Entry", minval=1, maxval=99)
minAdx = input.float(16.0, "Min ADX For Entry", minval=1, step=0.5)
stopAtrMult = input.float(2.0, "Stop ATR Mult", minval=0.5, step=0.1)
trailAtrMult = input.float(2.4, "Trail ATR Mult", minval=0.5, step=0.1)
breakevenTriggerAtr = input.float(1.1, "Breakeven Trigger ATR", minval=0.2, step=0.1)
breakevenOffsetAtr = input.float(0.15, "Breakeven Offset ATR", minval=0.0, step=0.05)
maxBarsInTrade = input.int(18, "Max Bars In Trade", minval=1)
lossBarsExit = input.int(5, "Lose-After Bars Exit", minval=1)
adverseBarsExit = input.int(3, "Adverse Progress Bars", minval=1)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
trur = ta.rma(ta.tr(true), adxLength)
plusDI = trur == 0.0 ? 0.0 : 100.0 * ta.rma(plusDM, adxLength) / trur
minusDI = trur == 0.0 ? 0.0 : 100.0 * ta.rma(minusDM, adxLength) / trur
dx = (plusDI + minusDI == 0.0) ? 0.0 : 100.0 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adx = ta.rma(dx, adxLength)

slowSlopeUp = slowEma > slowEma[trendLookback]
trendDownRegime = fastEma < slowEma and slowEma < slowEma[trendLookback] and minusDI > plusDI
trendQualified = fastEma > slowEma and slowSlopeUp and adx > minAdx and plusDI > minusDI

shortTermExtensionPct = ((close / ta.lowest(close, extLookback)) - 1.0) * 100.0
notLateExtension = shortTermExtensionPct < maxExtensionPct
recentExtremeExtension = ta.highest(shortTermExtensionPct, extensionCooldownBars + 1) >= extremeExtensionPct
cooldownActive = extensionCooldownBars > 0 and recentExtremeExtension
entryGate = notLateExtension and not cooldownActive

baseCross = ta.crossover(fastEma, slowEma)
pullbackContinuation = close > fastEma and close[1] <= fastEma[1] and fastEma > slowEma
shallowPullback = low <= fastEma and close >= fastEma and close > open and close > close[1] and fastEma > slowEma
longEntry = (baseCross or pullbackContinuation or shallowPullback) and rsiValue > minRsi and trendQualified and not trendDownRegime and entryGate

var int entryBarIndex = na
var float highestCloseInTrade = na

if longEntry and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0 and strategy.position_size[1] <= 0
    entryBarIndex := bar_index
    highestCloseInTrade := close
else if strategy.position_size > 0
    highestCloseInTrade := na(highestCloseInTrade) ? close : math.max(highestCloseInTrade, close)
else
    entryBarIndex := na
    highestCloseInTrade := na

barsInTrade = na(entryBarIndex) ? 0 : bar_index - entryBarIndex
avgPrice = strategy.position_avg_price
openPnLAtr = strategy.position_size > 0 and atrValue > 0 ? (close - avgPrice) / atrValue : 0.0
runupAtr = strategy.position_size > 0 and atrValue > 0 and not na(highestCloseInTrade) ? (highestCloseInTrade - avgPrice) / atrValue : 0.0

hardStop = strategy.position_size > 0 ? avgPrice - atrValue * stopAtrMult : na
trailStop = strategy.position_size > 0 ? close - atrValue * trailAtrMult : na
breakevenStop = strategy.position_size > 0 and runupAtr >= breakevenTriggerAtr ? avgPrice + atrValue * breakevenOffsetAtr : na
activeStopBase = strategy.position_size > 0 ? math.max(hardStop, trailStop) : na
activeStop = strategy.position_size > 0 ? (na(breakevenStop) ? activeStopBase : math.max(activeStopBase, breakevenStop)) : na
strategy.exit("XL", "Long", stop=activeStop)

emaFailureExit = strategy.position_size > 0 and close < slowEma and rsiValue < 47
stalledLoserExit = strategy.position_size > 0 and barsInTrade >= lossBarsExit and openPnLAtr < -0.25 and close < fastEma
adverseProgressExit = strategy.position_size > 0 and barsInTrade >= adverseBarsExit and openPnLAtr < -0.15 and close < close[1] and close < fastEma and runupAtr < 0.4
timeExit = strategy.position_size > 0 and barsInTrade >= maxBarsInTrade and openPnLAtr < 0.6
trendReversalExit = strategy.position_size > 0 and minusDI > plusDI and adx > minAdx and close < fastEma
manualExit = emaFailureExit or stalledLoserExit or adverseProgressExit or timeExit or trendReversalExit
if manualExit
    strategy.close("Long")

plot(fastEma, "Fast EMA", color=color.new(color.teal, 0))
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0))