//@version=5
strategy("AF Mock Candidate [cand-3c7d9856]-mutA [cand-2ceb99f5]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0)

fastLength = input.int(21, "Fast EMA", minval=1)
slowLength = input.int(55, "Slow EMA", minval=2)
rsiLength = input.int(14, "RSI Length", minval=2)
htfTf = input.timeframe("1D", "Higher Timeframe")
htfEmaLen = input.int(50, "HTF EMA Length", minval=5)
adxLen = input.int(14, "ADX Length", minval=2)
adxTrendThresh = input.float(20.0, "ADX Trend Threshold", minval=5.0, step=0.5)
atrLen = input.int(14, "ATR Length", minval=1)
atrStopMult = input.float(2.1, "ATR Stop Mult", minval=0.5, step=0.1)
atrTrailMult = input.float(2.8, "ATR Trail Mult", minval=0.5, step=0.1)
maxBarsInTrade = input.int(28, "Max Bars In Trade", minval=2)
minBarsBeforeMomentumExit = input.int(4, "Min Bars Before Momentum Exit", minval=1)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLen)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
tr = ta.tr(true)
trRma = ta.rma(tr, adxLen)
plusDI = trRma == 0.0 ? 0.0 : 100.0 * ta.rma(plusDM, adxLen) / trRma
minusDI = trRma == 0.0 ? 0.0 : 100.0 * ta.rma(minusDM, adxLen) / trRma
dx = (plusDI + minusDI == 0.0) ? 0.0 : 100.0 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adxValue = ta.rma(dx, adxLen)

htfClose = request.security(syminfo.tickerid, htfTf, close)
htfEma = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen))
htfDowntrend = htfClose < htfEma
localDownPressure = slowEma < slowEma[1] and minusDI > plusDI and adxValue > adxTrendThresh
trendDownGate = htfDowntrend and localDownPressure

baseLongEntry = ta.crossover(fastEma, slowEma) and rsiValue > 54
pullbackQuality = close > fastEma and fastEma > fastEma[1]
longEntry = baseLongEntry and not trendDownGate and pullbackQuality

var int entryBarIndex = na
if strategy.position_size <= 0
    entryBarIndex := na
if longEntry and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)
    entryBarIndex := bar_index

barsInTrade = strategy.position_size > 0 and not na(entryBarIndex) ? bar_index - entryBarIndex : 0
avgPrice = strategy.position_avg_price
stopPrice = strategy.position_size > 0 ? avgPrice - atrValue * atrStopMult : na
trailOffset = atrValue * atrTrailMult
strategy.exit("Long Risk Exit", from_entry="Long", stop=stopPrice, trail_offset=trailOffset)

momentumLossExit = strategy.position_size > 0 and barsInTrade >= minBarsBeforeMomentumExit and (rsiValue < 48 or (close < fastEma and fastEma < fastEma[1]))
trendFailureExit = strategy.position_size > 0 and (ta.crossunder(fastEma, slowEma) or trendDownGate)
timeExit = strategy.position_size > 0 and barsInTrade >= maxBarsInTrade

if momentumLossExit or trendFailureExit or timeExit
    strategy.close("Long")

plot(fastEma, "Fast EMA", color=color.new(color.teal, 0))
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0))
plot(htfEma, "HTF EMA", color=color.new(color.purple, 40))