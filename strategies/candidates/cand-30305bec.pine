//@version=5
strategy("AF Seed 01 Mutation [seed-core-preserved-range-squeeze-exit] [cand-af-rsq-02] [cand-580f17b8-fixed] [cand-30305bec]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0)

fastLength = input.int(21, "Fast EMA", minval=2)
slowLength = input.int(55, "Slow EMA", minval=3)
rsiLength = input.int(14, "RSI Length", minval=2)
adxLength = input.int(14, "ADX Length", minval=2)
atrLength = input.int(14, "ATR Length", minval=2)
trendLookback = input.int(20, "Trend Slope Lookback", minval=2)
extLookback = input.int(8, "Extension Lookback", minval=2)
maxExtensionPct = input.float(2.1, "Max Short-Term Extension %", minval=0.2, step=0.1)
maxFastDistPct = input.float(1.35, "Max Distance Above Fast EMA %", minval=0.1, step=0.05)
maxEntryRsi = input.int(67, "Max RSI For Entry Stretch Filter", minval=50, maxval=95)
minRsi = input.int(52, "Min RSI For Entry", minval=1, maxval=99)
minAdx = input.float(15.5, "Min ADX For Entry", minval=1, step=0.5)
stopAtrMult = input.float(2.1, "Stop ATR Mult", minval=0.5, step=0.1)
trailAtrMult = input.float(2.4, "Trail ATR Mult", minval=0.5, step=0.1)
maxBarsInTrade = input.int(18, "Max Bars In Trade", minval=1)
lossBarsExit = input.int(4, "Lose-After Bars Exit", minval=1)
retraceExitAtr = input.float(0.95, "Peak Retrace Exit ATR", minval=0.2, step=0.05)
quickLossAtr = input.float(-0.55, "Quick Loss ATR Threshold", maxval=0, step=0.05)
rangeAdxMax = input.float(18.0, "Range ADX Max", minval=5, step=0.5)
squeezeWidthPctMax = input.float(2.2, "Squeeze Width % Max", minval=0.2, step=0.1)
rangeWeakLossAtr = input.float(-0.18, "Range Weak Loss ATR", maxval=0, step=0.05)
rangeQuickLossAtr = input.float(-0.32, "Range Quick Loss ATR", maxval=0, step=0.05)
deepDrawdownAtr = input.float(-0.8, "Deep Drawdown ATR Exit", maxval=0, step=0.05)
weakMomentumRsi = input.int(50, "Weak Momentum RSI Exit", minval=1, maxval=99)
exhaustCountLen = input.int(3, "Exhaustion Sequence Bars", minval=2, maxval=6)
exhaustRsiCap = input.int(46, "Exhaustion RSI Cap", minval=5, maxval=70)
confirmBars = input.int(2, "Confirmation Valid Bars", minval=1, maxval=5)
replacementCooldown = input.int(3, "Replacement Cooldown Bars", minval=0, maxval=10)
squeezeFadeBars = input.int(1, "Squeeze Weakening Bars", minval=1, maxval=4)
rangeSqueezeLossAtr = input.float(-0.12, "Range Squeeze Momentum Loss ATR", maxval=0, step=0.02)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
trur = ta.rma(ta.tr(true), adxLength)
plusDI = trur == 0.0 ? 0.0 : 100.0 * ta.rma(plusDM, adxLength) / trur
minusDI = trur == 0.0 ? 0.0 : 100.0 * ta.rma(minusDM, adxLength) / trur
dx = (plusDI + minusDI == 0.0) ? 0.0 : 100.0 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adx = ta.rma(dx, adxLength)

slowSlopeUp = slowEma > slowEma[trendLookback]
trendDownRegime = fastEma < slowEma and slowEma < slowEma[trendLookback] and minusDI > plusDI
shortTermExtensionPct = ((close / ta.lowest(close, extLookback)) - 1.0) * 100.0
fastDistPct = fastEma == 0.0 ? 0.0 : ((close / fastEma) - 1.0) * 100.0
bandBasis = ta.sma(close, 20)
bandDev = ta.stdev(close, 20)
bandUpper = bandBasis + bandDev * 2.0
bandLower = bandBasis - bandDev * 2.0
bandWidthPct = bandBasis == 0.0 ? 0.0 : ((bandUpper - bandLower) / bandBasis) * 100.0
rangeRegime = adx < rangeAdxMax and math.abs(fastEma - slowEma) / close < 0.012
rangeSqueezeRegime = rangeRegime and bandWidthPct < squeezeWidthPctMax
notLateExtension = shortTermExtensionPct < maxExtensionPct and fastDistPct < maxFastDistPct and rsiValue < maxEntryRsi and close <= ta.highest(close, 3)
trendQualified = fastEma > slowEma and slowSlopeUp and adx > minAdx and plusDI > minusDI
momentumOk = rsiValue > minRsi and rsiValue > rsiValue[1]

exhaustDownBar = close < close[1] and low <= low[1] and rsiValue <= exhaustRsiCap
exhaustSeq = math.sum(exhaustDownBar ? 1.0 : 0.0, exhaustCountLen) >= exhaustCountLen - 1
baseCross = ta.crossover(fastEma, slowEma)
pullbackContinuation = close > fastEma and close[1] <= fastEma[1] and fastEma > slowEma
confirmRecovery = close > open and close > close[1] and rsiValue > rsiValue[1]
confirmBreak = high > high[1] or close > ta.highest(high, confirmBars)[1]
confirmationOk = confirmRecovery and confirmBreak

var int slotState = 0
var int replacementBlockUntil = na
var int entryBarIndex = na
var float peakOpenPnLAtr = na
var int entryExhaustTag = 0
var int lastExitBarIndex = na

replacementAllowed = na(replacementBlockUntil) or bar_index > replacementBlockUntil
seedCoreEntry = (baseCross or pullbackContinuation or exhaustSeq) and confirmationOk and momentumOk and trendQualified and not trendDownRegime and notLateExtension and replacementAllowed
longEntry = seedCoreEntry

if longEntry and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)
    slotState := 1

if strategy.position_size > 0 and strategy.position_size[1] <= 0
    entryBarIndex := bar_index
    peakOpenPnLAtr := 0.0
    entryExhaustTag := exhaustSeq ? 1 : 0
if strategy.position_size <= 0
    entryBarIndex := na
    peakOpenPnLAtr := na
    entryExhaustTag := 0
    slotState := 0

barsInTrade = na(entryBarIndex) ? 0 : bar_index - entryBarIndex
avgPrice = strategy.position_avg_price
openPnLAtr = strategy.position_size > 0 ? (close - avgPrice) / atrValue : 0.0
peakOpenPnLAtr := strategy.position_size > 0 ? math.max(nz(peakOpenPnLAtr, openPnLAtr), openPnLAtr) : na
profitRetraceAtr = strategy.position_size > 0 ? nz(peakOpenPnLAtr, 0.0) - openPnLAtr : 0.0

hardStop = strategy.position_size > 0 ? avgPrice - atrValue * stopAtrMult : na
trailStop = strategy.position_size > 0 ? close - atrValue * trailAtrMult : na
activeStop = strategy.position_size > 0 ? math.max(hardStop, trailStop) : na
strategy.exit("XL", "Long", stop=activeStop)

bearStage1 = strategy.position_size > 0 and close < fastEma and rsiValue < weakMomentumRsi
bearStage2 = strategy.position_size > 0 and close < slowEma and minusDI > plusDI
emaFailureExit = strategy.position_size > 0 and bearStage2 and rsiValue < 47
stalledLoserExit = strategy.position_size > 0 and barsInTrade >= lossBarsExit and openPnLAtr < -0.25 and close < fastEma
quickTrendLossExit = strategy.position_size > 0 and barsInTrade >= 2 and openPnLAtr <= quickLossAtr and (minusDI > plusDI or close < slowEma)
rangeWeakExit = strategy.position_size > 0 and barsInTrade >= 2 and (rangeRegime or rangeSqueezeRegime) and openPnLAtr <= rangeWeakLossAtr and close < fastEma and rsiValue < weakMomentumRsi
rangeSqueezeMomentumExit = strategy.position_size > 0 and barsInTrade >= squeezeFadeBars and rangeSqueezeRegime and openPnLAtr <= rangeSqueezeLossAtr and close < fastEma and (rsiValue < weakMomentumRsi or rsiValue < rsiValue[1] or close < close[1])
compressionQuickLossExit = strategy.position_size > 0 and barsInTrade >= 1 and rangeSqueezeRegime and openPnLAtr <= rangeQuickLossAtr
deeperDrawdownExit = strategy.position_size > 0 and barsInTrade >= 2 and openPnLAtr <= deepDrawdownAtr and (close < fastEma or minusDI > plusDI)
stagedBearishExit = strategy.position_size > 0 and barsInTrade >= 1 and bearStage1 and bearStage2
timeExit = strategy.position_size > 0 and barsInTrade >= maxBarsInTrade and openPnLAtr < 0.6
trendReversalExit = strategy.position_size > 0 and minusDI > plusDI and adx > minAdx and close < fastEma
profitProtectionExit = strategy.position_size > 0 and peakOpenPnLAtr > 0.9 and profitRetraceAtr >= retraceExitAtr and close < fastEma
exhaustionFailExit = strategy.position_size > 0 and entryExhaustTag == 1 and barsInTrade >= 1 and close < fastEma and openPnLAtr <= -0.15
manualExit = emaFailureExit or stalledLoserExit or quickTrendLossExit or rangeWeakExit or rangeSqueezeMomentumExit or compressionQuickLossExit or deeperDrawdownExit or stagedBearishExit or timeExit or trendReversalExit or profitProtectionExit or exhaustionFailExit

if manualExit
    strategy.close("Long")
    replacementBlockUntil := bar_index + replacementCooldown
    lastExitBarIndex := bar_index

plot(fastEma, "Fast EMA", color=color.new(color.teal, 0))
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0))