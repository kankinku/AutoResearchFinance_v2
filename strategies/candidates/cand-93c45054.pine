//@version=5
strategy("AF Breakout 02 - Event Reclaim Reversal [cand-93c45054]", overlay=true, pyramiding=30, process_orders_on_close=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=5, commission_type=strategy.commission.percent, commission_value=0.05)

groupSig = "1. Exhaustion"
L1 = input.int(9, "L1", minval=2, group=groupSig)
L2 = input.int(12, "L2", minval=3, group=groupSig)
L3 = input.int(14, "L3", minval=4, group=groupSig)
confirmBars = input.int(2, "확인 봉 수", minval=1, maxval=5, group=groupSig)

groupFilter = "2. 최소 필터"
emaLen = input.int(21, "EMA 기준", minval=1, group=groupFilter)
baseEmaLen = input.int(55, "Base EMA", minval=1, group=groupFilter)
rsiLen = input.int(14, "RSI Length", minval=2, group=groupFilter)
maxExtPct = input.float(6.0, "신규진입 최대 이격도(%)", minval=1.0, step=0.5, group=groupFilter)
riskOffRsi = input.float(45.0, "Risk-Off RSI", minval=5.0, maxval=95.0, step=0.5, group=groupFilter)

groupPos = "3. 슬롯 관리"
slotPct = input.float(5.0, "슬롯 1개 비중(%)", minval=0.1, maxval=100.0, step=0.5, group=groupPos)
maxSlots = input.int(6, "최대 슬롯 수", minval=1, maxval=50, group=groupPos)
useReplacement = input.bool(true, "최대 슬롯 도달 시 교체 허용", group=groupPos)
replaceMinRank = input.int(3, "교체 허용 최소 신호 강도 (1=B1, 2=B2, 3=B3, 4=BCONF)", minval=1, maxval=4, group=groupPos)
replaceIfPnlBelow = input.float(-0.5, "이 수익률 이하 슬롯이면 교체(%)", step=0.5, group=groupPos)
applyFilterToB1 = input.bool(false, "B1에도 필터 적용", group=groupPos)
minQty = input.float(1.0, "최소 주문 수량", minval=0.000001, step=0.1, group=groupPos)

groupExit = "4. 청산"
closeAllOnBearConfRiskOff = input.bool(true, "Bear CONF + Risk-Off 시 전량청산", group=groupExit)

groupExec = "5. 실행 개선"
sameBarConflictMode = input.string("StrongWins", "같은 봉 충돌 처리", options=["StrongWins", "SkipBoth", "BearPriority"], group=groupExec)
trendMode = input.string("Balanced", "진입 추세 필터", options=["Strict", "Balanced", "Loose"], group=groupExec)
allowStrongCounterTrend = input.bool(true, "강한 매수(B3/BC)는 Risk-Off 일부 허용", group=groupExec)
entryCooldownBars = input.int(0, "매수 재진입 쿨다운(봉)", minval=0, maxval=20, group=groupExec)
useRealFillSync = input.bool(true, "실제 체결가로 슬롯 진입가 동기화", group=groupExec)
resetOnL3 = input.bool(false, "L3 즉시 리셋", group=groupExec)
useSupertrendFilter = input.bool(false, "Supertrend 필터 사용", group=groupExec)
supertrendAtrPeriod = input.int(10, "Supertrend ATR Period", minval=1, group=groupExec)
supertrendFactor = input.float(3.0, "Supertrend Factor", minval=0.1, step=0.1, group=groupExec)
supertrendBlocksWeakBull = input.bool(true, "약한 매수에 Supertrend 차단 적용", group=groupExec)
supertrendRiskOffEnabled = input.bool(false, "Supertrend Risk-Off 사용", group=groupExec)

groupWeak = "6. 약세/횡보 청산"
enableWeakRangeExit = input.bool(true, "약세 횡보 청산 사용", group=groupWeak)
weakExitAtrLen = input.int(14, "Weak Exit ATR Len", minval=1, group=groupWeak)
weakExitBars = input.int(6, "Weak Exit Bars", minval=1, maxval=50, group=groupWeak)
weakRunupAtrMax = input.float(1.2, "Weak Runup ATR Max", minval=0.1, step=0.1, group=groupWeak)
weakLossAtrMin = input.float(-0.5, "Weak Loss ATR Min", step=0.1, group=groupWeak)
weakSlopeAtrMax = input.float(0.15, "Weak Slope ATR Max", minval=0.0, step=0.05, group=groupWeak)

groupRoute = "7. Event Reclaim Route"
eventFloorBars = input.int(1, "Event Floor Bars", minval=0, maxval=10, group=groupRoute)
eventWindowBars = input.int(5, "Event Window Bars", minval=1, maxval=30, group=groupRoute)
maxHoldBars = input.int(10, "Max Hold Bars", minval=1, maxval=80, group=groupRoute)
bullContinueWindow = input.int(4, "Bull Continue Window", minval=1, maxval=20, group=groupRoute)
bearReboundWindow = input.int(3, "Bear Rebound Window", minval=1, maxval=20, group=groupRoute)
reclaimLookbackBars = input.int(3, "Reclaim Lookback Bars", minval=1, maxval=10, group=groupRoute)

groupDebug = "8. 디버그"
showDebugMarks = input.bool(false, "디버그 마크 표시", group=groupDebug)

groupView = "9. 표시"
showEMAs = input.bool(true, "EMA 표시", group=groupView)
showSignals = input.bool(true, "신호 표시", group=groupView)
showConfMark = input.bool(true, "CONF 표시", group=groupView)

safeL2 = math.max(L2, L1 + 1)
safeL3 = math.max(L3, safeL2 + 1)

ema = ta.ema(close, emaLen)
baseEMA = ta.ema(close, baseEmaLen)
rsi = ta.rsi(close, rsiLen)
atrWeak = ta.atr(weakExitAtrLen)

bullTrend = close >= ema
bearTrend = close <= ema
bullMomentum = ((not na(rsi[1])) and rsi > rsi[1]) or ((not na(close[1])) and close > close[1])
bearMomentum = ((not na(rsi[1])) and rsi < rsi[1]) or ((not na(close[1])) and close < close[1])
emaUp = not na(ema[1]) and ema >= ema[1]
emaDown = not na(ema[1]) and ema <= ema[1]
overextended = close > ema * (1.0 + maxExtPct / 100.0)

atrST = ta.atr(supertrendAtrPeriod)
hl2v = (high + low) * 0.5
basicUpper = hl2v + supertrendFactor * atrST
basicLower = hl2v - supertrendFactor * atrST
var float finalUpper = na
var float finalLower = na
var bool stBull = true
finalUpper := na(finalUpper[1]) ? basicUpper : ((basicUpper < finalUpper[1] or close[1] > finalUpper[1]) ? basicUpper : finalUpper[1])
finalLower := na(finalLower[1]) ? basicLower : ((basicLower > finalLower[1] or close[1] < finalLower[1]) ? basicLower : finalLower[1])
stBull := na(stBull[1]) ? true : (stBull[1] ? (close < finalLower[1] ? false : true) : (close > finalUpper[1] ? true : false))
stLine = stBull ? finalLower : finalUpper

riskOffBase = close < baseEMA and rsi < riskOffRsi and emaDown
riskOff = supertrendRiskOffEnabled ? (riskOffBase or not stBull) : riskOffBase

var int cycle = 0
var int bull = 0
var int bear = 0

has4 = bar_index >= 4 and not na(close[4])
has2 = bar_index >= 2 and not na(close[2])

f_reset() =>
    int nb = 0
    int ns = 0
    int nc = 0
    if has4
        if close < close[4]
            nb := 1
            nc := 1
        else if close > close[4]
            ns := 1
            nc := 1
    [nb, ns, nc]

if not has4
    bull := 0
    bear := 0
    cycle := 0
else
    if cycle < L1
        if close < close[4]
            bull := bull + 1
            bear := 0
            cycle := bull
        else if close > close[4]
            bear := bear + 1
            bull := 0
            cycle := bear
        else
            [nb, ns, nc] = f_reset()
            bull := nb
            bear := ns
            cycle := nc
    else
        if bull > 0
            if has2 and close < close[2]
                bull := bull + 1
                cycle := bull
            else
                [nb, ns, nc] = f_reset()
                bull := nb
                bear := ns
                cycle := nc
        else if bear > 0
            if has2 and close > close[2]
                bear := bear + 1
                cycle := bear
            else
                [nb, ns, nc] = f_reset()
                bull := nb
                bear := ns
                cycle := nc
        else
            [nb, ns, nc] = f_reset()
            bull := nb
            bear := ns
            cycle := nc

bullL1 = bull == L1
bullL2 = bull == safeL2
bullL3 = bull == safeL3
bearL1 = bear == L1
bearL2 = bear == safeL2
bearL3 = bear == safeL3

bullCandidate = bullL2
bearCandidate = bearL2
bullStrong = bullL3
bearStrong = bearL3

var int bullSignalBar = na
var int bearSignalBar = na
if bullCandidate or bullStrong
    bullSignalBar := bar_index
if bearCandidate or bearStrong
    bearSignalBar := bar_index

bullConfirmed = not na(bullSignalBar) and bar_index > bullSignalBar and (bar_index - bullSignalBar <= confirmBars) and close > high[1]
bearConfirmed = not na(bearSignalBar) and bar_index > bearSignalBar and (bar_index - bearSignalBar <= confirmBars) and close < low[1]

if bullConfirmed or (not na(bullSignalBar) and bar_index - bullSignalBar > confirmBars)
    bullSignalBar := na
if bearConfirmed or (not na(bearSignalBar) and bar_index - bearSignalBar > confirmBars)
    bearSignalBar := na

newBullL1 = bullL1 and not nz(bullL1[1], false)
newBullCandidate = bullCandidate and not nz(bullCandidate[1], false)
newBullStrong = bullStrong and not nz(bullStrong[1], false)
newBullConfirmed = bullConfirmed and not nz(bullConfirmed[1], false)
newBearL1 = bearL1 and not nz(bearL1[1], false)
newBearCandidate = bearCandidate and not nz(bearCandidate[1], false)
newBearStrong = bearStrong and not nz(bearStrong[1], false)
newBearConfirmed = bearConfirmed and not nz(bearConfirmed[1], false)

bullEventRaw = newBullConfirmed ? 4 : newBullStrong ? 3 : newBullCandidate ? 2 : newBullL1 ? 1 : 0
bearEventRaw = newBearConfirmed ? 4 : newBearStrong ? 3 : newBearCandidate ? 2 : newBearL1 ? 1 : 0

f_resolve_conflict(int bullEv, int bearEv) =>
    int resolvedBull = 0
    int resolvedBear = 0
    if bullEv > 0 and bearEv > 0
        if sameBarConflictMode == "BearPriority"
            resolvedBear := bearEv
        else if sameBarConflictMode == "SkipBoth"
            resolvedBull := 0
            resolvedBear := 0
        else
            if bullEv > bearEv
                resolvedBull := bullEv
            else if bearEv > bullEv
                resolvedBear := bearEv
            else
                if bullMomentum and not bearMomentum
                    resolvedBull := bullEv
                else if bearMomentum and not bullMomentum
                    resolvedBear := bearEv
                else if close > ema and rsi >= 50
                    resolvedBull := bullEv
                else if close < ema and rsi <= 50
                    resolvedBear := bearEv
    else
        resolvedBull := bullEv
        resolvedBear := bearEv
    [resolvedBull, resolvedBear]

[finalBullEvent, finalBearEvent] = f_resolve_conflict(bullEventRaw, bearEventRaw)
allowBull = finalBullEvent > 0
allowBear = finalBearEvent > 0

bullRecoveryOk = false
if trendMode == "Strict"
    bullRecoveryOk := bullTrend and bullMomentum
else if trendMode == "Balanced"
    bullRecoveryOk := bullMomentum and (bullTrend or emaUp or close > open)
else
    bullRecoveryOk := bullMomentum or close > open

bullRiskAllowed = not riskOff or (allowStrongCounterTrend and finalBullEvent >= 3 and bullMomentum)
bullBaseAllowed = bullRiskAllowed and not overextended
supertrendBullAllowed = not useSupertrendFilter or stBull
bullB1Allowed = true
if applyFilterToB1
    bullB1Allowed := bullBaseAllowed and (bullRecoveryOk or bullTrend) and (not supertrendBlocksWeakBull or supertrendBullAllowed)

var int bullEventBar = na
var int bullEventRank = 0
var int bullEventLowBar = na
var float bullEventFloorPrice = na
var int bearEventBar = na
var int bearEventRank = 0
var int bearEventHighBar = na
var float bearEventCeilingPrice = na

if allowBull
    bullEventBar := bar_index
    bullEventRank := finalBullEvent
    bullEventLowBar := bar_index
    bullEventFloorPrice := low
if allowBear
    bearEventBar := bar_index
    bearEventRank := finalBearEvent
    bearEventHighBar := bar_index
    bearEventCeilingPrice := high

bullEventFloor = not na(bullEventBar) and (bar_index - bullEventBar >= eventFloorBars)
bearEventFloor = not na(bearEventBar) and (bar_index - bearEventBar >= eventFloorBars)
earlyBullEvent = not na(bullEventBar) and (bar_index - bullEventBar <= bullContinueWindow)
earlyBearEvent = not na(bearEventBar) and (bar_index - bearEventBar <= bearReboundWindow)

bullWindowActive = not na(bullEventBar) and (bar_index - bullEventBar <= eventWindowBars)
bearWindowActive = not na(bearEventBar) and (bar_index - bearEventBar <= eventWindowBars)
recentBullLow = ta.lowest(low, reclaimLookbackBars)
recentBearHigh = ta.highest(high, reclaimLookbackBars)

bullReclaim = bullEventFloor and bullWindowActive and not na(bullEventFloorPrice) and close > bullEventFloorPrice and close > open and bullRecoveryOk
bearFailureRebound = bearEventFloor and bearWindowActive and earlyBearEvent and not na(bearEventCeilingPrice) and close > low[1] and close > open and close < bearEventCeilingPrice and bullMomentum
confirmedBullReversal = earlyBullEvent and finalBullEvent == 4 and bullBaseAllowed and supertrendBullAllowed
weakBullOverride = finalBullEvent == 1 ? bullB1Allowed : true
primaryEntryTrigger = ((bullReclaim or bearFailureRebound or confirmedBullReversal) and bullBaseAllowed and supertrendBullAllowed and weakBullOverride)
entryPass = primaryEntryTrigger and not riskOff

var slotIds = array.new_string()
var slotEntry = array.new_float()
var slotRank = array.new_int()
var slotEntryBar = array.new_int()
var int nextSlotNo = 1
var int lastLongEntryBar = na
var int lastOrderBar = na

f_entry_qty(float pct) =>
    float rawQty = close > 0 ? (strategy.equity * (pct * 0.01)) / close : 0.0
    math.max(rawQty, minQty)

f_slot_pnl_pct(int idx) =>
    float ep = array.get(slotEntry, idx)
    ep > 0 ? ((close - ep) / ep) * 100.0 : 0.0

f_find_open_trade_idx(string entryId) =>
    int foundIdx = na
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            if na(foundIdx) and strategy.opentrades.entry_id(i) == entryId
                foundIdx := i
    foundIdx

f_find_weakest_idx() =>
    int weakestIdx = na
    float worstPnl = na
    int worstRank = na
    if array.size(slotEntry) > 0
        for i = 0 to array.size(slotEntry) - 1
            float pnl = f_slot_pnl_pct(i)
            int rk = array.get(slotRank, i)
            if na(weakestIdx)
                weakestIdx := i
                worstPnl := pnl
                worstRank := rk
            else if pnl < worstPnl or (math.abs(pnl - worstPnl) < 0.0001 and rk < worstRank)
                weakestIdx := i
                worstPnl := pnl
                worstRank := rk
    weakestIdx

f_close_slot(int idx) =>
    if idx >= 0 and idx < array.size(slotIds)
        string idToClose = array.get(slotIds, idx)
        strategy.close(idToClose, immediately=true)
        array.remove(slotIds, idx)
        array.remove(slotEntry, idx)
        array.remove(slotRank, idx)
        array.remove(slotEntryBar, idx)

if strategy.position_size == 0 and array.size(slotIds) > 0 and (na(lastOrderBar) or bar_index > lastOrderBar)
    array.clear(slotIds)
    array.clear(slotEntry)
    array.clear(slotRank)
    array.clear(slotEntryBar)
else
    if useRealFillSync and array.size(slotIds) > 0 and strategy.opentrades > 0
        for i = 0 to array.size(slotIds) - 1
            string sid = array.get(slotIds, i)
            int openIdx = f_find_open_trade_idx(sid)
            if not na(openIdx)
                array.set(slotEntry, i, strategy.opentrades.entry_price(openIdx))

canEnterLong = na(lastLongEntryBar) or (bar_index - lastLongEntryBar >= entryCooldownBars + 1)
slotAvailable = array.size(slotIds) < maxSlots
qtyNow = f_entry_qty(slotPct)
qtyOK = qtyNow > 0

if entryPass and canEnterLong and qtyOK
    int proposedRank = confirmedBullReversal ? 4 : bullReclaim ? math.max(2, bullEventRank) : bearFailureRebound ? 2 : 1
    if slotAvailable
        string newId = "L_" + str.tostring(nextSlotNo)
        nextSlotNo += 1
        strategy.entry(newId, strategy.long, qty=qtyNow)
        array.push(slotIds, newId)
        array.push(slotEntry, close)
        array.push(slotRank, proposedRank)
        array.push(slotEntryBar, bar_index)
        lastLongEntryBar := bar_index
        lastOrderBar := bar_index
    else if useReplacement and proposedRank >= replaceMinRank
        int weakIdx = f_find_weakest_idx()
        if not na(weakIdx)
            float weakPnl = f_slot_pnl_pct(weakIdx)
            int weakRank = array.get(slotRank, weakIdx)
            bool canReplace = weakPnl <= replaceIfPnlBelow or proposedRank > weakRank
            if canReplace
                f_close_slot(weakIdx)
                lastOrderBar := bar_index
                string newId = "L_" + str.tostring(nextSlotNo)
                nextSlotNo += 1
                strategy.entry(newId, strategy.long, qty=qtyNow)
                array.push(slotIds, newId)
                array.push(slotEntry, close)
                array.push(slotRank, proposedRank)
                array.push(slotEntryBar, bar_index)
                lastLongEntryBar := bar_index
                lastOrderBar := bar_index

if array.size(slotIds) > 0
    bool weakRangeNow = false
    if enableWeakRangeExit and not na(atrWeak) and atrWeak > 0 and array.size(slotEntry) > 0
        int weakestNow = f_find_weakest_idx()
        if not na(weakestNow)
            float runupAtr = (close - ta.lowest(low, weakExitBars)) / atrWeak
            float pnlAtr = (close - array.get(slotEntry, weakestNow)) / atrWeak
            float emaSlopeAtr = not na(ema[weakExitBars]) ? (ema - ema[weakExitBars]) / atrWeak : 0.0
            weakRangeNow := runupAtr <= weakRunupAtrMax and pnlAtr <= weakLossAtrMin and math.abs(emaSlopeAtr) <= weakSlopeAtrMax
    if weakRangeNow
        int weakIdx1 = f_find_weakest_idx()
        if not na(weakIdx1)
            f_close_slot(weakIdx1)
            lastOrderBar := bar_index

    int sizeNow = array.size(slotIds)
    if sizeNow > 0
        for step = 0 to 49
            int idx = sizeNow - 1 - step
            if idx >= 0 and idx < array.size(slotEntryBar)
                int heldBars = bar_index - array.get(slotEntryBar, idx)
                bool exitOnTime = heldBars >= maxHoldBars
                bool exitOnBearWindowFade = earlyBearEvent and heldBars >= bearReboundWindow and f_slot_pnl_pct(idx) <= 0
                if exitOnTime or exitOnBearWindowFade
                    f_close_slot(idx)
                    lastOrderBar := bar_index

if allowBear and array.size(slotIds) > 0
    if finalBearEvent == 1 or finalBearEvent == 2
        int weakIdx2 = f_find_weakest_idx()
        if not na(weakIdx2)
            f_close_slot(weakIdx2)
            lastOrderBar := bar_index
    if finalBearEvent == 3
        for step = 0 to 1
            if array.size(slotIds) > 0
                int weakIdx3 = f_find_weakest_idx()
                if not na(weakIdx3)
                    f_close_slot(weakIdx3)
                    lastOrderBar := bar_index
    if finalBearEvent == 4
        bool keepClosingLoss = true
        for step = 0 to 49
            if keepClosingLoss and array.size(slotIds) > 0
                int weakIdx4 = f_find_weakest_idx()
                if not na(weakIdx4)
                    float pnl = f_slot_pnl_pct(weakIdx4)
                    if pnl < 0
                        f_close_slot(weakIdx4)
                        lastOrderBar := bar_index
                    else
                        keepClosingLoss := false
        if closeAllOnBearConfRiskOff and riskOff
            for step = 0 to 49
                if array.size(slotIds) > 0
                    int weakIdx5 = f_find_weakest_idx()
                    if not na(weakIdx5)
                        f_close_slot(weakIdx5)
                        lastOrderBar := bar_index

if resetOnL3 and (bull == safeL3 or bear == safeL3)
    bull := 0
    bear := 0
    cycle := 0

plot(showEMAs ? ema : na, "EMA", color=color.orange, linewidth=1)
plot(showEMAs ? baseEMA : na, "Base EMA", color=color.red, linewidth=2)
plot(showEMAs and useSupertrendFilter ? stLine : na, "Supertrend", color=stBull ? color.lime : color.red, linewidth=1)

plotshape(showSignals and bullL1, title="B1", location=location.belowbar, color=color.new(color.green, 65), style=shape.circle, size=size.tiny, text="B1")
plotshape(showSignals and bullCandidate, title="B2", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small, text="B2")
plotshape(showSignals and bullStrong, title="B3", location=location.belowbar, color=color.lime, style=shape.diamond, size=size.small, text="B3")
plotshape(showSignals and bearL1, title="S1", location=location.abovebar, color=color.new(color.red, 65), style=shape.circle, size=size.tiny, text="S1")
plotshape(showSignals and bearCandidate, title="S2", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small, text="S2")
plotshape(showSignals and bearStrong, title="S3", location=location.abovebar, color=color.maroon, style=shape.diamond, size=size.small, text="S3")
plotshape(showConfMark and bullConfirmed, title="BCONF", location=location.belowbar, color=color.blue, style=shape.labelup, size=size.small, text="BC")
plotshape(showConfMark and bearConfirmed, title="SCONF", location=location.abovebar, color=color.orange, style=shape.labeldown, size=size.small, text="SC")

plotchar(showDebugMarks and primaryEntryTrigger ? 1 : na, title="primaryEntryTrigger", char='P', location=location.top, color=color.lime, size=size.tiny)
plotchar(showDebugMarks and entryPass ? 1 : na, title="entryPass", char='E', location=location.top, color=color.green, size=size.tiny)
plotchar(showDebugMarks and bullReclaim ? 1 : na, title="bullReclaim", char='R', location=location.top, color=color.aqua, size=size.tiny)
plotchar(showDebugMarks and bearFailureRebound ? 1 : na, title="bearFailureRebound", char='F', location=location.top, color=color.yellow, size=size.tiny)
plotchar(showDebugMarks and riskOff ? 1 : na, title="riskOff", char='X', location=location.bottom, color=color.red, size=size.tiny)

alertcondition(newBullL1, title="New B1", message="New B1: {{ticker}}")
alertcondition(newBullCandidate, title="New B2", message="New B2: {{ticker}}")
alertcondition(newBullStrong, title="New B3", message="New B3: {{ticker}}")
alertcondition(newBullConfirmed, title="New BCONF", message="New BCONF: {{ticker}}")
alertcondition(newBearL1, title="New S1", message="New S1: {{ticker}}")
alertcondition(newBearCandidate, title="New S2", message="New S2: {{ticker}}")
alertcondition(newBearStrong, title="New S3", message="New S3: {{ticker}}")
alertcondition(newBearConfirmed, title="New SCONF", message="New SCONF: {{ticker}}")