//@version=5
strategy("AF Seed 01 - Event Age Rotation Repair [cand-49bf1eca]", overlay=true, pyramiding=20, process_orders_on_close=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=5, commission_type=strategy.commission.percent, commission_value=0.05)

groupSig = "1. Exhaustion"
L1 = input.int(9, "L1", minval=2, group=groupSig)
L2 = input.int(12, "L2", minval=3, group=groupSig)
L3 = input.int(14, "L3", minval=4, group=groupSig)
confirmBars = input.int(2, "confirmBars", minval=1, maxval=5, group=groupSig)

groupFilter = "2. Filters"
emaLen = input.int(21, "emaLen", minval=1, group=groupFilter)
baseEmaLen = input.int(55, "baseEmaLen", minval=1, group=groupFilter)
rsiLen = input.int(14, "rsiLen", minval=2, group=groupFilter)
maxExtPct = input.float(6.0, "maxExtPct", minval=0.1, step=0.1, group=groupFilter)
riskOffRsi = input.float(45.0, "riskOffRsi", minval=5.0, maxval=95.0, step=0.5, group=groupFilter)

groupPos = "3. Slots"
slotPct = input.float(5.0, "slotPct", minval=0.1, maxval=100.0, step=0.1, group=groupPos)
maxSlots = input.int(6, "maxSlots", minval=1, maxval=50, group=groupPos)
useReplacement = input.bool(true, "useReplacement", group=groupPos)
replaceMinRank = input.int(2, "replaceMinRank", minval=1, maxval=4, group=groupPos)
replaceIfPnlBelow = input.float(-0.4, "replaceIfPnlBelow", step=0.1, group=groupPos)
applyFilterToB1 = input.bool(false, "applyFilterToB1", group=groupPos)
minQty = input.float(1.0, "minQty", minval=0.000001, step=0.1, group=groupPos)

groupExit = "4. Exit"
closeAllOnBearConfRiskOff = input.bool(true, "closeAllOnBearConfRiskOff", group=groupExit)

groupExec = "5. Execution"
sameBarConflictMode = input.string("StrongWins", "sameBarConflictMode", options=["StrongWins", "SkipBoth", "BearPriority"], group=groupExec)
trendMode = input.string("Balanced", "trendMode", options=["Strict", "Balanced", "Loose"], group=groupExec)
allowStrongCounterTrend = input.bool(true, "allowStrongCounterTrend", group=groupExec)
entryCooldownBars = input.int(0, "entryCooldownBars", minval=0, maxval=20, group=groupExec)
useRealFillSync = input.bool(true, "useRealFillSync", group=groupExec)
resetOnL3 = input.bool(false, "resetOnL3", group=groupExec)
useSupertrendFilter = input.bool(false, "useSupertrendFilter", group=groupExec)
supertrendAtrPeriod = input.int(10, "supertrendAtrPeriod", minval=1, group=groupExec)
supertrendFactor = input.float(3.0, "supertrendFactor", minval=0.1, step=0.1, group=groupExec)
supertrendBlocksWeakBull = input.bool(false, "supertrendBlocksWeakBull", group=groupExec)
supertrendRiskOffEnabled = input.bool(false, "supertrendRiskOffEnabled", group=groupExec)

groupWeak = "6. Weak Exit"
enableWeakRangeExit = input.bool(false, "enableWeakRangeExit", group=groupWeak)
weakExitAtrLen = input.int(14, "weakExitAtrLen", minval=1, group=groupWeak)
weakExitBars = input.int(6, "weakExitBars", minval=1, group=groupWeak)
weakRunupAtrMax = input.float(1.2, "weakRunupAtrMax", step=0.1, group=groupWeak)
weakLossAtrMin = input.float(-0.3, "weakLossAtrMin", step=0.1, group=groupWeak)
weakSlopeAtrMax = input.float(0.15, "weakSlopeAtrMax", step=0.01, group=groupWeak)

groupRot = "7. Rotation"
eventFloorBars = input.int(4, "eventFloorBars", minval=1, maxval=10, group=groupRot)
bullContinueWindow = input.int(9, "bullContinueWindow", minval=1, maxval=30, group=groupRot)
bearReboundWindow = input.int(7, "bearReboundWindow", minval=1, maxval=30, group=groupRot)
maxHoldBars = input.int(6, "maxHoldBars", minval=1, maxval=30, group=groupRot)

groupView = "8. View"
showEMAs = input.bool(true, "showEMAs", group=groupView)
showSignals = input.bool(true, "showSignals", group=groupView)
showConfMark = input.bool(true, "showConfMark", group=groupView)
showDebugMarks = input.bool(false, "showDebugMarks", group=groupView)

L2v = math.max(L2, L1 + 1)
L3v = math.max(L3, L2v + 1)

ema = ta.ema(close, emaLen)
baseEMA = ta.ema(close, baseEmaLen)
rsi = ta.rsi(close, rsiLen)
atrWeak = ta.atr(weakExitAtrLen)

emaDown = not na(ema[1]) and ema < ema[1]
riskOff = close < baseEMA and rsi < riskOffRsi and emaDown

var int bull = 0
var int bear = 0
var int cycle = 0

has4 = bar_index >= 4 and not na(close[4])
has2 = bar_index >= 2 and not na(close[2])

if not has4
    bull := 0
    bear := 0
    cycle := 0
else
    if cycle < L1
        if close < close[4]
            bull := bull + 1
            bear := 0
            cycle := bull
        else if close > close[4]
            bear := bear + 1
            bull := 0
            cycle := bear
        else
            bull := 0
            bear := 0
            cycle := 0
    else
        if bull > 0
            if has2 and close < close[2]
                bull := bull + 1
                cycle := bull
            else
                bull := 0
                bear := 0
                cycle := 0
        else if bear > 0
            if has2 and close > close[2]
                bear := bear + 1
                cycle := bear
            else
                bull := 0
                bear := 0
                cycle := 0
        else
            bull := 0
            bear := 0
            cycle := 0

bullL1 = bull == L1
bullL2 = bull == L2v
bullL3 = bull == L3v
bearL1 = bear == L1
bearL2 = bear == L2v
bearL3 = bear == L3v

bullCandidate = bullL2
bearCandidate = bearL2
bullStrong = bullL3
bearStrong = bearL3

var int bullSignalBar = na
var int bearSignalBar = na

if bullCandidate or bullStrong
    bullSignalBar := bar_index
if bearCandidate or bearStrong
    bearSignalBar := bar_index

bullConfirmed = not na(bullSignalBar) and bar_index > bullSignalBar and bar_index - bullSignalBar <= confirmBars and close > high[1]
bearConfirmed = not na(bearSignalBar) and bar_index > bearSignalBar and bar_index - bearSignalBar <= confirmBars and close < low[1]

if bullConfirmed or (not na(bullSignalBar) and bar_index - bullSignalBar > confirmBars)
    bullSignalBar := na
if bearConfirmed or (not na(bearSignalBar) and bar_index - bearSignalBar > confirmBars)
    bearSignalBar := na

earlyBullState = bull > 0 and bull < L1
earlyBearState = bear > 0 and bear < L1
earlyBullEvent = earlyBullState and not nz(earlyBullState[1], false)
earlyBearEvent = earlyBearState and not nz(earlyBearState[1], false)

newBullL1 = bullL1 and not nz(bullL1[1], false)
newBullCandidate = bullCandidate and not nz(bullCandidate[1], false)
newBullStrong = bullStrong and not nz(bullStrong[1], false)
newBullConfirmed = bullConfirmed and not nz(bullConfirmed[1], false)
newBearL1 = bearL1 and not nz(bearL1[1], false)
newBearCandidate = bearCandidate and not nz(bearCandidate[1], false)
newBearStrong = bearStrong and not nz(bearStrong[1], false)
newBearConfirmed = bearConfirmed and not nz(bearConfirmed[1], false)

bullEventRaw = earlyBullEvent ? 1 : newBullConfirmed ? 4 : newBullStrong ? 3 : newBullCandidate ? 2 : newBullL1 ? 1 : 0
bearEventRaw = earlyBearEvent ? 1 : newBearConfirmed ? 4 : newBearStrong ? 3 : newBearCandidate ? 2 : newBearL1 ? 1 : 0

bullMomentum = (not na(rsi[1]) and rsi > rsi[1]) or (not na(close[1]) and close > close[1])
bearMomentum = (not na(rsi[1]) and rsi < rsi[1]) or (not na(close[1]) and close < close[1])

f_resolve_conflict(int bullEv, int bearEv) =>
    int resolvedBull = 0
    int resolvedBear = 0
    if bullEv > 0 and bearEv > 0
        if sameBarConflictMode == "BearPriority"
            resolvedBear := bearEv
        else if sameBarConflictMode == "SkipBoth"
            resolvedBull := 0
            resolvedBear := 0
        else
            if bullEv > bearEv
                resolvedBull := bullEv
            else if bearEv > bullEv
                resolvedBear := bearEv
            else
                if bullMomentum and not bearMomentum
                    resolvedBull := bullEv
                else if bearMomentum and not bullMomentum
                    resolvedBear := bearEv
                else if close >= ema
                    resolvedBull := bullEv
                else
                    resolvedBear := bearEv
    else
        resolvedBull := bullEv
        resolvedBear := bearEv
    [resolvedBull, resolvedBear]

[finalBullEvent, finalBearEvent] = f_resolve_conflict(bullEventRaw, bearEventRaw)

bullEventAgeRaw = ta.barssince(earlyBullEvent)
bearEventAgeRaw = ta.barssince(earlyBearEvent)
bullEventAge = na(bullEventAgeRaw) ? na : bullEventAgeRaw
bearEventAge = na(bearEventAgeRaw) ? na : bearEventAgeRaw

postBullEventWindow = not na(bullEventAge) and bullEventAge >= 0 and bullEventAge <= bullContinueWindow
postBearReboundWindow = not na(bearEventAge) and bearEventAge >= 0 and bearEventAge <= bearReboundWindow
primaryEntryTrigger = postBullEventWindow or postBearReboundWindow
entryPass = primaryEntryTrigger and not riskOff
entryRank = postBullEventWindow and postBearReboundWindow ? 2 : postBullEventWindow ? 2 : postBearReboundWindow ? 1 : 0

var slotIds = array.new_string()
var slotEntry = array.new_float()
var slotRank = array.new_int()
var slotBar = array.new_int()
var int nextSlotNo = 1
var int lastLongEntryBar = na

f_entry_qty(float pct) =>
    float rawQty = close > 0 ? (strategy.equity * (pct * 0.01)) / close : 0.0
    math.max(rawQty, minQty)

f_slot_pnl_pct(int idx) =>
    float ep = array.get(slotEntry, idx)
    ep > 0 ? (close - ep) / ep * 100.0 : 0.0

f_find_open_trade_idx(string entryId) =>
    int foundIdx = na
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            if na(foundIdx) and strategy.opentrades.entry_id(i) == entryId
                foundIdx := i
    foundIdx

f_sync_slot_entries() =>
    if useRealFillSync and array.size(slotIds) > 0 and strategy.opentrades > 0
        for i = 0 to array.size(slotIds) - 1
            string sid = array.get(slotIds, i)
            int openIdx = f_find_open_trade_idx(sid)
            if not na(openIdx)
                array.set(slotEntry, i, strategy.opentrades.entry_price(openIdx))

f_find_weakest_idx() =>
    int weakestIdx = na
    float worstPnl = na
    int worstRank = na
    if array.size(slotEntry) > 0
        for i = 0 to array.size(slotEntry) - 1
            float pnl = f_slot_pnl_pct(i)
            int rk = array.get(slotRank, i)
            if na(weakestIdx)
                weakestIdx := i
                worstPnl := pnl
                worstRank := rk
            else if pnl < worstPnl or (math.abs(pnl - worstPnl) < 0.0001 and rk < worstRank)
                weakestIdx := i
                worstPnl := pnl
                worstRank := rk
    weakestIdx

f_find_oldest_idx() =>
    int oldestIdx = na
    int oldestSeenBar = na
    if array.size(slotBar) > 0
        for i = 0 to array.size(slotBar) - 1
            int sb = array.get(slotBar, i)
            if na(oldestIdx) or sb < oldestSeenBar
                oldestIdx := i
                oldestSeenBar := sb
    oldestIdx

f_close_slot(int idx) =>
    if idx >= 0 and idx < array.size(slotIds)
        string idToClose = array.get(slotIds, idx)
        strategy.close(idToClose, immediately=true)
        array.remove(slotIds, idx)
        array.remove(slotEntry, idx)
        array.remove(slotRank, idx)
        array.remove(slotBar, idx)

if strategy.position_size == 0 and array.size(slotIds) > 0
    array.clear(slotIds)
    array.clear(slotEntry)
    array.clear(slotRank)
    array.clear(slotBar)
else
    f_sync_slot_entries()

canEnterLong = na(lastLongEntryBar) or bar_index - lastLongEntryBar >= entryCooldownBars + 1
slotAvailable = array.size(slotIds) < maxSlots
qtyNow = f_entry_qty(slotPct)
qtyOK = qtyNow > 0

if entryPass and canEnterLong and qtyOK
    if slotAvailable
        string newId = "L_" + str.tostring(nextSlotNo)
        nextSlotNo += 1
        strategy.entry(newId, strategy.long, qty=qtyNow)
        array.push(slotIds, newId)
        array.push(slotEntry, close)
        array.push(slotRank, entryRank)
        array.push(slotBar, bar_index)
        lastLongEntryBar := bar_index
    else if useReplacement and entryRank >= replaceMinRank
        int weakIdx = f_find_weakest_idx()
        if not na(weakIdx)
            float weakPnl = f_slot_pnl_pct(weakIdx)
            int weakRank = array.get(slotRank, weakIdx)
            bool canReplace = weakPnl <= replaceIfPnlBelow or entryRank > weakRank
            if canReplace
                f_close_slot(weakIdx)
                string newId = "L_" + str.tostring(nextSlotNo)
                nextSlotNo += 1
                strategy.entry(newId, strategy.long, qty=qtyNow)
                array.push(slotIds, newId)
                array.push(slotEntry, close)
                array.push(slotRank, entryRank)
                array.push(slotBar, bar_index)
                lastLongEntryBar := bar_index

if array.size(slotIds) > 0
    bool continueTimeExit = true
    for step = 0 to 49
        if continueTimeExit and array.size(slotIds) > 0
            int oldestIdx = f_find_oldest_idx()
            if not na(oldestIdx)
                int heldBars = bar_index - array.get(slotBar, oldestIdx)
                if heldBars >= maxHoldBars
                    f_close_slot(oldestIdx)
                else
                    continueTimeExit := false

if finalBearEvent > 0 and array.size(slotIds) > 0
    if finalBearEvent == 1
        int weakIdx1 = f_find_weakest_idx()
        if not na(weakIdx1)
            f_close_slot(weakIdx1)
    if finalBearEvent == 2
        for step = 0 to 1
            if array.size(slotIds) > 0
                int weakIdx2 = f_find_weakest_idx()
                if not na(weakIdx2)
                    f_close_slot(weakIdx2)
    if finalBearEvent == 3
        for step = 0 to 2
            if array.size(slotIds) > 0
                int weakIdx3 = f_find_weakest_idx()
                if not na(weakIdx3)
                    f_close_slot(weakIdx3)
    if finalBearEvent == 4
        bool keepClosing = true
        for step = 0 to 49
            if keepClosing and array.size(slotIds) > 0
                int weakIdx4 = f_find_weakest_idx()
                if not na(weakIdx4)
                    float pnl4 = f_slot_pnl_pct(weakIdx4)
                    if pnl4 <= 0.2
                        f_close_slot(weakIdx4)
                    else
                        keepClosing := false
        if closeAllOnBearConfRiskOff and riskOff
            for step = 0 to 49
                if array.size(slotIds) > 0
                    int weakIdx5 = f_find_weakest_idx()
                    if not na(weakIdx5)
                        f_close_slot(weakIdx5)

if enableWeakRangeExit and array.size(slotIds) > 0
    bool weakSlope = math.abs(close - nz(close[weakExitBars], close)) <= atrWeak * weakSlopeAtrMax
    int weakIdx6 = f_find_weakest_idx()
    if not na(weakIdx6)
        float pnlAtr = atrWeak > 0 ? (close - array.get(slotEntry, weakIdx6)) / atrWeak : 0.0
        int heldWeak = bar_index - array.get(slotBar, weakIdx6)
        bool weakExitNow = heldWeak >= weakExitBars and weakSlope and pnlAtr <= weakRunupAtrMax and pnlAtr >= weakLossAtrMin
        if weakExitNow
            f_close_slot(weakIdx6)

if resetOnL3 and (bull == L3v or bear == L3v)
    bull := 0
    bear := 0
    cycle := 0

plot(showEMAs ? ema : na, "EMA", color=color.orange, linewidth=1)
plot(showEMAs ? baseEMA : na, "Base EMA", color=color.red, linewidth=2)
plotshape(showSignals and bullL1, title="B1", location=location.belowbar, color=color.new(color.green, 65), style=shape.circle, size=size.tiny, text="B1")
plotshape(showSignals and bullCandidate, title="B2", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small, text="B2")
plotshape(showSignals and bullStrong, title="B3", location=location.belowbar, color=color.lime, style=shape.diamond, size=size.small, text="B3")
plotshape(showSignals and bearL1, title="S1", location=location.abovebar, color=color.new(color.red, 65), style=shape.circle, size=size.tiny, text="S1")
plotshape(showSignals and bearCandidate, title="S2", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small, text="S2")
plotshape(showSignals and bearStrong, title="S3", location=location.abovebar, color=color.maroon, style=shape.diamond, size=size.small, text="S3")
plotshape(showConfMark and bullConfirmed, title="BCONF", location=location.belowbar, color=color.blue, style=shape.labelup, size=size.small, text="BC")
plotshape(showConfMark and bearConfirmed, title="SCONF", location=location.abovebar, color=color.orange, style=shape.labeldown, size=size.small, text="SC")
plotchar(showDebugMarks ? (earlyBullEvent ? 1 : 0) : na, title="earlyBullEvent", char="e", location=location.bottom, color=color.lime, size=size.tiny)
plotchar(showDebugMarks ? (earlyBearEvent ? 1 : 0) : na, title="earlyBearEvent", char="r", location=location.top, color=color.red, size=size.tiny)
plotchar(showDebugMarks ? (entryPass ? 1 : 0) : na, title="entryPass", char="E", location=location.bottom, color=color.aqua, size=size.tiny)
plotchar(showDebugMarks ? (riskOff ? 1 : 0) : na, title="riskOff", char="R", location=location.top, color=color.yellow, size=size.tiny)

alertcondition(newBullL1, title="New B1", message="New B1: {{ticker}}")
alertcondition(newBullCandidate, title="New B2", message="New B2: {{ticker}}")
alertcondition(newBullStrong, title="New B3", message="New B3: {{ticker}}")
alertcondition(newBullConfirmed, title="New BCONF", message="New BCONF: {{ticker}}")
alertcondition(newBearL1, title="New S1", message="New S1: {{ticker}}")
alertcondition(newBearCandidate, title="New S2", message="New S2: {{ticker}}")
alertcondition(newBearStrong, title="New S3", message="New S3: {{ticker}}")
alertcondition(newBearConfirmed, title="New SCONF", message="New SCONF: {{ticker}}")