//@version=5
strategy("AF Mock Candidate [mut-restored-frequency-01] [cand-ad20e871]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0, process_orders_on_close=true)

fastLength = input.int(18, "Fast EMA", minval=2)
slowLength = input.int(50, "Slow EMA", minval=3)
trendLength = input.int(100, "Trend EMA", minval=10)
rsiLength = input.int(14, "RSI Length", minval=2)
rsiRecovery = input.int(52, "RSI Recovery Threshold", minval=1, maxval=99)
rsiOversold = input.int(44, "RSI Pullback Threshold", minval=1, maxval=99)
atrLength = input.int(14, "ATR Length", minval=1)
stopAtrMult = input.float(2.2, "Stop ATR Mult", minval=0.1, step=0.1)
profitAtrMult = input.float(4.0, "Target ATR Mult", minval=0.1, step=0.1)
timeStopBars = input.int(18, "Time Stop Bars", minval=1)
breakoutLookback = input.int(20, "Breakout Lookback", minval=2)
minEmaSpreadPct = input.float(0.001, "Min EMA Spread %", minval=0.0, step=0.0005)
useBreakoutEntry = input.bool(true, "Enable Breakout Entry")

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
trendEma = ta.ema(close, trendLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

emaBull = fastEma > slowEma
trendBull = close > trendEma and slowEma > trendEma
emaSlopeBull = fastEma > fastEma[1] and slowEma >= slowEma[1]
emaSpreadOk = math.abs(fastEma - slowEma) / close > minEmaSpreadPct
regimeOk = trendBull and emaSlopeBull and emaSpreadOk

pullbackContext = close > slowEma and low <= fastEma
rsiRecovered = rsiValue > rsiRecovery and rsiValue[1] <= rsiRecovery
rsiWasSoft = ta.lowest(rsiValue, 4) < rsiOversold
trendPullbackEntry = regimeOk and emaBull and pullbackContext and rsiRecovered and rsiWasSoft

breakoutLevel = ta.highest(high[1], breakoutLookback)
breakoutEntry = useBreakoutEntry and regimeOk and emaBull and close > breakoutLevel and rsiValue > 55

longEntry = strategy.position_size <= 0 and (trendPullbackEntry or breakoutEntry)

var int entryBarIndex = na
if longEntry
    strategy.entry("Long", strategy.long)
    entryBarIndex := bar_index

if strategy.position_size > 0 and na(entryBarIndex)
    entryBarIndex := bar_index
if strategy.position_size <= 0
    entryBarIndex := na

avgPrice = strategy.position_avg_price
stopPrice = avgPrice - atrValue * stopAtrMult
limitPrice = avgPrice + atrValue * profitAtrMult
if strategy.position_size > 0
    strategy.exit("Long Exit", "Long", stop=stopPrice, limit=limitPrice)

barsInTrade = strategy.position_size > 0 and not na(entryBarIndex) ? bar_index - entryBarIndex : 0
momentumFail = rsiValue < 46
trendFail = close < slowEma and fastEma < slowEma
longClose = strategy.position_size > 0 and (barsInTrade >= timeStopBars or momentumFail or trendFail)
if longClose
    strategy.close("Long")

plot(fastEma, "Fast EMA", color=color.new(color.teal, 0))
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0))
plot(trendEma, "Trend EMA", color=color.new(color.blue, 20))
plot(breakoutLevel, "Breakout Level", color=color.new(color.green, 70), style=plot.style_linebr)
plotshape(longEntry, title="Long Entry", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny)
plotshape(longClose, title="Long Close", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny)