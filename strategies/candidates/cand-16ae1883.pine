//@version=5
strategy("AF Mock Candidate [cand-3c7d9856]-mutA [cand-16ae1883]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0, process_orders_on_close=true)

fastLength = input.int(21, "Fast EMA", minval=2)
slowLength = input.int(55, "Slow EMA", minval=3)
rsiLength = input.int(14, "RSI Length", minval=2)
atrLength = input.int(14, "ATR Length", minval=2)
adxLength = input.int(14, "ADX Length", minval=2)
bbLength = input.int(20, "BB Length", minval=5)
bbMult = input.float(2.0, "BB Mult", minval=0.5, step=0.1)
lookbackExt = input.int(6, "Late Entry Lookback", minval=2)
maxExtensionAtr = input.float(1.2, "Max Short-Term Extension ATR", minval=0.2, step=0.1)
maxDistanceFromFastAtr = input.float(1.0, "Max Distance From Fast EMA ATR", minval=0.2, step=0.1)
minAdx = input.float(16.0, "Min ADX", minval=5.0, step=0.5)
minBbWidthPct = input.float(0.018, "Min BB Width %", minval=0.001, step=0.001)
stopAtrMult = input.float(2.2, "Stop ATR Mult", minval=0.5, step=0.1)
trailAtrMult = input.float(2.6, "Trail ATR Mult", minval=0.5, step=0.1)
profitAtrMult = input.float(4.0, "Profit ATR Mult", minval=0.5, step=0.1)
maxHoldBars = input.int(22, "Max Hold Bars", minval=2)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
tr = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
trRma = ta.rma(tr, adxLength)
plusDI = trRma != 0 ? 100 * ta.rma(plusDM, adxLength) / trRma : 0.0
minusDI = trRma != 0 ? 100 * ta.rma(minusDM, adxLength) / trRma : 0.0
dx = (plusDI + minusDI) != 0 ? 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI) : 0.0
adx = ta.rma(dx, adxLength)

bbBasis = ta.sma(close, bbLength)
bbDev = bbMult * ta.stdev(close, bbLength)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
bbWidthPct = bbBasis != 0 ? (bbUpper - bbLower) / bbBasis : 0.0

shortTermRunup = close - ta.lowest(low, lookbackExt)
extensionAtr = atrValue != 0 ? shortTermRunup / atrValue : 0.0
distanceFromFastAtr = atrValue != 0 ? (close - fastEma) / atrValue : 0.0
trendUp = fastEma > slowEma and slowEma > slowEma[1]
notLateEntry = extensionAtr < maxExtensionAtr and distanceFromFastAtr < maxDistanceFromFastAtr and close <= ta.highest(high, lookbackExt)[1]
notSqueeze = bbWidthPct > minBbWidthPct and adx > minAdx
momentumOk = rsiValue > 52 and rsiValue < 68 and plusDI > minusDI
entrySignal = ta.crossover(fastEma, slowEma) and trendUp and momentumOk and notLateEntry and notSqueeze

var int barsInTrade = 0
barsInTrade := strategy.position_size > 0 ? nz(barsInTrade[1]) + 1 : 0

var float highestSinceEntry = na
highestSinceEntry := strategy.position_size > 0 ? math.max(nz(highestSinceEntry[1], high), high) : na

entryPrice = strategy.position_avg_price
stopPrice = strategy.position_size > 0 ? entryPrice - atrValue * stopAtrMult : na
profitPrice = strategy.position_size > 0 ? entryPrice + atrValue * profitAtrMult : na
trailPrice = strategy.position_size > 0 ? highestSinceEntry - atrValue * trailAtrMult : na
activeStop = strategy.position_size > 0 ? math.max(stopPrice, trailPrice) : na

weakTrendExit = strategy.position_size > 0 and fastEma < fastEma[1] and rsiValue < 48
trendCrossExit = strategy.position_size > 0 and ta.crossunder(fastEma, slowEma)
rangeFailureExit = strategy.position_size > 0 and adx < minAdx * 0.9 and rsiValue < 50 and close < fastEma
lateLossExit = strategy.position_size > 0 and barsInTrade >= 4 and close < entryPrice and close < fastEma and rsiValue < 50
maxHoldExit = strategy.position_size > 0 and barsInTrade >= maxHoldBars

if entrySignal and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    strategy.exit("Long Exit", "Long", stop=activeStop, limit=profitPrice)

if weakTrendExit or trendCrossExit or rangeFailureExit or lateLossExit or maxHoldExit
    strategy.close("Long")

plot(fastEma, color=color.new(color.teal, 0), title="Fast EMA")
plot(slowEma, color=color.new(color.orange, 0), title="Slow EMA")
plot(bbUpper, color=color.new(color.blue, 75), title="BB Upper")
plot(bbLower, color=color.new(color.blue, 75), title="BB Lower")