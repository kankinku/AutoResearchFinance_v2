//@version=5
strategy("AF Seed 01 Mut Balanced Recovery Repaired [cand-f055fdf7]", overlay=true, pyramiding=30, process_orders_on_close=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=5, commission_type=strategy.commission.percent, commission_value=0.05)

groupSig = "1. Exhaustion"
L1 = input.int(9, "L1", minval=2, group=groupSig)
L2_in = input.int(12, "L2", minval=3, group=groupSig)
L3_in = input.int(14, "L3", minval=4, group=groupSig)
confirmBars = input.int(2, "confirmBars", minval=1, maxval=5, group=groupSig)

groupFilter = "2. Minimum Filter"
emaLen = input.int(21, "emaLen", minval=1, group=groupFilter)
baseEmaLen = input.int(55, "baseEmaLen", minval=1, group=groupFilter)
rsiLen = input.int(14, "rsiLen", minval=2, group=groupFilter)
maxExtPct = input.float(6.0, "maxExtPct", minval=1.0, step=0.5, group=groupFilter)
riskOffRsi = input.float(45.0, "riskOffRsi", minval=5.0, maxval=95.0, step=0.5, group=groupFilter)

groupPos = "3. Slot Management"
slotPct = input.float(5.0, "slotPct", minval=0.1, maxval=100.0, step=0.5, group=groupPos)
maxSlots = input.int(9, "maxSlots", minval=1, maxval=50, group=groupPos)
useReplacement = input.bool(true, "useReplacement", group=groupPos)
replaceMinRank = input.int(3, "replaceMinRank", minval=1, maxval=4, group=groupPos)
replaceIfPnlBelow = input.float(0.0, "replaceIfPnlBelow", step=0.5, group=groupPos)
applyFilterToB1 = input.bool(false, "applyFilterToB1", group=groupPos)
minQty = input.float(1.0, "minQty", minval=0.000001, step=0.1, group=groupPos)

groupExit = "4. Exit"
closeAllOnBearConfRiskOff = input.bool(true, "closeAllOnBearConfRiskOff", group=groupExit)

groupExec = "5. Execution"
sameBarConflictMode = input.string("StrongWins", "sameBarConflictMode", options=["StrongWins", "SkipBoth", "BearPriority"], group=groupExec)
trendMode = input.string("Balanced", "trendMode", options=["Strict", "Balanced", "Loose"], group=groupExec)
allowStrongCounterTrend = input.bool(true, "allowStrongCounterTrend", group=groupExec)
entryCooldownBars = input.int(0, "entryCooldownBars", minval=0, maxval=20, group=groupExec)
useRealFillSync = input.bool(true, "useRealFillSync", group=groupExec)
resetOnL3 = input.bool(false, "resetOnL3", group=groupExec)

groupST = "6. Supertrend Filter"
useSupertrendFilter = input.bool(false, "useSupertrendFilter", group=groupST)
supertrendAtrPeriod = input.int(10, "supertrendAtrPeriod", minval=1, group=groupST)
supertrendFactor = input.float(3.0, "supertrendFactor", minval=0.1, step=0.1, group=groupST)
supertrendBlocksWeakBull = input.bool(true, "supertrendBlocksWeakBull", group=groupST)
supertrendRiskOffEnabled = input.bool(false, "supertrendRiskOffEnabled", group=groupST)

groupWeak = "7. Weak Range Exit"
enableWeakRangeExit = input.bool(true, "enableWeakRangeExit", group=groupWeak)
weakExitAtrLen = input.int(14, "weakExitAtrLen", minval=1, group=groupWeak)
weakExitBars = input.int(5, "weakExitBars", minval=2, maxval=20, group=groupWeak)
weakRunupAtrMax = input.float(1.2, "weakRunupAtrMax", minval=0.1, step=0.1, group=groupWeak)
weakLossAtrMin = input.float(0.6, "weakLossAtrMin", minval=0.1, step=0.1, group=groupWeak)
weakSlopeAtrMax = input.float(0.25, "weakSlopeAtrMax", minval=0.0, step=0.05, group=groupWeak)

groupDebug = "8. Debug"
showDebugMarks = input.bool(false, "showDebugMarks", group=groupDebug)

groupView = "9. Display"
showEMAs = input.bool(true, "showEMAs", group=groupView)
showSignals = input.bool(true, "showSignals", group=groupView)
showConfMark = input.bool(true, "showConfMark", group=groupView)

L2 = math.max(L2_in, L1 + 1)
L3 = math.max(L3_in, L2 + 1)

ema = ta.ema(close, emaLen)
baseEMA = ta.ema(close, baseEmaLen)
rsi = ta.rsi(close, rsiLen)
atrWeak = ta.atr(weakExitAtrLen)
atrST = ta.atr(supertrendAtrPeriod)

bullTrend = close >= ema
bearTrend = close <= ema
bullMomentum = ((not na(rsi[1])) and rsi > rsi[1]) or ((not na(close[1])) and close > close[1])
bearMomentum = ((not na(rsi[1])) and rsi < rsi[1]) or ((not na(close[1])) and close < close[1])
emaUp = not na(ema[1]) and ema >= ema[1]
emaDown = not na(ema[1]) and ema <= ema[1]

stBasis = hl2
stUpperBasic = stBasis + supertrendFactor * atrST
stLowerBasic = stBasis - supertrendFactor * atrST
var float stUpper = na
var float stLower = na
var int stDir = 1
prevStUpper = nz(stUpper[1], stUpperBasic)
prevStLower = nz(stLower[1], stLowerBasic)
prevStDir = nz(stDir[1], 1)
stUpper := na(stUpper[1]) ? stUpperBasic : ((stUpperBasic < prevStUpper or close[1] > prevStUpper) ? stUpperBasic : prevStUpper)
stLower := na(stLower[1]) ? stLowerBasic : ((stLowerBasic > prevStLower or close[1] < prevStLower) ? stLowerBasic : prevStLower)
stDir := prevStDir
if prevStDir == -1 and close > prevStUpper
    stDir := 1
else if prevStDir == 1 and close < prevStLower
    stDir := -1
supertrendBull = stDir == 1
supertrendBear = stDir == -1

riskOffBase = close < baseEMA and rsi < riskOffRsi and emaDown
riskOff = riskOffBase or (supertrendRiskOffEnabled and useSupertrendFilter and supertrendBear)
overextended = close > ema * (1.0 + maxExtPct / 100.0)

var int cycle = 0
var int bull = 0
var int bear = 0

has4 = bar_index >= 4 and not na(close[4])
has2 = bar_index >= 2 and not na(close[2])

if not has4
    bull := 0
    bear := 0
    cycle := 0
else
    if cycle < L1
        if close < close[4]
            bull := bull + 1
            bear := 0
            cycle := bull
        else if close > close[4]
            bear := bear + 1
            bull := 0
            cycle := bear
        else
            bull := 0
            bear := 0
            cycle := 0
    else
        if bull > 0
            if has2 and close < close[2]
                bull := bull + 1
                cycle := bull
            else
                if close < close[4]
                    bull := 1
                    bear := 0
                    cycle := 1
                else if close > close[4]
                    bear := 1
                    bull := 0
                    cycle := 1
                else
                    bull := 0
                    bear := 0
                    cycle := 0
        else if bear > 0
            if has2 and close > close[2]
                bear := bear + 1
                cycle := bear
            else
                if close < close[4]
                    bull := 1
                    bear := 0
                    cycle := 1
                else if close > close[4]
                    bear := 1
                    bull := 0
                    cycle := 1
                else
                    bull := 0
                    bear := 0
                    cycle := 0
        else
            if close < close[4]
                bull := 1
                bear := 0
                cycle := 1
            else if close > close[4]
                bear := 1
                bull := 0
                cycle := 1
            else
                bull := 0
                bear := 0
                cycle := 0

bullL1 = bull == L1
bullL2 = bull == L2
bullL3 = bull == L3
bearL1 = bear == L1
bearL2 = bear == L2
bearL3 = bear == L3

bullCandidate = bullL2
bearCandidate = bearL2
bullStrong = bullL3
bearStrong = bearL3

var int bullSignalBar = na
var int bearSignalBar = na
if bullCandidate or bullStrong
    bullSignalBar := bar_index
if bearCandidate or bearStrong
    bearSignalBar := bar_index

bullConfirmed = not na(bullSignalBar) and bar_index > bullSignalBar and (bar_index - bullSignalBar <= confirmBars) and close > high[1]
bearConfirmed = not na(bearSignalBar) and bar_index > bearSignalBar and (bar_index - bearSignalBar <= confirmBars) and close < low[1]

if bullConfirmed or (not na(bullSignalBar) and bar_index - bullSignalBar > confirmBars)
    bullSignalBar := na
if bearConfirmed or (not na(bearSignalBar) and bar_index - bearSignalBar > confirmBars)
    bearSignalBar := na

newBullL1 = bullL1 and not nz(bullL1[1], false)
newBullCandidate = bullCandidate and not nz(bullCandidate[1], false)
newBullStrong = bullStrong and not nz(bullStrong[1], false)
newBullConfirmed = bullConfirmed and not nz(bullConfirmed[1], false)
newBearL1 = bearL1 and not nz(bearL1[1], false)
newBearCandidate = bearCandidate and not nz(bearCandidate[1], false)
newBearStrong = bearStrong and not nz(bearStrong[1], false)
newBearConfirmed = bearConfirmed and not nz(bearConfirmed[1], false)

bullEventRaw = newBullConfirmed ? 4 : newBullStrong ? 3 : newBullCandidate ? 2 : newBullL1 ? 1 : 0
bearEventRaw = newBearConfirmed ? 4 : newBearStrong ? 3 : newBearCandidate ? 2 : newBearL1 ? 1 : 0

resolvedBull = 0
resolvedBear = 0
if bullEventRaw > 0 and bearEventRaw > 0
    if sameBarConflictMode == "BearPriority"
        resolvedBear := bearEventRaw
    else if sameBarConflictMode == "SkipBoth"
        resolvedBull := 0
        resolvedBear := 0
    else
        if bullEventRaw > bearEventRaw
            resolvedBull := bullEventRaw
        else if bearEventRaw > bullEventRaw
            resolvedBear := bearEventRaw
        else
            if bullMomentum and not bearMomentum
                resolvedBull := bullEventRaw
            else if bearMomentum and not bullMomentum
                resolvedBear := bearEventRaw
            else if close > ema and rsi >= 50
                resolvedBull := bullEventRaw
            else if close < ema and rsi <= 50
                resolvedBear := bearEventRaw
else
    resolvedBull := bullEventRaw
    resolvedBear := bearEventRaw

finalBullEvent = resolvedBull
finalBearEvent = resolvedBear
allowBull = finalBullEvent > 0
allowBear = finalBearEvent > 0

bullRecoveryOk = false
if trendMode == "Strict"
    bullRecoveryOk := bullTrend and bullMomentum
else if trendMode == "Balanced"
    bullRecoveryOk := bullMomentum or bullTrend or emaUp or close > open or rsi >= 50
else
    bullRecoveryOk := bullMomentum or close > open or close >= ema * 0.995

supertrendBullPass = not useSupertrendFilter or supertrendBull or (not supertrendBlocksWeakBull and finalBullEvent >= 3)
bullRiskAllowed = not riskOff or (allowStrongCounterTrend and finalBullEvent >= 3 and (bullMomentum or close > open))
overextendPass = not overextended or finalBullEvent >= 3 or (finalBullEvent == 2 and close >= ema)
bullBaseAllowed = bullRiskAllowed and overextendPass and supertrendBullPass

bullB1Allowed = true
if applyFilterToB1
    bullB1Allowed := bullBaseAllowed and (bullRecoveryOk or bullTrend)

bullFilterPass = false
if finalBullEvent == 1
    bullFilterPass := bullB1Allowed
else if finalBullEvent == 2
    bullFilterPass := bullBaseAllowed and (bullRecoveryOk or bullTrend)
else if finalBullEvent == 3
    bullFilterPass := bullBaseAllowed and (bullRecoveryOk or bullMomentum or close > open)
else if finalBullEvent == 4
    bullFilterPass := bullBaseAllowed and (bullRecoveryOk or close > ema or close > open)

var slotIds = array.new_string()
var slotEntry = array.new_float()
var slotRank = array.new_int()
var int nextSlotNo = 1
var int lastLongEntryBar = na
var int lastOrderBar = na

f_entry_qty(float pct) =>
    rawQty = close > 0 ? (strategy.equity * (pct * 0.01)) / close : 0.0
    math.max(rawQty, minQty)

f_slot_pnl_pct(int idx) =>
    ep = array.get(slotEntry, idx)
    ep > 0 ? ((close - ep) / ep) * 100.0 : 0.0

f_find_open_trade_idx(string entryId) =>
    int foundIdx = na
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            if na(foundIdx) and strategy.opentrades.entry_id(i) == entryId
                foundIdx := i
    foundIdx

f_find_weakest_idx() =>
    int weakestIdx = na
    float worstPnl = na
    int worstRank = na
    if array.size(slotEntry) > 0
        for i = 0 to array.size(slotEntry) - 1
            pnl = f_slot_pnl_pct(i)
            rk = array.get(slotRank, i)
            if na(weakestIdx)
                weakestIdx := i
                worstPnl := pnl
                worstRank := rk
            else if pnl < worstPnl or (math.abs(pnl - worstPnl) < 0.0001 and rk < worstRank)
                weakestIdx := i
                worstPnl := pnl
                worstRank := rk
    weakestIdx

if strategy.position_size == 0 and array.size(slotIds) > 0 and (na(lastOrderBar) or bar_index > lastOrderBar)
    array.clear(slotIds)
    array.clear(slotEntry)
    array.clear(slotRank)
else
    if useRealFillSync and array.size(slotIds) > 0 and strategy.opentrades > 0
        for i = 0 to array.size(slotIds) - 1
            sid = array.get(slotIds, i)
            openIdx = f_find_open_trade_idx(sid)
            if not na(openIdx)
                array.set(slotEntry, i, strategy.opentrades.entry_price(openIdx))

canEnterLong = na(lastLongEntryBar) or (bar_index - lastLongEntryBar >= entryCooldownBars + 1)
slotAvailable = array.size(slotIds) < maxSlots
qtyNow = f_entry_qty(slotPct)
qtyOK = qtyNow > 0

if allowBull and bullFilterPass and canEnterLong and qtyOK
    if slotAvailable
        newId = "L_" + str.tostring(nextSlotNo)
        nextSlotNo += 1
        strategy.entry(newId, strategy.long, qty=qtyNow)
        array.push(slotIds, newId)
        array.push(slotEntry, close)
        array.push(slotRank, finalBullEvent)
        lastLongEntryBar := bar_index
        lastOrderBar := bar_index
    else if useReplacement and finalBullEvent >= replaceMinRank
        weakIdx = f_find_weakest_idx()
        if not na(weakIdx)
            weakPnl = f_slot_pnl_pct(weakIdx)
            weakRank = array.get(slotRank, weakIdx)
            canReplace = weakPnl <= replaceIfPnlBelow or finalBullEvent > weakRank
            if canReplace
                idToClose = array.get(slotIds, weakIdx)
                strategy.close(idToClose, immediately=true)
                array.remove(slotIds, weakIdx)
                array.remove(slotEntry, weakIdx)
                array.remove(slotRank, weakIdx)
                lastOrderBar := bar_index
                newId2 = "L_" + str.tostring(nextSlotNo)
                nextSlotNo += 1
                strategy.entry(newId2, strategy.long, qty=qtyNow)
                array.push(slotIds, newId2)
                array.push(slotEntry, close)
                array.push(slotRank, finalBullEvent)
                lastLongEntryBar := bar_index
                lastOrderBar := bar_index

if enableWeakRangeExit and array.size(slotIds) > 0 and bar_index >= weakExitBars and atrWeak > 0
    lookbackHigh = ta.highest(high, weakExitBars)
    runupAtr = (lookbackHigh - close) / atrWeak
    weakIdxRange = f_find_weakest_idx()
    if not na(weakIdxRange)
        weakLossAtr = (array.get(slotEntry, weakIdxRange) - close) / atrWeak
        slopeAtr = math.abs(ema - ema[weakExitBars]) / atrWeak
        weakRangeNow = runupAtr <= weakRunupAtrMax and weakLossAtr >= weakLossAtrMin and slopeAtr <= weakSlopeAtrMax and close < ema
        if weakRangeNow
            idToClose2 = array.get(slotIds, weakIdxRange)
            strategy.close(idToClose2, immediately=true)
            array.remove(slotIds, weakIdxRange)
            array.remove(slotEntry, weakIdxRange)
            array.remove(slotRank, weakIdxRange)
            lastOrderBar := bar_index

if allowBear and array.size(slotIds) > 0
    if finalBearEvent == 1 or finalBearEvent == 2
        weakIdx1 = f_find_weakest_idx()
        if not na(weakIdx1)
            idToClose3 = array.get(slotIds, weakIdx1)
            strategy.close(idToClose3, immediately=true)
            array.remove(slotIds, weakIdx1)
            array.remove(slotEntry, weakIdx1)
            array.remove(slotRank, weakIdx1)
            lastOrderBar := bar_index
    if finalBearEvent == 3
        for step = 0 to 1
            if array.size(slotIds) > 0
                weakIdx2 = f_find_weakest_idx()
                if not na(weakIdx2)
                    idToClose4 = array.get(slotIds, weakIdx2)
                    strategy.close(idToClose4, immediately=true)
                    array.remove(slotIds, weakIdx2)
                    array.remove(slotEntry, weakIdx2)
                    array.remove(slotRank, weakIdx2)
                    lastOrderBar := bar_index
    if finalBearEvent == 4
        keepClosingLoss = true
        for step = 0 to 49
            if keepClosingLoss and array.size(slotIds) > 0
                weakIdx3 = f_find_weakest_idx()
                if not na(weakIdx3)
                    pnl3 = f_slot_pnl_pct(weakIdx3)
                    if pnl3 < 0
                        idToClose5 = array.get(slotIds, weakIdx3)
                        strategy.close(idToClose5, immediately=true)
                        array.remove(slotIds, weakIdx3)
                        array.remove(slotEntry, weakIdx3)
                        array.remove(slotRank, weakIdx3)
                        lastOrderBar := bar_index
                    else
                        keepClosingLoss := false
        if closeAllOnBearConfRiskOff and riskOff
            for step = 0 to 49
                if array.size(slotIds) > 0
                    weakIdx4 = f_find_weakest_idx()
                    if not na(weakIdx4)
                        idToClose6 = array.get(slotIds, weakIdx4)
                        strategy.close(idToClose6, immediately=true)
                        array.remove(slotIds, weakIdx4)
                        array.remove(slotEntry, weakIdx4)
                        array.remove(slotRank, weakIdx4)
                        lastOrderBar := bar_index

if resetOnL3 and (bull == L3 or bear == L3)
    bull := 0
    bear := 0
    cycle := 0

plot(showEMAs ? ema : na, "EMA", color=color.orange, linewidth=1)
plot(showEMAs ? baseEMA : na, "Base EMA", color=color.red, linewidth=2)
plot(showEMAs and useSupertrendFilter ? stLower : na, "ST Lower", color=color.new(color.green, 60), linewidth=1)
plot(showEMAs and useSupertrendFilter ? stUpper : na, "ST Upper", color=color.new(color.red, 60), linewidth=1)

plotshape(showSignals and bullL1, title="B1", location=location.belowbar, color=color.new(color.green, 65), style=shape.circle, size=size.tiny, text="B1")
plotshape(showSignals and bullCandidate, title="B2", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small, text="B2")
plotshape(showSignals and bullStrong, title="B3", location=location.belowbar, color=color.lime, style=shape.diamond, size=size.small, text="B3")
plotshape(showSignals and bearL1, title="S1", location=location.abovebar, color=color.new(color.red, 65), style=shape.circle, size=size.tiny, text="S1")
plotshape(showSignals and bearCandidate, title="S2", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small, text="S2")
plotshape(showSignals and bearStrong, title="S3", location=location.abovebar, color=color.maroon, style=shape.diamond, size=size.small, text="S3")
plotshape(showConfMark and bullConfirmed, title="BCONF", location=location.belowbar, color=color.blue, style=shape.labelup, size=size.small, text="BC")
plotshape(showConfMark and bearConfirmed, title="SCONF", location=location.abovebar, color=color.orange, style=shape.labeldown, size=size.small, text="SC")

plotchar(showDebugMarks ? (allowBull ? 1 : 0) : na, title="allowBull", char='B', location=location.top, color=color.lime, size=size.tiny)
plotchar(showDebugMarks ? (bullFilterPass ? 1 : 0) : na, title="bullFilterPass", char='F', location=location.top, color=color.green, size=size.tiny)
plotchar(showDebugMarks ? (slotAvailable ? 1 : 0) : na, title="slotAvailable", char='S', location=location.top, color=color.aqua, size=size.tiny)
plotchar(showDebugMarks ? (qtyOK ? 1 : 0) : na, title="qtyOK", char='Q', location=location.top, color=color.yellow, size=size.tiny)
plotchar(showDebugMarks ? (allowBear ? 1 : 0) : na, title="allowBear", char='R', location=location.bottom, color=color.red, size=size.tiny)
plotchar(showDebugMarks ? (riskOff ? 1 : 0) : na, title="riskOff", char='X', location=location.bottom, color=color.orange, size=size.tiny)

alertcondition(newBullL1, title="New B1", message="New B1: {{ticker}}")
alertcondition(newBullCandidate, title="New B2", message="New B2: {{ticker}}")
alertcondition(newBullStrong, title="New B3", message="New B3: {{ticker}}")
alertcondition(newBullConfirmed, title="New BCONF", message="New BCONF: {{ticker}}")
alertcondition(newBearL1, title="New S1", message="New S1: {{ticker}}")
alertcondition(newBearCandidate, title="New S2", message="New S2: {{ticker}}")
alertcondition(newBearStrong, title="New S3", message="New S3: {{ticker}}")
alertcondition(newBearConfirmed, title="New SCONF", message="New SCONF: {{ticker}}")
