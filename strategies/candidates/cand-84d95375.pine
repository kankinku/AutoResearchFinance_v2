//@version=5
strategy("AF Seed 01 Mutation [seed-preserve-freq-restore-tight-range-exit] [cand-mut-qqq120-01] [cand-84d95375]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=2)

fastLength = input.int(21, "Fast EMA", minval=2)
slowLength = input.int(55, "Slow EMA", minval=3)
rsiLength = input.int(14, "RSI Length", minval=2)
adxLength = input.int(14, "ADX Length", minval=2)
atrLength = input.int(14, "ATR Length", minval=2)
trendLookback = input.int(20, "Trend Slope Lookback", minval=2)
extLookback = input.int(8, "Extension Lookback", minval=2)
maxExtensionPct = input.float(2.8, "Max Short-Term Extension %", minval=0.2, step=0.1)
maxFastDistPct = input.float(1.9, "Max Distance Above Fast EMA %", minval=0.1, step=0.1)
maxEntryRsi = input.int(72, "Max RSI For Entry Stretch Filter", minval=50, maxval=95)
minRsi = input.int(51, "Min RSI For Entry", minval=1, maxval=99)
minAdx = input.float(14.5, "Min ADX For Entry", minval=1, step=0.5)
stopAtrMult = input.float(2.1, "Stop ATR Mult", minval=0.5, step=0.1)
trailAtrMult = input.float(2.3, "Trail ATR Mult", minval=0.5, step=0.1)
maxBarsInTrade = input.int(18, "Max Bars In Trade", minval=1)
lossBarsExit = input.int(5, "Lose-After Bars Exit", minval=1)
retraceExitAtr = input.float(1.0, "Peak Retrace Exit ATR", minval=0.2, step=0.1)
quickLossAtr = input.float(-0.55, "Quick Loss ATR Threshold", maxval=0, step=0.05)
rangeAdxMax = input.float(18.0, "Range ADX Max", minval=5, step=0.5)
squeezeWidthPctMax = input.float(2.3, "Squeeze Width % Max", minval=0.2, step=0.1)
rangeWeakLossAtr = input.float(-0.15, "Range Weak Loss ATR", maxval=0, step=0.05)
rangeQuickLossAtr = input.float(-0.30, "Range Quick Loss ATR", maxval=0, step=0.05)
deepDrawdownAtr = input.float(-0.85, "Deep Drawdown ATR Exit", maxval=0, step=0.05)
weakMomentumRsi = input.int(50, "Weak Momentum RSI Exit", minval=1, maxval=99)
confirmBarsMax = input.int(4, "Confirmation Window Bars", minval=1, maxval=10)
exhaustDownBars = input.int(3, "Exhaustion Down Count", minval=2, maxval=8)
slot2PullbackAtr = input.float(0.45, "Slot 2 Pullback ATR", minval=0.1, step=0.05)
slot3BreakoutAtr = input.float(0.20, "Slot 3 Breakout ATR", minval=0.05, step=0.05)
replaceLossAtr = input.float(-0.60, "Replacement Loss ATR", maxval=0, step=0.05)
rangeExitTimeBars = input.int(6, "Range Squeeze Time Exit Bars", minval=2)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
trur = ta.rma(ta.tr(true), adxLength)
plusDI = trur == 0.0 ? 0.0 : 100.0 * ta.rma(plusDM, adxLength) / trur
minusDI = trur == 0.0 ? 0.0 : 100.0 * ta.rma(minusDM, adxLength) / trur
dx = (plusDI + minusDI == 0.0) ? 0.0 : 100.0 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adx = ta.rma(dx, adxLength)

slowSlopeUp = slowEma > slowEma[trendLookback]
trendDownRegime = fastEma < slowEma and slowEma < slowEma[trendLookback] and minusDI > plusDI
shortTermExtensionPct = ((close / ta.lowest(close, extLookback)) - 1.0) * 100.0
fastDistPct = fastEma == 0.0 ? 0.0 : ((close / fastEma) - 1.0) * 100.0
bandBasis = ta.sma(close, 20)
bandDev = ta.stdev(close, 20)
bandUpper = bandBasis + bandDev * 2.0
bandLower = bandBasis - bandDev * 2.0
bandWidthPct = bandBasis == 0.0 ? 0.0 : ((bandUpper - bandLower) / bandBasis) * 100.0
rangeRegime = adx < rangeAdxMax and math.abs(fastEma - slowEma) / close < 0.012
rangeSqueezeRegime = rangeRegime and bandWidthPct < squeezeWidthPctMax
notLateExtension = shortTermExtensionPct < maxExtensionPct and fastDistPct < maxFastDistPct and rsiValue < maxEntryRsi
trendQualified = fastEma > slowEma and slowSlopeUp and adx > minAdx and plusDI >= minusDI
momentumOk = rsiValue > minRsi and (rsiValue > rsiValue[1] or close > close[1])

exhaustionDn = close < close[1] ? nz(exhaustionDn[1]) + 1 : 0
priceConfirmation = close > high[1] or (close > fastEma and close > open)
exhaustionReady = exhaustionDn[1] >= exhaustDownBars
confirmationLong = exhaustionReady and priceConfirmation
baseCross = ta.crossover(fastEma, slowEma)
pullbackContinuation = close > fastEma and low <= fastEma and close > open and close[1] <= fastEma[1]
followThroughConfirm = ta.barssince(confirmationLong) >= 0 and ta.barssince(confirmationLong) <= confirmBarsMax and close > fastEma and close >= close[1]
shallowDipRecovery = close > fastEma and close[1] < fastEma[1] and low > slowEma and rsiValue > minRsi - 2

primaryLongSignal = (baseCross or pullbackContinuation or followThroughConfirm or shallowDipRecovery) and momentumOk and trendQualified and not trendDownRegime and notLateExtension

var int entryBarIndex = na
var float peakOpenPnLAtr = na
var int slotCount = 0
var int lastEntryBar = na
var float lastEntryPrice = na

newLongOpened = strategy.position_size > 0 and strategy.position_size[1] <= 0
flatNow = strategy.position_size <= 0

if flatNow
    slotCount := 0
    lastEntryBar := na
    lastEntryPrice := na

avgPrice = strategy.position_avg_price
openPnLAtr = strategy.position_size > 0 ? (close - avgPrice) / atrValue : 0.0

slot1Entry = primaryLongSignal and strategy.position_size <= 0
slot2Entry = strategy.position_size > 0 and slotCount == 1 and trendQualified and notLateExtension and close > slowEma and low <= fastEma and openPnLAtr > -slot2PullbackAtr and close >= open
slot3Entry = strategy.position_size > 0 and slotCount == 2 and trendQualified and notLateExtension and close > nz(lastEntryPrice, close) + atrValue * slot3BreakoutAtr and rsiValue >= rsiValue[1]
replacementEntry = strategy.position_size > 0 and slotCount < 3 and openPnLAtr <= replaceLossAtr and confirmationLong and trendQualified and notLateExtension

if slot1Entry
    strategy.entry("L1", strategy.long, qty_percent=34)
if slot2Entry
    strategy.entry("L2", strategy.long, qty_percent=33)
if slot3Entry or replacementEntry
    strategy.entry("L3", strategy.long, qty_percent=33)

if strategy.position_size > strategy.position_size[1]
    slotCount += 1
    lastEntryBar := bar_index
    lastEntryPrice := close

if newLongOpened
    entryBarIndex := bar_index
    peakOpenPnLAtr := 0.0
if flatNow
    entryBarIndex := na
    peakOpenPnLAtr := na

barsInTrade = na(entryBarIndex) ? 0 : bar_index - entryBarIndex
openPnLAtr := strategy.position_size > 0 ? (close - strategy.position_avg_price) / atrValue : 0.0
peakOpenPnLAtr := strategy.position_size > 0 ? math.max(nz(peakOpenPnLAtr, openPnLAtr), openPnLAtr) : na
profitRetraceAtr = strategy.position_size > 0 ? nz(peakOpenPnLAtr, 0.0) - openPnLAtr : 0.0

hardStop = strategy.position_size > 0 ? strategy.position_avg_price - atrValue * stopAtrMult : na
trailStop = strategy.position_size > 0 ? close - atrValue * trailAtrMult : na
activeStop = strategy.position_size > 0 ? math.max(hardStop, trailStop) : na
strategy.exit("XL", from_entry="L1", stop=activeStop)
strategy.exit("XL2", from_entry="L2", stop=activeStop)
strategy.exit("XL3", from_entry="L3", stop=activeStop)

emaFailureExit = strategy.position_size > 0 and close < slowEma and rsiValue < 47
stalledLoserExit = strategy.position_size > 0 and barsInTrade >= lossBarsExit and openPnLAtr < -0.3 and close < fastEma
quickTrendLossExit = strategy.position_size > 0 and barsInTrade >= 2 and openPnLAtr <= quickLossAtr and (minusDI > plusDI or close < slowEma)
rangeWeakExit = strategy.position_size > 0 and barsInTrade >= 2 and (rangeRegime or rangeSqueezeRegime) and openPnLAtr <= rangeWeakLossAtr and close < fastEma and rsiValue < weakMomentumRsi
rangeSqueezeMomentumExit = strategy.position_size > 0 and barsInTrade >= 1 and rangeSqueezeRegime and openPnLAtr <= 0.15 and (rsiValue < weakMomentumRsi or rsiValue < rsiValue[1] or close < close[1]) and close < fastEma
compressionQuickLossExit = strategy.position_size > 0 and barsInTrade >= 2 and rangeSqueezeRegime and openPnLAtr <= rangeQuickLossAtr
deeperDrawdownExit = strategy.position_size > 0 and barsInTrade >= 3 and openPnLAtr <= deepDrawdownAtr and (close < fastEma or minusDI > plusDI)
stage1BearishExit = strategy.position_size > 0 and barsInTrade >= 2 and minusDI > plusDI and close < fastEma
stage2BearishExit = strategy.position_size > 0 and barsInTrade >= 3 and minusDI > plusDI and adx > minAdx and close < slowEma
stage3BearishExit = strategy.position_size > 0 and barsInTrade >= 1 and rangeSqueezeRegime and minusDI > plusDI and rsiValue < weakMomentumRsi and openPnLAtr < 0.5
rangeTimeWeakExit = strategy.position_size > 0 and barsInTrade >= rangeExitTimeBars and rangeSqueezeRegime and openPnLAtr < 0.35 and (rsiValue <= rsiValue[1] or adx < rangeAdxMax)
timeExit = strategy.position_size > 0 and barsInTrade >= maxBarsInTrade and openPnLAtr < 0.6
profitProtectionExit = strategy.position_size > 0 and peakOpenPnLAtr > 0.9 and profitRetraceAtr >= retraceExitAtr and close < fastEma
manualExit = emaFailureExit or stalledLoserExit or quickTrendLossExit or rangeWeakExit or rangeSqueezeMomentumExit or compressionQuickLossExit or deeperDrawdownExit or stage1BearishExit or stage2BearishExit or stage3BearishExit or rangeTimeWeakExit or timeExit or profitProtectionExit
if manualExit
    strategy.close("L1")
    strategy.close("L2")
    strategy.close("L3")

plot(fastEma, "Fast EMA", color=color.new(color.teal, 0))
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0))