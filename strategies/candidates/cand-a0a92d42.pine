//@version=5
strategy("AF Mutation QQQ 120m [anti-extension + tighter exits] [cand-a0a92d42]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0, process_orders_on_close=true)

fastLength = input.int(21, "Fast EMA", minval=2)
slowLength = input.int(55, "Slow EMA", minval=3)
rsiLength = input.int(14, "RSI Length", minval=2)
adxLen = input.int(14, "ADX Length", minval=2)
adxMin = input.float(16.0, "ADX Minimum", minval=1, step=0.5)
bbLen = input.int(20, "BB Length", minval=5)
bbMult = input.float(2.0, "BB Mult", minval=0.5, step=0.1)
kcLen = input.int(20, "KC Length", minval=5)
kcMult = input.float(1.5, "KC Mult", minval=0.5, step=0.1)
extLookback = input.int(6, "Extension Lookback", minval=2)
extAtrMult = input.float(1.2, "Max Extension ATR", minval=0.2, step=0.1)
breakoutLookback = input.int(10, "Breakout Lookback", minval=2)
atrLen = input.int(14, "ATR Length", minval=2)
stopAtrMult = input.float(2.2, "Stop ATR", minval=0.5, step=0.1)
targetAtrMult = input.float(3.6, "Target ATR", minval=0.5, step=0.1)
timeStopBars = input.int(10, "Time Stop Bars", minval=1)
lossHoldBars = input.int(4, "Loss Hold Bars", minval=1)
rsiEntryMin = input.float(53.0, "RSI Entry Min", minval=1, maxval=99, step=0.5)
rsiExitMin = input.float(47.0, "RSI Exit Min", minval=1, maxval=99, step=0.5)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLen)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
tr = ta.tr(true)
trRma = ta.rma(tr, adxLen)
plusDI = trRma == 0.0 ? 0.0 : 100.0 * ta.rma(plusDM, adxLen) / trRma
minusDI = trRma == 0.0 ? 0.0 : 100.0 * ta.rma(minusDM, adxLen) / trRma
dx = (plusDI + minusDI) == 0.0 ? 0.0 : 100.0 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adx = ta.rma(dx, adxLen)

bbBasis = ta.sma(close, bbLen)
bbDev = bbMult * ta.stdev(close, bbLen)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
kcBasis = ta.ema(close, kcLen)
kcRange = ta.ema(ta.tr(true), kcLen)
kcUpper = kcBasis + kcMult * kcRange
kcLower = kcBasis - kcMult * kcRange
inSqueeze = bbUpper < kcUpper and bbLower > kcLower
justReleased = not inSqueeze and inSqueeze[1]

recentHigh = ta.highest(high, extLookback)
extensionOk = (recentHigh - close) <= atrValue * extAtrMult
breakoutOk = close <= ta.highest(high, breakoutLookback)[1]
trendOk = fastEma > slowEma and close > slowEma
strengthOk = adx > adxMin and plusDI > minusDI
momentumOk = rsiValue > rsiEntryMin and rsiValue < 72
entrySignal = (ta.crossover(fastEma, slowEma) or (trendOk and ta.crossover(rsiValue, rsiEntryMin)) or (trendOk and justReleased and close > bbBasis)) and trendOk and strengthOk and momentumOk and extensionOk and breakoutOk

var int barsInTrade = 0
barsInTrade := strategy.position_size > 0 ? nz(barsInTrade[1]) + 1 : 0
entryPrice = strategy.position_avg_price
openPnLAtr = strategy.position_size > 0 ? (close - entryPrice) / atrValue : na

hardExit = ta.crossunder(fastEma, slowEma) or rsiValue < rsiExitMin or (adx < adxMin * 0.85 and close < fastEma)
timeLossExit = strategy.position_size > 0 and barsInTrade >= lossHoldBars and close < entryPrice and close < fastEma
maxBarsExit = strategy.position_size > 0 and barsInTrade >= timeStopBars and openPnLAtr < 0.6

if entrySignal and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    strategy.exit("L-Exit", "Long", stop=entryPrice - atrValue * stopAtrMult, limit=entryPrice + atrValue * targetAtrMult)

if hardExit or timeLossExit or maxBarsExit
    strategy.close("Long")

plot(fastEma, "Fast EMA", color=color.teal)
plot(slowEma, "Slow EMA", color=color.orange)
plot(bbBasis, "BB Basis", color=color.gray)
plotshape(entrySignal, title="Entry", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny)
plotshape(hardExit or timeLossExit or maxBarsExit, title="Exit", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny)
