//@version=5
strategy("AF Mock Candidate [cand-3c7d9856]-mut-1 [cand-67b03686]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1)

fastLength = input.int(21, "Fast EMA", minval=1)
slowLength = input.int(55, "Slow EMA", minval=2)
rsiLength = input.int(14, "RSI Length", minval=2)
atrLength = input.int(14, "ATR Length", minval=1)
trendLookback = input.int(8, "Trend Lookback", minval=1)
pullbackLookback = input.int(3, "Pullback Lookback", minval=1)
entryRsi = input.float(52.0, "Entry RSI Threshold", step=0.1)
exitRsi = input.float(46.0, "Exit RSI Threshold", step=0.1)
atrStopMult = input.float(2.2, "ATR Stop Mult", step=0.1, minval=0.1)
atrTrailMult = input.float(3.0, "ATR Trail Mult", step=0.1, minval=0.1)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

slowRising = slowEma > slowEma[trendLookback]
trendUp = fastEma > slowEma and slowRising
pullbackHappened = ta.lowest(low, pullbackLookback) <= fastEma
reclaimFast = close > fastEma and close[1] <= fastEma[1]
emaCrossLong = ta.crossover(fastEma, slowEma) and rsiValue > entryRsi
continuationLong = trendUp and pullbackHappened and reclaimFast and rsiValue > entryRsi and close > close[1]
longEntry = (emaCrossLong or continuationLong) and strategy.position_size <= 0

trendFailExit = ta.crossunder(fastEma, slowEma)
rsiExit = rsiValue < exitRsi
priceFailExit = close < slowEma and close < fastEma
longExit = trendFailExit or rsiExit or priceFailExit

if longEntry
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    stopPrice = strategy.position_avg_price - atrValue * atrStopMult
    trailOffset = atrValue * atrTrailMult
    strategy.exit("Long Risk", "Long", stop=stopPrice, trail_offset=trailOffset)

if longExit
    strategy.close("Long")

plot(fastEma, "Fast EMA", color=color.new(color.teal, 0))
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0))