//@version=5
strategy("AF Mutation TrendGate ATR Exit [cand-m1] [cand-b5e2814a]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0, process_orders_on_close=true)

fastLength = input.int(21, "Fast EMA", minval=2)
slowLength = input.int(55, "Slow EMA", minval=3)
trendLength = input.int(200, "Trend EMA", minval=20)
rsiLength = input.int(14, "RSI Length", minval=2)
atrLength = input.int(14, "ATR Length", minval=2)
dmiLength = input.int(14, "DMI Length", minval=2)
adxSmoothing = input.int(14, "ADX Smoothing", minval=2)
adxMin = input.float(18.0, "Min ADX", minval=1.0, step=0.5)
rsiEntry = input.float(53.0, "RSI Entry Min", minval=1, maxval=99, step=0.5)
rsiExit = input.float(47.0, "RSI Exit Max", minval=1, maxval=99, step=0.5)
extLookback = input.int(20, "Extension Lookback", minval=5)
extAtrMult = input.float(1.6, "Max Extension ATR", minval=0.5, step=0.1)
stopAtrMult = input.float(2.0, "Stop ATR Mult", minval=0.5, step=0.1)
trailAtrMult = input.float(2.4, "Trail ATR Mult", minval=0.5, step=0.1)
profitAtrMult = input.float(4.2, "Profit ATR Mult", minval=0.5, step=0.1)
maxBarsHold = input.int(18, "Max Bars Hold", minval=2)
cooldownBars = input.int(2, "Cooldown Bars After Exit", minval=0)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
trendEma = ta.ema(close, trendLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
tr = ta.tr(true)
trRma = ta.rma(tr, dmiLength)
plusDI = trRma == 0 ? 0 : 100 * ta.rma(plusDM, dmiLength) / trRma
minusDI = trRma == 0 ? 0 : 100 * ta.rma(minusDM, dmiLength) / trRma
dx = (plusDI + minusDI == 0) ? 0 : 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adx = ta.rma(dx, adxSmoothing)

trendUp = close > trendEma and trendEma > trendEma[1] and fastEma > slowEma and plusDI > minusDI and adx > adxMin
notTrendDown = close > trendEma * 0.995 and minusDI < plusDI * 1.15
recentRunup = close - ta.lowest(close, extLookback)
notExtended = recentRunup < atrValue * extAtrMult
entrySignal = ta.crossover(fastEma, slowEma) and rsiValue > rsiEntry
reclaimSignal = fastEma > slowEma and fastEma[1] > slowEma[1] and close > fastEma and close[1] <= fastEma[1] and rsiValue > rsiEntry + 1

var int barsInTrade = 0
var int cooldown = 0
if strategy.position_size > 0
    barsInTrade += 1
else
    barsInTrade := 0

justClosed = strategy.position_size[1] > 0 and strategy.position_size == 0
if justClosed
    cooldown := cooldownBars
else if cooldown > 0
    cooldown -= 1

longEntry = strategy.position_size == 0 and cooldown == 0 and trendUp and notTrendDown and notExtended and (entrySignal or reclaimSignal)

if longEntry
    strategy.entry("Long", strategy.long)

avgPrice = strategy.position_avg_price
stopPrice = avgPrice - atrValue * stopAtrMult
limitPrice = avgPrice + atrValue * profitAtrMult
trailOffsetTicks = math.max(1, int(math.round((atrValue * trailAtrMult) / syminfo.mintick)))
if strategy.position_size > 0
    strategy.exit("Long Exit", from_entry="Long", stop=stopPrice, limit=limitPrice, trail_offset=trailOffsetTicks)

weakTrendExit = strategy.position_size > 0 and (ta.crossunder(fastEma, slowEma) or rsiValue < rsiExit or minusDI > plusDI)
timeExit = strategy.position_size > 0 and barsInTrade >= maxBarsHold
lossAccelerationExit = strategy.position_size > 0 and close < avgPrice - atrValue * 1.2 and close < fastEma and rsiValue < 50

if weakTrendExit or timeExit or lossAccelerationExit
    strategy.close("Long")

plot(fastEma, "Fast EMA", color=color.new(color.teal, 0))
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0))
plot(trendEma, "Trend EMA", color=color.new(color.blue, 0))