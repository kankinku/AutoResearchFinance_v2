//@version=5
strategy("AF Seed 01 Mutation [freq-restore-tight-range-exit] [cand-mut-qqq120-01] [cand-89560720]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0)

fastLength = input.int(21, "Fast EMA", minval=2)
slowLength = input.int(55, "Slow EMA", minval=3)
rsiLength = input.int(14, "RSI Length", minval=2)
adxLength = input.int(14, "ADX Length", minval=2)
atrLength = input.int(14, "ATR Length", minval=2)
trendLookback = input.int(20, "Trend Slope Lookback", minval=2)
extLookback = input.int(8, "Extension Lookback", minval=2)
maxExtensionPct = input.float(3.0, "Max Short-Term Extension %", minval=0.2, step=0.1)
maxFastDistPct = input.float(2.0, "Max Distance Above Fast EMA %", minval=0.1, step=0.1)
maxEntryRsi = input.int(73, "Max RSI For Entry Stretch Filter", minval=50, maxval=95)
minRsi = input.int(50, "Min RSI For Entry", minval=1, maxval=99)
minAdx = input.float(14.0, "Min ADX For Entry", minval=1, step=0.5)
stopAtrMult = input.float(2.0, "Stop ATR Mult", minval=0.5, step=0.1)
trailAtrMult = input.float(2.2, "Trail ATR Mult", minval=0.5, step=0.1)
squeezeTrailAtrMult = input.float(1.6, "Squeeze Trail ATR Mult", minval=0.5, step=0.1)
maxBarsInTrade = input.int(18, "Max Bars In Trade", minval=1)
lossBarsExit = input.int(5, "Lose-After Bars Exit", minval=1)
retraceExitAtr = input.float(0.9, "Peak Retrace Exit ATR", minval=0.2, step=0.1)
quickLossAtr = input.float(-0.5, "Quick Loss ATR Threshold", maxval=0, step=0.05)
rangeAdxMax = input.float(18.0, "Range ADX Max", minval=5, step=0.5)
squeezeWidthPctMax = input.float(2.4, "Squeeze Width % Max", minval=0.2, step=0.1)
rangeWeakLossAtr = input.float(-0.15, "Range Weak Loss ATR", maxval=0, step=0.05)
rangeQuickLossAtr = input.float(-0.3, "Range Quick Loss ATR", maxval=0, step=0.05)
deepDrawdownAtr = input.float(-0.8, "Deep Drawdown ATR Exit", maxval=0, step=0.05)
weakMomentumRsi = input.int(50, "Weak Momentum RSI Exit", minval=1, maxval=99)
exhaustionLen = input.int(4, "Exhaustion Sequence Length", minval=2, maxval=9)
reclaimLookback = input.int(3, "Pullback Reclaim Lookback", minval=1, maxval=8)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
trur = ta.rma(ta.tr(true), adxLength)
plusDI = trur == 0.0 ? 0.0 : 100.0 * ta.rma(plusDM, adxLength) / trur
minusDI = trur == 0.0 ? 0.0 : 100.0 * ta.rma(minusDM, adxLength) / trur
dx = (plusDI + minusDI == 0.0) ? 0.0 : 100.0 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adx = ta.rma(dx, adxLength)

slowSlopeUp = slowEma > slowEma[trendLookback]
trendDownRegime = fastEma < slowEma and slowEma < slowEma[trendLookback] and minusDI > plusDI
shortTermExtensionPct = ((close / ta.lowest(close, extLookback)) - 1.0) * 100.0
fastDistPct = fastEma == 0.0 ? 0.0 : ((close / fastEma) - 1.0) * 100.0
bandBasis = ta.sma(close, 20)
bandDev = ta.stdev(close, 20)
bandUpper = bandBasis + bandDev * 2.0
bandLower = bandBasis - bandDev * 2.0
bandWidthPct = bandBasis == 0.0 ? 0.0 : ((bandUpper - bandLower) / bandBasis) * 100.0
rangeRegime = adx < rangeAdxMax and math.abs(fastEma - slowEma) / close < 0.012
rangeSqueezeRegime = rangeRegime and bandWidthPct < squeezeWidthPctMax
notLateExtension = shortTermExtensionPct < maxExtensionPct and fastDistPct < maxFastDistPct and rsiValue < maxEntryRsi
trendQualified = fastEma > slowEma and slowSlopeUp and adx > minAdx and plusDI > minusDI

exhaustionDown = close < close[1] and close[1] < close[2] and close[2] < close[3]
exhaustionMild = ta.barssince(close < close[1]) <= exhaustionLen and ta.lowestbars(low, exhaustionLen + 1) <= 1
baseCross = ta.crossover(fastEma, slowEma)
pullbackTouch = ta.lowest(low, reclaimLookback) <= fastEma
pullbackReclaim = pullbackTouch and close > fastEma and close > close[1] and close[1] <= fastEma[1]
freshBreakout = close > ta.highest(high[1], 3) and close > fastEma and fastEma > slowEma
momentumOk = rsiValue > minRsi and (rsiValue > rsiValue[1] or close > high[1])
confirmationOk = close > open and close >= hl2 and (plusDI >= minusDI or adx > minAdx)
exhaustionQualifier = exhaustionDown or exhaustionMild or pullbackTouch
longEntry = (baseCross or pullbackReclaim or freshBreakout) and exhaustionQualifier and momentumOk and confirmationOk and trendQualified and not trendDownRegime and notLateExtension

var int entryBarIndex = na
var float peakOpenPnLAtr = na
var bool entryRangeSqueeze = false
var bool entryRangeRegime = false
var int bearishExitStage = 0

if longEntry and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0 and strategy.position_size[1] <= 0
    entryBarIndex := bar_index
    peakOpenPnLAtr := 0.0
    entryRangeSqueeze := rangeSqueezeRegime
    entryRangeRegime := rangeRegime
    bearishExitStage := 0
if strategy.position_size <= 0
    entryBarIndex := na
    peakOpenPnLAtr := na
    entryRangeSqueeze := false
    entryRangeRegime := false
    bearishExitStage := 0

barsInTrade = na(entryBarIndex) ? 0 : bar_index - entryBarIndex
avgPrice = strategy.position_avg_price
openPnLAtr = strategy.position_size > 0 ? (close - avgPrice) / atrValue : 0.0
peakOpenPnLAtr := strategy.position_size > 0 ? math.max(nz(peakOpenPnLAtr, openPnLAtr), openPnLAtr) : na
profitRetraceAtr = strategy.position_size > 0 ? nz(peakOpenPnLAtr, 0.0) - openPnLAtr : 0.0

activeTrailMult = (rangeSqueezeRegime or entryRangeSqueeze) ? squeezeTrailAtrMult : trailAtrMult
hardStop = strategy.position_size > 0 ? avgPrice - atrValue * stopAtrMult : na
trailStop = strategy.position_size > 0 ? close - atrValue * activeTrailMult : na
activeStop = strategy.position_size > 0 ? math.max(hardStop, trailStop) : na
strategy.exit("XL", "Long", stop=activeStop)

bearishWarning = strategy.position_size > 0 and ((close < fastEma and rsiValue < 50) or (minusDI > plusDI and rsiValue < rsiValue[1]))
if bearishWarning and bearishExitStage < 2
    bearishExitStage += 1
if strategy.position_size > 0 and close > fastEma and plusDI >= minusDI and rsiValue >= rsiValue[1]
    bearishExitStage := math.max(bearishExitStage - 1, 0)

emaFailureExit = strategy.position_size > 0 and close < slowEma and rsiValue < 47
stalledLoserExit = strategy.position_size > 0 and barsInTrade >= lossBarsExit and openPnLAtr < -0.25 and close < fastEma
quickTrendLossExit = strategy.position_size > 0 and barsInTrade >= 2 and openPnLAtr <= quickLossAtr and (minusDI > plusDI or close < slowEma)
rangeWeakExit = strategy.position_size > 0 and barsInTrade >= 1 and (rangeRegime or rangeSqueezeRegime or entryRangeRegime) and openPnLAtr <= rangeWeakLossAtr and close < fastEma and rsiValue < weakMomentumRsi
rangeSqueezeMomentumExit = strategy.position_size > 0 and barsInTrade >= 1 and (rangeSqueezeRegime or entryRangeSqueeze) and openPnLAtr <= 0.1 and (rsiValue < weakMomentumRsi or rsiValue < rsiValue[1] or close < close[1]) and close < fastEma
compressionQuickLossExit = strategy.position_size > 0 and barsInTrade >= 1 and (rangeSqueezeRegime or entryRangeSqueeze) and openPnLAtr <= rangeQuickLossAtr
deeperDrawdownExit = strategy.position_size > 0 and barsInTrade >= 3 and openPnLAtr <= deepDrawdownAtr and (close < fastEma or minusDI > plusDI)
timeExit = strategy.position_size > 0 and barsInTrade >= maxBarsInTrade and openPnLAtr < 0.6
trendReversalExit = strategy.position_size > 0 and bearishExitStage >= 2 and minusDI > plusDI and close < fastEma
profitProtectionExit = strategy.position_size > 0 and peakOpenPnLAtr > 0.8 and profitRetraceAtr >= retraceExitAtr and close < fastEma
manualExit = emaFailureExit or stalledLoserExit or quickTrendLossExit or rangeWeakExit or rangeSqueezeMomentumExit or compressionQuickLossExit or deeperDrawdownExit or timeExit or trendReversalExit or profitProtectionExit
if manualExit
    strategy.close("Long")

plot(fastEma, "Fast EMA", color=color.new(color.teal, 0))
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0))