//@version=5
strategy("AF Mock Candidate [cand-3c7d9856]-mut-01 [cand-09a7f952]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0, process_orders_on_close=true)

fastLength = input.int(18, "Fast EMA", minval=2)
slowLength = input.int(50, "Slow EMA", minval=3)
rsiLength = input.int(14, "RSI Length", minval=2)
adxLen = input.int(14, "ADX Length", minval=3)
adxThreshold = input.float(16.0, "ADX Threshold", minval=5.0, step=0.5)
diSpreadMin = input.float(1.5, "Min +DI over -DI", minval=0.0, step=0.1)
atrLen = input.int(14, "ATR Length", minval=2)
stopAtrMult = input.float(2.0, "Initial Stop ATR Mult", minval=0.5, step=0.1)
trailAtrMult = input.float(2.6, "Trail ATR Mult", minval=0.5, step=0.1)
beTriggerAtr = input.float(1.0, "Break-even Trigger ATR", minval=0.2, step=0.1)
maxBarsInTrade = input.int(26, "Max Bars In Trade", minval=4)
extLookback = input.int(6, "Extension Lookback", minval=2)
extAtrCap = input.float(1.35, "Max Extension over recent low in ATR", minval=0.2, step=0.05)
emaStretchCap = input.float(1.25, "Max Close over Fast EMA in ATR", minval=0.1, step=0.05)
cooldownAfterBurst = input.int(3, "Cooldown Bars After Burst", minval=0)
profitRsiExit = input.float(57.0, "Profit Fade RSI Exit", minval=40.0, maxval=80.0, step=0.5)
entryRsiMin = input.float(53.0, "Entry RSI Min", minval=40.0, maxval=70.0, step=0.5)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atr = ta.atr(atrLen)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
tr = ta.tr(true)
trRma = ta.rma(tr, adxLen)
plusDI = trRma == 0.0 ? 0.0 : 100.0 * ta.rma(plusDM, adxLen) / trRma
minusDI = trRma == 0.0 ? 0.0 : 100.0 * ta.rma(minusDM, adxLen) / trRma
dx = (plusDI + minusDI) == 0.0 ? 0.0 : 100.0 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adx = ta.rma(dx, adxLen)

trendUp = fastEma > slowEma and slowEma > slowEma[1]
trendStrength = adx > adxThreshold and plusDI > minusDI + diSpreadMin
recentLow = ta.lowest(low, extLookback)
shortWindowExtension = atr == 0.0 ? 0.0 : (close - recentLow) / atr
emaStretch = atr == 0.0 ? 0.0 : (close - fastEma) / atr
burstUp = shortWindowExtension > extAtrCap * 1.15 and close > open
barsSinceBurst = ta.barssince(burstUp)
lateEntryBlocked = shortWindowExtension > extAtrCap or emaStretch > emaStretchCap or (barsSinceBurst >= 0 and barsSinceBurst < cooldownAfterBurst)

entrySignal = ta.crossover(fastEma, slowEma) or (trendUp and close > fastEma and close[1] <= fastEma[1])
longEntry = entrySignal and rsiValue > entryRsiMin and trendStrength and not lateEntryBlocked

var int entryBarIndex = na
var float highestSinceEntry = na
var float stopPrice = na
var float trailStop = na
var float beStop = na

if strategy.position_size <= 0
    highestSinceEntry := na
    stopPrice := na
    trailStop := na
    beStop := na
    entryBarIndex := na

if longEntry and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    entryBarIndex := na(entryBarIndex) ? bar_index : entryBarIndex
    highestSinceEntry := na(highestSinceEntry) ? high : math.max(highestSinceEntry, high)
    baseStop = strategy.position_avg_price - atr * stopAtrMult
    profitAtr = atr == 0.0 ? 0.0 : (close - strategy.position_avg_price) / atr
    beStop := profitAtr >= beTriggerAtr ? strategy.position_avg_price : na
    trailStop := highestSinceEntry - atr * trailAtrMult
    stopPrice := math.max(baseStop, na(beStop) ? baseStop : beStop, trailStop)
    strategy.exit("XL", "Long", stop=stopPrice)

barsInTrade = strategy.position_size > 0 and not na(entryBarIndex) ? bar_index - entryBarIndex : 0
momentumFade = strategy.position_size > 0 and rsiValue < profitRsiExit and close < fastEma and close < close[1]
timeStop = strategy.position_size > 0 and barsInTrade >= maxBarsInTrade and close < close[1]
trendFailure = strategy.position_size > 0 and (fastEma < slowEma or plusDI < minusDI)

if momentumFade or timeStop or trendFailure
    strategy.close("Long")

plot(fastEma, color=color.new(color.teal, 0), title="Fast EMA")
plot(slowEma, color=color.new(color.orange, 0), title="Slow EMA")
plot(strategy.position_size > 0 ? stopPrice : na, color=color.new(color.red, 0), title="Active Stop", style=plot.style_linebr)
plotchar(longEntry, title="Long Entry", char="▲", location=location.belowbar, color=color.new(color.green, 0), size=size.tiny)
plotchar(lateEntryBlocked and trendUp, title="Late Entry Blocked", char="×", location=location.abovebar, color=color.new(color.red, 0), size=size.tiny)
