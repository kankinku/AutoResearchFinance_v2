//@version=5
strategy("AF Mock Candidate [cand-mut-extension-guard-exit-tighten] [cand-09b44c3a] [cand-4b571efe]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0)

fastLength = input.int(21, "Fast EMA", minval=2)
slowLength = input.int(55, "Slow EMA", minval=3)
rsiLength = input.int(14, "RSI Length", minval=2)
adxLength = input.int(14, "ADX Length", minval=2)
atrLength = input.int(14, "ATR Length", minval=2)
trendLookback = input.int(20, "Trend Slope Lookback", minval=2)
extLookback = input.int(8, "Extension Lookback", minval=2)
maxExtensionPct = input.float(2.6, "Max Short-Term Extension %", minval=0.2, step=0.1)
maxRocPct = input.float(1.9, "Max Short ROC %", minval=0.2, step=0.1)
maxStretchAtr = input.float(1.6, "Max Close Above Fast EMA In ATR", minval=0.2, step=0.1)
minRsi = input.int(52, "Min RSI For Entry", minval=1, maxval=99)
minAdx = input.float(16.0, "Min ADX For Entry", minval=1, step=0.5)
stopAtrMult = input.float(2.1, "Stop ATR Mult", minval=0.5, step=0.1)
trailAtrMult = input.float(2.5, "Trail ATR Mult", minval=0.5, step=0.1)
breakevenTriggerAtr = input.float(1.0, "Breakeven Trigger ATR", minval=0.2, step=0.1)
breakevenOffsetAtr = input.float(0.15, "Breakeven Offset ATR", minval=0.0, step=0.05)
maxBarsInTrade = input.int(18, "Max Bars In Trade", minval=1)
lossBarsExit = input.int(5, "Lose-After Bars Exit", minval=1)
trendFailBars = input.int(3, "Trend Fail Bars", minval=1)
atrCompressionLookback = input.int(30, "ATR Compression Lookback", minval=5)
minAtrRatio = input.float(0.82, "Min ATR / ATR Avg Ratio", minval=0.3, step=0.01)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)
atrBase = ta.sma(atrValue, atrCompressionLookback)
atrRatio = atrBase == 0.0 ? 0.0 : atrValue / atrBase

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
trur = ta.rma(ta.tr(true), adxLength)
plusDI = trur == 0.0 ? 0.0 : 100.0 * ta.rma(plusDM, adxLength) / trur
minusDI = trur == 0.0 ? 0.0 : 100.0 * ta.rma(minusDM, adxLength) / trur
dx = (plusDI + minusDI == 0.0) ? 0.0 : 100.0 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adx = ta.rma(dx, adxLength)

slowSlopeUp = slowEma > slowEma[trendLookback]
trendDownRegime = fastEma < slowEma and slowEma < slowEma[trendLookback] and minusDI > plusDI
shortTermExtensionPct = ((close / ta.lowest(close, extLookback)) - 1.0) * 100.0
shortRocPct = math.abs(ta.roc(close, math.max(2, math.floor(extLookback * 0.5))))
stretchAtr = atrValue == 0.0 ? 0.0 : (close - fastEma) / atrValue
notLateExtension = shortTermExtensionPct < maxExtensionPct and shortRocPct < maxRocPct and stretchAtr < maxStretchAtr
trendQualified = fastEma > slowEma and slowSlopeUp and adx > minAdx and plusDI > minusDI
volatilityQualified = atrRatio > minAtrRatio

baseCross = ta.crossover(fastEma, slowEma)
pullbackContinuation = close > fastEma and close[1] <= fastEma[1] and fastEma > slowEma
reclaimContinuation = close > fastEma and low < fastEma and close > open and close > close[1] and fastEma > slowEma
longEntry = (baseCross or pullbackContinuation or reclaimContinuation) and rsiValue > minRsi and trendQualified and volatilityQualified and not trendDownRegime and notLateExtension

var int entryBarIndex = na
var float highestSinceEntry = na
var int belowFastCount = 0

if longEntry and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0 and strategy.position_size[1] <= 0
    entryBarIndex := bar_index
    highestSinceEntry := high
    belowFastCount := 0
else if strategy.position_size > 0
    highestSinceEntry := na(highestSinceEntry) ? high : math.max(highestSinceEntry, high)
    belowFastCount := close < fastEma ? belowFastCount + 1 : 0
else
    entryBarIndex := na
    highestSinceEntry := na
    belowFastCount := 0

barsInTrade = na(entryBarIndex) ? 0 : bar_index - entryBarIndex
avgPrice = strategy.position_avg_price
openPnLAtr = strategy.position_size > 0 and atrValue != 0.0 ? (close - avgPrice) / atrValue : 0.0
maxOpenPnLAtr = strategy.position_size > 0 and atrValue != 0.0 and not na(highestSinceEntry) ? (highestSinceEntry - avgPrice) / atrValue : 0.0
hardStop = strategy.position_size > 0 ? avgPrice - atrValue * stopAtrMult : na
trailStop = strategy.position_size > 0 and not na(highestSinceEntry) ? highestSinceEntry - atrValue * trailAtrMult : na
breakevenStop = strategy.position_size > 0 and maxOpenPnLAtr >= breakevenTriggerAtr ? avgPrice + atrValue * breakevenOffsetAtr : na
activeStop = strategy.position_size > 0 ? math.max(hardStop, math.max(nz(trailStop, hardStop), nz(breakevenStop, hardStop))) : na
strategy.exit("XL", "Long", stop=activeStop)

emaFailureExit = strategy.position_size > 0 and close < slowEma and rsiValue < 47
stalledLoserExit = strategy.position_size > 0 and barsInTrade >= lossBarsExit and openPnLAtr < -0.25 and close < fastEma
trendReversalExit = strategy.position_size > 0 and minusDI > plusDI and adx > minAdx and close < fastEma
squeezeFailureExit = strategy.position_size > 0 and atrRatio < minAtrRatio * 0.95 and barsInTrade >= 3 and openPnLAtr < 0.2
trendStallExit = strategy.position_size > 0 and belowFastCount >= trendFailBars and openPnLAtr < 0.4
givebackExit = strategy.position_size > 0 and maxOpenPnLAtr > 1.2 and openPnLAtr < maxOpenPnLAtr * 0.35 and close < fastEma
lateTimeExit = strategy.position_size > 0 and barsInTrade >= maxBarsInTrade and openPnLAtr < 0.8
manualExit = emaFailureExit or stalledLoserExit or trendReversalExit or squeezeFailureExit or trendStallExit or givebackExit or lateTimeExit
if manualExit
    strategy.close("Long")

plot(fastEma, "Fast EMA", color=color.new(color.teal, 0))
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0))