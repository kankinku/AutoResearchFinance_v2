//@version=5
strategy("AF Mutation Trend Pullback Recovery [cand-mut-restore-trades] [cand-22a11bad]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0, process_orders_on_close=true)

fastLength = input.int(20, "Fast EMA", minval=2)
slowLength = input.int(50, "Slow EMA", minval=3)
trendLength = input.int(200, "Trend EMA", minval=20)
rsiLength = input.int(14, "RSI Length", minval=2)
rsiPullback = input.int(46, "RSI Pullback Threshold", minval=5, maxval=70)
rsiRecovery = input.int(52, "RSI Recovery Threshold", minval=5, maxval=80)
atrLength = input.int(14, "ATR Length", minval=2)
stopAtrMult = input.float(2.2, "Stop ATR Mult", minval=0.5, step=0.1)
targetAtrMult = input.float(4.0, "Target ATR Mult", minval=0.5, step=0.1)
trailAtrMult = input.float(2.8, "Trail ATR Mult", minval=0.5, step=0.1)
minAtrPct = input.float(0.35, "Min ATR % of Price", minval=0.05, step=0.05)
cooldownBars = input.int(3, "Cooldown Bars After Exit", minval=0, maxval=50)
maxBarsInTrade = input.int(30, "Max Bars In Trade", minval=1, maxval=200)
useTrendFilter = input.bool(true, "Use Trend Filter")
useTimeExit = input.bool(true, "Use Time Exit")

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
trendEma = ta.ema(close, trendLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)
atrPct = atrValue / close * 100.0

fastSlopeUp = fastEma > fastEma[1]
slowSlopeUp = slowEma > slowEma[1]
trendUp = close > trendEma and fastEma > slowEma and slowEma > trendEma and fastSlopeUp and slowSlopeUp
trendPass = useTrendFilter ? trendUp : fastEma > slowEma

pullbackContext = low <= fastEma or close < fastEma
rsiRecovered = ta.crossover(rsiValue, rsiRecovery)
recentlyPulledBack = ta.lowest(rsiValue, 4) <= rsiPullback
volatilityPass = atrPct >= minAtrPct
priceStrength = close > open or close > close[1]

var int barsSinceExit = 1000
var int barsInTrade = 0
barsSinceExit := strategy.position_size == 0 ? barsSinceExit + 1 : 0
barsInTrade := strategy.position_size > 0 ? barsInTrade + 1 : 0

cooldownPass = barsSinceExit > cooldownBars
longEntry = trendPass and pullbackContext and recentlyPulledBack and rsiRecovered and volatilityPass and priceStrength and cooldownPass and strategy.position_size == 0

if longEntry
    strategy.entry("Long", strategy.long)

var float highSinceEntry = na
if strategy.position_size > 0
    highSinceEntry := na(highSinceEntry) ? high : math.max(highSinceEntry, high)
else
    highSinceEntry := na

avgPrice = strategy.position_avg_price
stopPrice = avgPrice - atrValue * stopAtrMult
limitPrice = avgPrice + atrValue * targetAtrMult
trailStopPrice = na(highSinceEntry) ? na : highSinceEntry - atrValue * trailAtrMult
finalStop = na(trailStopPrice) ? stopPrice : math.max(stopPrice, trailStopPrice)

if strategy.position_size > 0
    strategy.exit("Long Exit", "Long", stop=finalStop, limit=limitPrice)

trendFailureExit = strategy.position_size > 0 and (close < slowEma or rsiValue < 45)
timeExit = strategy.position_size > 0 and useTimeExit and barsInTrade >= maxBarsInTrade

if trendFailureExit or timeExit
    strategy.close("Long")

plot(fastEma, "Fast EMA", color=color.new(color.teal, 0), linewidth=2)
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0), linewidth=2)
plot(trendEma, "Trend EMA", color=color.new(color.blue, 30), linewidth=2)
plotshape(longEntry, title="Long Entry", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny, text="L")