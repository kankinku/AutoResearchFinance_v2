//@version=5
strategy("AF Mutation RangeSqueeze Repair 01 [cand-900e9e70]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0, process_orders_on_close=true)

fastLength = input.int(21, "Fast EMA", minval=2)
slowLength = input.int(55, "Slow EMA", minval=3)
rsiLength = input.int(14, "RSI Length", minval=2)
adxLength = input.int(14, "ADX Length", minval=2)
atrLength = input.int(14, "ATR Length", minval=2)
bbLength = input.int(20, "BB Length", minval=5)
bbMult = input.float(2.0, "BB Mult", minval=0.5, step=0.1)
minAdx = input.float(17.0, "Min ADX", minval=5, step=0.5)
entryRsiMin = input.float(53.0, "Entry RSI Min", minval=40, maxval=80, step=0.5)
exitRsiMin = input.float(47.0, "Exit RSI Weakness", minval=20, maxval=70, step=0.5)
maxAtrExtension = input.float(1.35, "Max Close Above Fast EMA in ATR", minval=0.2, step=0.05)
maxSlowAtrExtension = input.float(2.2, "Max Close Above Slow EMA in ATR", minval=0.5, step=0.1)
maxBarsInTrade = input.int(24, "Max Bars In Trade", minval=2)
stopAtrMult = input.float(1.75, "Stop ATR Mult", minval=0.5, step=0.05)
trailAtrMult = input.float(2.4, "Trail ATR Mult", minval=0.5, step=0.05)
profitAtrMult = input.float(3.2, "Profit ATR Mult", minval=0.5, step=0.1)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

basis = ta.sma(close, bbLength)
dev = bbMult * ta.stdev(close, bbLength)
bbUpper = basis + dev
bbLower = basis - dev
bbWidthPct = basis != 0 ? (bbUpper - bbLower) / basis * 100.0 : 0.0
bbWidthMa = ta.sma(bbWidthPct, 10)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
trur = ta.rma(ta.tr(true), adxLength)
plusDI = trur != 0 ? 100 * ta.rma(plusDM, adxLength) / trur : 0.0
minusDI = trur != 0 ? 100 * ta.rma(minusDM, adxLength) / trur : 0.0
dx = (plusDI + minusDI) != 0 ? 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI) : 0.0
adx = ta.rma(dx, adxLength)

trendUp = fastEma > slowEma
trendStrength = adx > minAdx and plusDI > minusDI
emaSlopeOk = fastEma > fastEma[1] and slowEma >= slowEma[1]
notOverextendedFast = atrValue > 0 ? ((close - fastEma) / atrValue) < maxAtrExtension : true
notOverextendedSlow = atrValue > 0 ? ((close - slowEma) / atrValue) < maxSlowAtrExtension : true
pullbackRecently = ta.lowest((close - fastEma) / atrValue, 4) < 0.35
noSqueezeChase = bbWidthPct > bbWidthMa * 0.9
momentumOk = rsiValue > entryRsiMin and rsiValue < 70
priceConfirmation = close > fastEma and close > close[1]
entrySignal = trendUp and trendStrength and emaSlopeOk and momentumOk and notOverextendedFast and notOverextendedSlow and pullbackRecently and noSqueezeChase and priceConfirmation

if entrySignal and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

var int entryBarIndex = na
if strategy.position_size > 0 and strategy.position_size[1] <= 0
    entryBarIndex := bar_index
if strategy.position_size <= 0
    entryBarIndex := na

barsInTrade = strategy.position_size > 0 and not na(entryBarIndex) ? bar_index - entryBarIndex : 0
avgPrice = strategy.position_avg_price
hardStop = strategy.position_size > 0 ? avgPrice - atrValue * stopAtrMult : na
profitTarget = strategy.position_size > 0 ? avgPrice + atrValue * profitAtrMult : na
trailStop = strategy.position_size > 0 ? ta.highest(high, math.min(barsInTrade + 1, maxBarsInTrade + 1)) - atrValue * trailAtrMult : na
activeStop = strategy.position_size > 0 ? math.max(hardStop, trailStop) : na

strategy.exit("Long Exit", from_entry="Long", stop=activeStop, limit=profitTarget)

weakMomentumExit = strategy.position_size > 0 and (rsiValue < exitRsiMin or (adx < minAdx and close < fastEma))
trendFailureExit = strategy.position_size > 0 and (close < slowEma or plusDI < minusDI)
timeExit = strategy.position_size > 0 and barsInTrade >= maxBarsInTrade
extensionFailureExit = strategy.position_size > 0 and close < fastEma and close[1] > fastEma[1] and rsiValue < 50

if weakMomentumExit or trendFailureExit or timeExit or extensionFailureExit
    strategy.close("Long")

plot(fastEma, "Fast EMA", color=color.new(color.teal, 0), linewidth=2)
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0), linewidth=2)
plot(strategy.position_size > 0 ? activeStop : na, "Active Stop", color=color.new(color.red, 0), style=plot.style_linebr)
plot(strategy.position_size > 0 ? profitTarget : na, "Profit Target", color=color.new(color.green, 0), style=plot.style_linebr)
plotshape(entrySignal and strategy.position_size <= 0, title="Entry", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny)
