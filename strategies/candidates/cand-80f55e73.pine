//@version=5
strategy("AF Seed 01 - Broad Time Boxed Event Rotation [cand-80f55e73]", overlay=true, pyramiding=30, process_orders_on_close=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=5, commission_type=strategy.commission.percent, commission_value=0.05)

groupSig = "1. Exhaustion"
L1 = input.int(9, "L1", minval=2, group=groupSig)
L2 = input.int(12, "L2", minval=3, group=groupSig)
L3 = input.int(14, "L3", minval=4, group=groupSig)
confirmBars = input.int(2, "confirmBars", minval=1, maxval=5, group=groupSig)

groupFilter = "2. Filters"
emaLen = input.int(21, "emaLen", minval=1, group=groupFilter)
baseEmaLen = input.int(55, "baseEmaLen", minval=1, group=groupFilter)
rsiLen = input.int(14, "rsiLen", minval=2, group=groupFilter)
maxExtPct = input.float(6.0, "maxExtPct", minval=1.0, step=0.5, group=groupFilter)
riskOffRsi = input.float(45.0, "riskOffRsi", minval=5.0, maxval=95.0, step=0.5, group=groupFilter)

groupPos = "3. Slot Management"
slotPct = input.float(5.0, "slotPct", minval=0.1, maxval=100.0, step=0.5, group=groupPos)
maxSlots = input.int(8, "maxSlots", minval=1, maxval=50, group=groupPos)
useReplacement = input.bool(true, "useReplacement", group=groupPos)
replaceMinRank = input.int(2, "replaceMinRank", minval=1, maxval=4, group=groupPos)
replaceIfPnlBelow = input.float(-0.5, "replaceIfPnlBelow", step=0.5, group=groupPos)
applyFilterToB1 = input.bool(false, "applyFilterToB1", group=groupPos)
minQty = input.float(1.0, "minQty", minval=0.000001, step=0.1, group=groupPos)

groupExit = "4. Exits"
closeAllOnBearConfRiskOff = input.bool(true, "closeAllOnBearConfRiskOff", group=groupExit)

groupExec = "5. Execution"
sameBarConflictMode = input.string("StrongWins", "sameBarConflictMode", options=["StrongWins", "SkipBoth", "BearPriority"], group=groupExec)
trendMode = input.string("Loose", "trendMode", options=["Strict", "Balanced", "Loose"], group=groupExec)
allowStrongCounterTrend = input.bool(true, "allowStrongCounterTrend", group=groupExec)
entryCooldownBars = input.int(0, "entryCooldownBars", minval=0, maxval=20, group=groupExec)
useRealFillSync = input.bool(true, "useRealFillSync", group=groupExec)
resetOnL3 = input.bool(false, "resetOnL3", group=groupExec)

groupST = "6. Supertrend"
useSupertrendFilter = input.bool(false, "useSupertrendFilter", group=groupST)
supertrendAtrPeriod = input.int(10, "supertrendAtrPeriod", minval=1, group=groupST)
supertrendFactor = input.float(3.0, "supertrendFactor", minval=0.1, step=0.1, group=groupST)
supertrendBlocksWeakBull = input.bool(false, "supertrendBlocksWeakBull", group=groupST)
supertrendRiskOffEnabled = input.bool(true, "supertrendRiskOffEnabled", group=groupST)

groupWeak = "7. Weak Range Exit"
enableWeakRangeExit = input.bool(true, "enableWeakRangeExit", group=groupWeak)
weakExitAtrLen = input.int(14, "weakExitAtrLen", minval=1, group=groupWeak)
weakExitBars = input.int(4, "weakExitBars", minval=1, group=groupWeak)
weakRunupAtrMax = input.float(1.4, "weakRunupAtrMax", minval=0.1, step=0.1, group=groupWeak)
weakLossAtrMin = input.float(-0.8, "weakLossAtrMin", step=0.1, group=groupWeak)
weakSlopeAtrMax = input.float(0.20, "weakSlopeAtrMax", minval=0.0, step=0.05, group=groupWeak)

groupView = "8. View"
showEMAs = input.bool(true, "showEMAs", group=groupView)
showSignals = input.bool(true, "showSignals", group=groupView)
showConfMark = input.bool(true, "showConfMark", group=groupView)

L2 := math.max(L2, L1 + 1)
L3 := math.max(L3, L2 + 1)

ema = ta.ema(close, emaLen)
baseEMA = ta.ema(close, baseEmaLen)
rsi = ta.rsi(close, rsiLen)
atrWeak = ta.atr(weakExitAtrLen)
atrSt = ta.atr(supertrendAtrPeriod)

emaUp = not na(ema[1]) and ema >= ema[1]
emaDown = not na(ema[1]) and ema <= ema[1]
riskOffBase = close < baseEMA and rsi < riskOffRsi and emaDown

hl2 = (high + low) * 0.5
upperBand = hl2 + supertrendFactor * atrSt
lowerBand = hl2 - supertrendFactor * atrSt
var float stUpper = na
var float stLower = na
var int stDir = 1
stUpper := na(stUpper[1]) ? upperBand : (close[1] > stUpper[1] ? math.max(upperBand, stUpper[1]) : upperBand)
stLower := na(stLower[1]) ? lowerBand : (close[1] < stLower[1] ? math.min(lowerBand, stLower[1]) : lowerBand)
stDir := na(stDir[1]) ? 1 : stDir[1]
if stDir == -1 and close > stUpper[1]
    stDir := 1
else if stDir == 1 and close < stLower[1]
    stDir := -1
stLine = stDir == 1 ? stLower : stUpper
superBull = stDir == 1
superBear = stDir == -1
riskOff = riskOffBase or (supertrendRiskOffEnabled and useSupertrendFilter and superBear and close < stLine)

var int cycle = 0
var int bull = 0
var int bear = 0

has4 = bar_index >= 4 and not na(close[4])
has2 = bar_index >= 2 and not na(close[2])

f_reset() =>
    int nb = 0
    int ns = 0
    int nc = 0
    if has4
        if close < close[4]
            nb := 1
            nc := 1
        else if close > close[4]
            ns := 1
            nc := 1
    [nb, ns, nc]

if not has4
    bull := 0
    bear := 0
    cycle := 0
else
    if cycle < L1
        if close < close[4]
            bull := bull + 1
            bear := 0
            cycle := bull
        else if close > close[4]
            bear := bear + 1
            bull := 0
            cycle := bear
        else
            [nb, ns, nc] = f_reset()
            bull := nb
            bear := ns
            cycle := nc
    else
        if bull > 0
            if has2 and close < close[2]
                bull := bull + 1
                cycle := bull
            else
                [nb, ns, nc] = f_reset()
                bull := nb
                bear := ns
                cycle := nc
        else if bear > 0
            if has2 and close > close[2]
                bear := bear + 1
                cycle := bear
            else
                [nb, ns, nc] = f_reset()
                bull := nb
                bear := ns
                cycle := nc
        else
            [nb, ns, nc] = f_reset()
            bull := nb
            bear := ns
            cycle := nc

bullL1 = bull == L1
bullL2 = bull == L2
bullL3 = bull == L3
bearL1 = bear == L1
bearL2 = bear == L2
bearL3 = bear == L3

bullCandidate = bullL2
bearCandidate = bearL2
bullStrong = bullL3
bearStrong = bearL3

var int bullSignalBar = na
var int bearSignalBar = na
if bullCandidate or bullStrong
    bullSignalBar := bar_index
if bearCandidate or bearStrong
    bearSignalBar := bar_index

bullConfirmed = not na(bullSignalBar) and bar_index > bullSignalBar and (bar_index - bullSignalBar <= confirmBars) and close > high[1]
bearConfirmed = not na(bearSignalBar) and bar_index > bearSignalBar and (bar_index - bearSignalBar <= confirmBars) and close < low[1]

if bullConfirmed or (not na(bullSignalBar) and bar_index - bullSignalBar > confirmBars)
    bullSignalBar := na
if bearConfirmed or (not na(bearSignalBar) and bar_index - bearSignalBar > confirmBars)
    bearSignalBar := na

newBullL1 = bullL1 and not nz(bullL1[1], false)
newBullCandidate = bullCandidate and not nz(bullCandidate[1], false)
newBullStrong = bullStrong and not nz(bullStrong[1], false)
newBullConfirmed = bullConfirmed and not nz(bullConfirmed[1], false)
newBearL1 = bearL1 and not nz(bearL1[1], false)
newBearCandidate = bearCandidate and not nz(bearCandidate[1], false)
newBearStrong = bearStrong and not nz(bearStrong[1], false)
newBearConfirmed = bearConfirmed and not nz(bearConfirmed[1], false)

bullEventRaw = newBullConfirmed ? 4 : newBullStrong ? 3 : newBullCandidate ? 2 : newBullL1 ? 1 : 0
bearEventRaw = newBearConfirmed ? 4 : newBearStrong ? 3 : newBearCandidate ? 2 : newBearL1 ? 1 : 0

f_resolve_conflict(int bullEv, int bearEv) =>
    int resolvedBull = 0
    int resolvedBear = 0
    if bullEv > 0 and bearEv > 0
        if sameBarConflictMode == "BearPriority"
            resolvedBear := bearEv
        else if sameBarConflictMode == "SkipBoth"
            resolvedBull := 0
            resolvedBear := 0
        else
            if bullEv > bearEv
                resolvedBull := bullEv
            else if bearEv > bullEv
                resolvedBear := bearEv
            else
                if close >= ema
                    resolvedBull := bullEv
                else
                    resolvedBear := bearEv
    else
        resolvedBull := bullEv
        resolvedBear := bearEv
    [resolvedBull, resolvedBear]

[finalBullEvent, finalBearEvent] = f_resolve_conflict(bullEventRaw, bearEventRaw)
allowBear = finalBearEvent > 0

lightTrendPass = false
if trendMode == "Strict"
    lightTrendPass := close >= ema and emaUp
else if trendMode == "Balanced"
    lightTrendPass := close >= ema or emaUp
else
    lightTrendPass := close >= ema or close > open

supertrendPass = not useSupertrendFilter or superBull or (not supertrendBlocksWeakBull)
bullRiskAllowed = not riskOff or (allowStrongCounterTrend and finalBullEvent >= 3)

var int lastBullAnchorBar = na
var int lastBullAnchorRank = 0
if finalBullEvent > 0
    lastBullAnchorBar := bar_index
    lastBullAnchorRank := finalBullEvent

int eventWindowBars = 6
inBullWindow = not na(lastBullAnchorBar) and bar_index >= lastBullAnchorBar and (bar_index - lastBullAnchorBar <= eventWindowBars)
rotationEntrySignal = inBullWindow and bullRiskAllowed and supertrendPass and lightTrendPass
entryRank = lastBullAnchorRank

var string[] slotIds = array.new_string()
var float[] slotEntry = array.new_float()
var int[] slotRank = array.new_int()
var int[] slotBar = array.new_int()

var int nextSlotNo = 1
var int lastLongEntryBar = na
var int lastOrderBar = na

f_entry_qty(float pct) =>
    float rawQty = close > 0 ? (strategy.equity * (pct * 0.01)) / close : 0.0
    math.max(rawQty, minQty)

f_slot_pnl_pct(int idx) =>
    float ep = array.get(slotEntry, idx)
    ep > 0 ? ((close - ep) / ep) * 100.0 : 0.0

f_find_open_trade_idx(string entryId) =>
    int foundIdx = na
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            if na(foundIdx) and strategy.opentrades.entry_id(i) == entryId
                foundIdx := i
    foundIdx

f_sync_slot_entries() =>
    if useRealFillSync and array.size(slotIds) > 0 and strategy.opentrades > 0
        for i = 0 to array.size(slotIds) - 1
            string sid = array.get(slotIds, i)
            int openIdx = f_find_open_trade_idx(sid)
            if not na(openIdx)
                array.set(slotEntry, i, strategy.opentrades.entry_price(openIdx))

f_find_weakest_idx() =>
    int weakestIdx = na
    float worstScore = na
    if array.size(slotEntry) > 0
        for i = 0 to array.size(slotEntry) - 1
            float pnl = f_slot_pnl_pct(i)
            int rk = array.get(slotRank, i)
            int age = bar_index - array.get(slotBar, i)
            float score = pnl + rk * 0.10 - age * 0.02
            if na(weakestIdx) or score < worstScore
                weakestIdx := i
                worstScore := score
    weakestIdx

f_close_slot(int idx) =>
    if idx >= 0 and idx < array.size(slotIds)
        string idToClose = array.get(slotIds, idx)
        strategy.close(idToClose, immediately=true)
        array.remove(slotIds, idx)
        array.remove(slotEntry, idx)
        array.remove(slotRank, idx)
        array.remove(slotBar, idx)

if strategy.position_size == 0 and array.size(slotIds) > 0 and (na(lastOrderBar) or bar_index > lastOrderBar)
    array.clear(slotIds)
    array.clear(slotEntry)
    array.clear(slotRank)
    array.clear(slotBar)
else
    f_sync_slot_entries()

canEnterLong = na(lastLongEntryBar) or (bar_index - lastLongEntryBar >= entryCooldownBars + 1)
slotAvailable = array.size(slotIds) < maxSlots
qtyNow = f_entry_qty(slotPct)
qtyOK = qtyNow > 0

if rotationEntrySignal and canEnterLong and qtyOK
    if slotAvailable
        string newId = "L_" + str.tostring(nextSlotNo)
        nextSlotNo += 1
        strategy.entry(newId, strategy.long, qty=qtyNow)
        array.push(slotIds, newId)
        array.push(slotEntry, close)
        array.push(slotRank, math.max(entryRank, 1))
        array.push(slotBar, bar_index)
        lastLongEntryBar := bar_index
        lastOrderBar := bar_index
    else if useReplacement and math.max(entryRank, 1) >= replaceMinRank
        int weakIdx = f_find_weakest_idx()
        if not na(weakIdx)
            float weakPnl = f_slot_pnl_pct(weakIdx)
            if weakPnl <= replaceIfPnlBelow
                f_close_slot(weakIdx)
                lastOrderBar := bar_index
                string newId = "L_" + str.tostring(nextSlotNo)
                nextSlotNo += 1
                strategy.entry(newId, strategy.long, qty=qtyNow)
                array.push(slotIds, newId)
                array.push(slotEntry, close)
                array.push(slotRank, math.max(entryRank, 1))
                array.push(slotBar, bar_index)
                lastLongEntryBar := bar_index
                lastOrderBar := bar_index

int maxHoldBars = 6
if array.size(slotIds) > 0
    for step = 0 to 49
        if step < array.size(slotIds)
            int idx = array.size(slotIds) - 1 - step
            if idx >= 0 and idx < array.size(slotIds)
                int age = bar_index - array.get(slotBar, idx)
                float pnlAtr = atrWeak > 0 ? (close - array.get(slotEntry, idx)) / atrWeak : 0.0
                float slopeAtr = atrWeak > 0 and not na(ema[weakExitBars]) ? (ema - ema[weakExitBars]) / atrWeak : 0.0
                bool weakExit = enableWeakRangeExit and age >= weakExitBars and pnlAtr <= weakRunupAtrMax and pnlAtr >= weakLossAtrMin and slopeAtr <= weakSlopeAtrMax
                bool timedExit = age >= maxHoldBars
                bool riskExit = riskOff and age >= 1
                if weakExit or timedExit or riskExit
                    f_close_slot(idx)
                    lastOrderBar := bar_index

if allowBear and array.size(slotIds) > 0
    if finalBearEvent == 1 or finalBearEvent == 2
        int weakIdx1 = f_find_weakest_idx()
        if not na(weakIdx1)
            f_close_slot(weakIdx1)
            lastOrderBar := bar_index
    if finalBearEvent == 3
        for step = 0 to 1
            if array.size(slotIds) > 0
                int weakIdx2 = f_find_weakest_idx()
                if not na(weakIdx2)
                    f_close_slot(weakIdx2)
                    lastOrderBar := bar_index
    if finalBearEvent == 4
        bool keepClosingLoss = true
        for step = 0 to 49
            if keepClosingLoss and array.size(slotIds) > 0
                int weakIdx3 = f_find_weakest_idx()
                if not na(weakIdx3)
                    float pnl = f_slot_pnl_pct(weakIdx3)
                    if pnl < 0
                        f_close_slot(weakIdx3)
                        lastOrderBar := bar_index
                    else
                        keepClosingLoss := false
        if closeAllOnBearConfRiskOff and riskOff
            for step = 0 to 49
                if array.size(slotIds) > 0
                    int weakIdx4 = f_find_weakest_idx()
                    if not na(weakIdx4)
                        f_close_slot(weakIdx4)
                        lastOrderBar := bar_index

if resetOnL3 and (bull == L3 or bear == L3)
    bull := 0
    bear := 0
    cycle := 0

plot(showEMAs ? ema : na, "EMA", color=color.orange, linewidth=1)
plot(showEMAs ? baseEMA : na, "Base EMA", color=color.red, linewidth=2)
plot(showEMAs and useSupertrendFilter ? stLine : na, "Supertrend", color=superBull ? color.green : color.red, linewidth=1)

plotshape(showSignals and bullL1, title="B1", location=location.belowbar, color=color.new(color.green, 65), style=shape.circle, size=size.tiny, text="B1")
plotshape(showSignals and bullCandidate, title="B2", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small, text="B2")
plotshape(showSignals and bullStrong, title="B3", location=location.belowbar, color=color.lime, style=shape.diamond, size=size.small, text="B3")
plotshape(showSignals and bearL1, title="S1", location=location.abovebar, color=color.new(color.red, 65), style=shape.circle, size=size.tiny, text="S1")
plotshape(showSignals and bearCandidate, title="S2", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small, text="S2")
plotshape(showSignals and bearStrong, title="S3", location=location.abovebar, color=color.maroon, style=shape.diamond, size=size.small, text="S3")
plotshape(showConfMark and bullConfirmed, title="BCONF", location=location.belowbar, color=color.blue, style=shape.labelup, size=size.small, text="BC")
plotshape(showConfMark and bearConfirmed, title="SCONF", location=location.abovebar, color=color.orange, style=shape.labeldown, size=size.small, text="SC")

alertcondition(newBullL1, title="New B1", message="New B1: {{ticker}}")
alertcondition(newBullCandidate, title="New B2", message="New B2: {{ticker}}")
alertcondition(newBullStrong, title="New B3", message="New B3: {{ticker}}")
alertcondition(newBullConfirmed, title="New BCONF", message="New BCONF: {{ticker}}")
alertcondition(newBearL1, title="New S1", message="New S1: {{ticker}}")
alertcondition(newBearCandidate, title="New S2", message="New S2: {{ticker}}")
alertcondition(newBearStrong, title="New S3", message="New S3: {{ticker}}")
alertcondition(newBearConfirmed, title="New SCONF", message="New SCONF: {{ticker}}")