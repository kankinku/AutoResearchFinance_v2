//@version=5
strategy("AF Mock Candidate [cand-3c7d9856]-mutA [cand-cf1d4c25]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0, process_orders_on_close=true)

fastLength = input.int(21, "Fast EMA", minval=2)
slowLength = input.int(55, "Slow EMA", minval=3)
rsiLength = input.int(14, "RSI Length", minval=2)
adxLen = input.int(14, "ADX Length", minval=2)
adxMin = input.float(16.0, "Min ADX", step=0.1)
bbLength = input.int(20, "BB Length", minval=5)
bbMult = input.float(2.0, "BB Mult", step=0.1)
minBbWidthPct = input.float(1.2, "Min BB Width %", step=0.1)
extEmaPctMax = input.float(2.2, "Max Price Extension Above Fast EMA %", step=0.1)
runupLookback = input.int(6, "Run-up Lookback Bars", minval=2)
maxRunupPct = input.float(3.2, "Max Short-Window Run-up %", step=0.1)
atrLen = input.int(14, "ATR Length", minval=2)
stopAtrMult = input.float(2.0, "Stop ATR Mult", step=0.1)
trailAtrMult = input.float(2.6, "Trail ATR Mult", step=0.1)
breakevenAtr = input.float(1.1, "Break-even Trigger ATR", step=0.1)
timeStopBars = input.int(12, "Weak Trade Time Stop Bars", minval=2)
weakAtrFrac = input.float(0.35, "Weak Trade ATR Progress", step=0.05)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLen)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
trur = ta.rma(ta.tr(true), adxLen)
plusDI = trur == 0.0 ? 0.0 : 100.0 * ta.rma(plusDM, adxLen) / trur
minusDI = trur == 0.0 ? 0.0 : 100.0 * ta.rma(minusDM, adxLen) / trur
dx = (plusDI + minusDI == 0.0) ? 0.0 : 100.0 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adx = ta.rma(dx, adxLen)

bbBasis = ta.sma(close, bbLength)
bbDev = ta.stdev(close, bbLength) * bbMult
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
bbWidthPct = bbBasis == 0.0 ? 0.0 : (bbUpper - bbLower) / bbBasis * 100.0

priceExtPct = fastEma == 0.0 ? 0.0 : (close - fastEma) / fastEma * 100.0
recentLowest = ta.lowest(low, runupLookback)
runupPct = recentLowest == 0.0 ? 0.0 : (close - recentLowest) / recentLowest * 100.0
barsUp3 = (close > close[1] ? 1 : 0) + (close[1] > close[2] ? 1 : 0) + (close[2] > close[3] ? 1 : 0)
notOverextended = priceExtPct < extEmaPctMax and runupPct < maxRunupPct and barsUp3 < 3

trendFilter = fastEma > slowEma and adx > adxMin and plusDI > minusDI
squeezeAvoid = bbWidthPct > minBbWidthPct
momentumFilter = rsiValue > 53 and rsiValue < 69
entrySignal = ta.crossover(fastEma, slowEma) or (fastEma > slowEma and ta.crossover(rsiValue, 54))
longEntry = strategy.position_size <= 0 and entrySignal and trendFilter and squeezeAvoid and momentumFilter and notOverextended

var int entryBar = na
if longEntry
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0 and strategy.position_size[1] <= 0
    entryBar := bar_index
if strategy.position_size <= 0
    entryBar := na

inPos = strategy.position_size > 0
avgPrice = strategy.position_avg_price
openProfit = inPos ? close - avgPrice : 0.0
barsInTrade = inPos and not na(entryBar) ? bar_index - entryBar : 0

baseStop = inPos ? avgPrice - atrValue * stopAtrMult : na
beStop = inPos and openProfit > atrValue * breakevenAtr ? avgPrice + syminfo.mintick : na
activeStop = inPos ? math.max(baseStop, na(beStop) ? baseStop : beStop) : na
trailStop = inPos ? close - atrValue * trailAtrMult : na
finalStop = inPos ? math.max(activeStop, trailStop) : na

strategy.exit("XL", "Long", stop=finalStop)

weakTrade = inPos and barsInTrade >= timeStopBars and openProfit < atrValue * weakAtrFrac
momentumFail = inPos and (rsiValue < 47 or (adx < adxMin and close < fastEma) or ta.crossunder(fastEma, slowEma))
deepLoss = inPos and close < avgPrice - atrValue * 1.25
forceExit = weakTrade or momentumFail or deepLoss
if forceExit
    strategy.close("Long")

plot(fastEma, color=color.teal, title="Fast EMA")
plot(slowEma, color=color.orange, title="Slow EMA")
plot(inPos ? finalStop : na, color=color.red, title="Dynamic Stop", style=plot.style_linebr)
plot(bbUpper, color=color.new(color.blue, 75), title="BB Upper")
plot(bbLower, color=color.new(color.blue, 75), title="BB Lower")