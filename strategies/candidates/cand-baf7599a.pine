//@version=5
strategy("AF Seed 01 - Time Boxed Event Rotation [cand-baf7599a]", overlay=true, pyramiding=30, process_orders_on_close=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=5, commission_type=strategy.commission.percent, commission_value=0.05)

groupSig = "1. Exhaustion"
L1 = input.int(9, "L1", minval=2, group=groupSig)
L2 = input.int(12, "L2", minval=3, group=groupSig)
L3 = input.int(14, "L3", minval=4, group=groupSig)
confirmBars = input.int(2, "확인 봉 수", minval=1, maxval=5, group=groupSig)

groupFilter = "2. 최소 필터"
emaLen = input.int(21, "EMA 기준", minval=1, group=groupFilter)
baseEmaLen = input.int(55, "Base EMA", minval=1, group=groupFilter)
rsiLen = input.int(14, "RSI Length", minval=2, group=groupFilter)
maxExtPct = input.float(6.0, "신규진입 최대 이격도(%)", minval=1.0, step=0.5, group=groupFilter)
riskOffRsi = input.float(45.0, "Risk-Off RSI", minval=5.0, maxval=95.0, step=0.5, group=groupFilter)

groupPos = "3. 슬롯 관리"
slotPct = input.float(5.0, "슬롯 1개 비중(%)", minval=0.1, maxval=100.0, step=0.5, group=groupPos)
maxSlots = input.int(9, "최대 슬롯 수", minval=1, maxval=50, group=groupPos)
useReplacement = input.bool(true, "최대 슬롯 도달 시 교체 허용", group=groupPos)
replaceMinRank = input.int(3, "교체 허용 최소 신호 강도 (1=B1, 2=B2, 3=B3, 4=BCONF)", minval=1, maxval=4, group=groupPos)
replaceIfPnlBelow = input.float(0.0, "이 수익률 이하 슬롯이면 교체(%)", step=0.5, group=groupPos)
applyFilterToB1 = input.bool(false, "B1에도 필터 적용", group=groupPos)
minQty = input.float(1.0, "최소 주문 수량", minval=0.000001, step=0.1, group=groupPos)

groupExit = "4. 청산"
closeAllOnBearConfRiskOff = input.bool(true, "Bear CONF + Risk-Off 시 전량청산", group=groupExit)

groupExec = "5. 실행 개선"
sameBarConflictMode = input.string("StrongWins", "같은 봉 충돌 처리", options=["StrongWins", "SkipBoth", "BearPriority"], group=groupExec)
trendMode = input.string("Balanced", "진입 추세 필터", options=["Strict", "Balanced", "Loose"], group=groupExec)
allowStrongCounterTrend = input.bool(true, "강한 매수(B3/BC)는 Risk-Off 일부 허용", group=groupExec)
entryCooldownBars = input.int(0, "매수 재진입 쿨다운(봉)", minval=0, maxval=20, group=groupExec)
useRealFillSync = input.bool(true, "실제 체결가로 슬롯 진입가 동기화", group=groupExec)
resetOnL3 = input.bool(false, "L3 즉시 리셋", group=groupExec)

groupST = "6. Supertrend 옵션"
useSupertrendFilter = input.bool(false, "Supertrend 필터 사용", group=groupST)
supertrendAtrPeriod = input.int(10, "Supertrend ATR 기간", minval=1, group=groupST)
supertrendFactor = input.float(3.0, "Supertrend 배수", minval=0.1, step=0.1, group=groupST)
supertrendBlocksWeakBull = input.bool(false, "약한 Bull 차단", group=groupST)
supertrendRiskOffEnabled = input.bool(false, "Supertrend Risk-Off", group=groupST)

groupWeak = "7. Weak Range Exit"
enableWeakRangeExit = input.bool(false, "약한 횡보 청산 사용", group=groupWeak)
weakExitAtrLen = input.int(14, "Weak Exit ATR Length", minval=1, group=groupWeak)
weakExitBars = input.int(8, "Weak Exit Bars", minval=1, group=groupWeak)
weakRunupAtrMax = input.float(1.2, "Weak Runup ATR Max", minval=0.0, step=0.1, group=groupWeak)
weakLossAtrMin = input.float(0.6, "Weak Loss ATR Min", minval=0.0, step=0.1, group=groupWeak)
weakSlopeAtrMax = input.float(0.25, "Weak Slope ATR Max", minval=0.0, step=0.05, group=groupWeak)

groupRoute = "8. Breakout Route"
eventFloorBars = input.int(2, "Event Floor Bars", minval=1, maxval=20, group=groupRoute)
eventWindowBars = input.int(8, "Event Window Bars", minval=1, maxval=40, group=groupRoute)
maxHoldBars = input.int(16, "Max Hold Bars", minval=1, maxval=80, group=groupRoute)
bullContinueWindow = input.int(5, "Bull Continue Window", minval=1, maxval=20, group=groupRoute)
bearReboundWindow = input.int(4, "Bear Rebound Window", minval=1, maxval=20, group=groupRoute)

groupDebug = "9. 디버그"
showDebugMarks = input.bool(false, "디버그 마크 표시", group=groupDebug)

groupView = "10. 표시"
showEMAs = input.bool(true, "EMA 표시", group=groupView)
showSignals = input.bool(true, "신호 표시", group=groupView)
showConfMark = input.bool(true, "CONF 표시", group=groupView)

L2v = math.max(L2, L1 + 1)
L3v = math.max(L3, L2v + 1)

ema = ta.ema(close, emaLen)
baseEMA = ta.ema(close, baseEmaLen)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(weakExitAtrLen)

bullTrend = close >= ema
bearTrend = close <= ema
bullMomentum = ((not na(rsi[1])) and rsi > rsi[1]) or ((not na(close[1])) and close > close[1])
bearMomentum = ((not na(rsi[1])) and rsi < rsi[1]) or ((not na(close[1])) and close < close[1])
emaUp = not na(ema[1]) and ema >= ema[1]
emaDown = not na(ema[1]) and ema <= ema[1]

overextended = close > ema * (1.0 + maxExtPct / 100.0)

tr = ta.tr(true)
atrSt = ta.rma(tr, supertrendAtrPeriod)
hl2 = (high + low) * 0.5
upperBand = hl2 + supertrendFactor * atrSt
lowerBand = hl2 - supertrendFactor * atrSt
var float stUpper = na
var float stLower = na
var int stDir = 1
stUpper := na(stUpper[1]) ? upperBand : (close[1] > stUpper[1] ? math.max(upperBand, stUpper[1]) : upperBand)
stLower := na(stLower[1]) ? lowerBand : (close[1] < stLower[1] ? math.min(lowerBand, stLower[1]) : lowerBand)
stDir := na(stDir[1]) ? 1 : stDir[1]
if close > stLower[1]
    stDir := 1
else if close < stUpper[1]
    stDir := -1
supertrendBull = stDir == 1

riskOffCore = close < baseEMA and rsi < riskOffRsi and emaDown
riskOff = riskOffCore or (supertrendRiskOffEnabled and not supertrendBull)

var int cycle = 0
var int bull = 0
var int bear = 0

has4 = bar_index >= 4 and not na(close[4])
has2 = bar_index >= 2 and not na(close[2])

f_reset() =>
    int nb = 0
    int ns = 0
    int nc = 0
    if has4
        if close < close[4]
            nb := 1
            nc := 1
        else if close > close[4]
            ns := 1
            nc := 1
    [nb, ns, nc]

if not has4
    bull := 0
    bear := 0
    cycle := 0
else
    if cycle < L1
        if close < close[4]
            bull := bull + 1
            bear := 0
            cycle := bull
        else if close > close[4]
            bear := bear + 1
            bull := 0
            cycle := bear
        else
            [nb, ns, nc] = f_reset()
            bull := nb
            bear := ns
            cycle := nc
    else
        if bull > 0
            if has2 and close < close[2]
                bull := bull + 1
                cycle := bull
            else
                [nb, ns, nc] = f_reset()
                bull := nb
                bear := ns
                cycle := nc
        else if bear > 0
            if has2 and close > close[2]
                bear := bear + 1
                cycle := bear
            else
                [nb, ns, nc] = f_reset()
                bull := nb
                bear := ns
                cycle := nc
        else
            [nb, ns, nc] = f_reset()
            bull := nb
            bear := ns
            cycle := nc

bullL1 = bull == L1
bullL2 = bull == L2v
bullL3 = bull == L3v
bearL1 = bear == L1
bearL2 = bear == L2v
bearL3 = bear == L3v

bullCandidate = bullL2
bearCandidate = bearL2
bullStrong = bullL3
bearStrong = bearL3

var int bullSignalBar = na
var int bearSignalBar = na

if bullCandidate or bullStrong
    bullSignalBar := bar_index
if bearCandidate or bearStrong
    bearSignalBar := bar_index

bullConfirmed = not na(bullSignalBar) and bar_index > bullSignalBar and (bar_index - bullSignalBar <= confirmBars) and close > high[1]
bearConfirmed = not na(bearSignalBar) and bar_index > bearSignalBar and (bar_index - bearSignalBar <= confirmBars) and close < low[1]

if bullConfirmed or (not na(bullSignalBar) and bar_index - bullSignalBar > confirmBars)
    bullSignalBar := na
if bearConfirmed or (not na(bearSignalBar) and bar_index - bearSignalBar > confirmBars)
    bearSignalBar := na

newBullL1 = bullL1 and not nz(bullL1[1], false)
newBullCandidate = bullCandidate and not nz(bullCandidate[1], false)
newBullStrong = bullStrong and not nz(bullStrong[1], false)
newBullConfirmed = bullConfirmed and not nz(bullConfirmed[1], false)
newBearL1 = bearL1 and not nz(bearL1[1], false)
newBearCandidate = bearCandidate and not nz(bearCandidate[1], false)
newBearStrong = bearStrong and not nz(bearStrong[1], false)
newBearConfirmed = bearConfirmed and not nz(bearConfirmed[1], false)

bullEventRaw = newBullConfirmed ? 4 : newBullStrong ? 3 : newBullCandidate ? 2 : newBullL1 ? 1 : 0
bearEventRaw = newBearConfirmed ? 4 : newBearStrong ? 3 : newBearCandidate ? 2 : newBearL1 ? 1 : 0

f_resolve_conflict(int bullEv, int bearEv) =>
    int resolvedBull = 0
    int resolvedBear = 0
    if bullEv > 0 and bearEv > 0
        if sameBarConflictMode == "BearPriority"
            resolvedBear := bearEv
        else if sameBarConflictMode == "SkipBoth"
            resolvedBull := 0
            resolvedBear := 0
        else
            if bullEv > bearEv
                resolvedBull := bullEv
            else if bearEv > bullEv
                resolvedBear := bearEv
            else
                if bullMomentum and not bearMomentum
                    resolvedBull := bullEv
                else if bearMomentum and not bullMomentum
                    resolvedBear := bearEv
                else if close > ema and rsi >= 50
                    resolvedBull := bullEv
                else if close < ema and rsi <= 50
                    resolvedBear := bearEv
    else
        resolvedBull := bullEv
        resolvedBear := bearEv
    [resolvedBull, resolvedBear]

[finalBullEvent, finalBearEvent] = f_resolve_conflict(bullEventRaw, bearEventRaw)

allowBull = finalBullEvent > 0
allowBear = finalBearEvent > 0

bullEventFloor = finalBullEvent >= 2
bearEventFloor = finalBearEvent >= 2

earlyBullEvent = newBullL1 or bullEventFloor
earlyBearEvent = newBearL1 or bearEventFloor

var int lastBullEventBar = na
var int lastBearEventBar = na
var int lastBullEventRank = 0
var int lastBearEventRank = 0

if earlyBullEvent
    lastBullEventBar := bar_index
    lastBullEventRank := finalBullEvent > 0 ? finalBullEvent : 1
if earlyBearEvent
    lastBearEventBar := bar_index
    lastBearEventRank := finalBearEvent > 0 ? finalBearEvent : 1

bullWindowAge = not na(lastBullEventBar) ? bar_index - lastBullEventBar : na
bearWindowAge = not na(lastBearEventBar) ? bar_index - lastBearEventBar : na

bullRotationWindow = not na(bullWindowAge) and bullWindowAge >= eventFloorBars and bullWindowAge <= eventWindowBars
bearReboundActive = not na(bearWindowAge) and bearWindowAge >= eventFloorBars and bearWindowAge <= bearReboundWindow
bullContinueActive = not na(bullWindowAge) and bullWindowAge >= eventFloorBars and bullWindowAge <= bullContinueWindow

recoveryPulse = close > ema or bullMomentum or close > open
antiStretchPass = not overextended or lastBullEventRank >= 3
stWeakBlock = useSupertrendFilter and supertrendBlocksWeakBull and not supertrendBull and lastBullEventRank <= 2
routeRiskAllowance = not riskOff or (allowStrongCounterTrend and lastBullEventRank >= 3)

primaryEntryTrigger = bullRotationWindow and (bullContinueActive or bearReboundActive or recoveryPulse) and antiStretchPass and not stWeakBlock
entryPass = primaryEntryTrigger and not riskOff

var slotIds = array.new_string()
var slotEntry = array.new_float()
var slotRank = array.new_int()
var slotEntryBar = array.new_int()

var int nextSlotNo = 1
var int lastLongEntryBar = na
var int lastOrderBar = na

f_entry_qty(float pct) =>
    float rawQty = close > 0 ? (strategy.equity * (pct * 0.01)) / close : 0.0
    math.max(rawQty, minQty)

f_slot_pnl_pct(int idx) =>
    float ep = array.get(slotEntry, idx)
    ep > 0 ? ((close - ep) / ep) * 100.0 : 0.0

f_find_open_trade_idx(string entryId) =>
    int foundIdx = na
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            if na(foundIdx) and strategy.opentrades.entry_id(i) == entryId
                foundIdx := i
    foundIdx

f_sync_slot_entries() =>
    if useRealFillSync and array.size(slotIds) > 0 and strategy.opentrades > 0
        for i = 0 to array.size(slotIds) - 1
            string sid = array.get(slotIds, i)
            int openIdx = f_find_open_trade_idx(sid)
            if not na(openIdx)
                array.set(slotEntry, i, strategy.opentrades.entry_price(openIdx))

f_find_weakest_idx() =>
    int weakestIdx = na
    float worstPnl = na
    int worstRank = na
    if array.size(slotEntry) > 0
        for i = 0 to array.size(slotEntry) - 1
            float pnl = f_slot_pnl_pct(i)
            int rk = array.get(slotRank, i)
            if na(weakestIdx)
                weakestIdx := i
                worstPnl := pnl
                worstRank := rk
            else if pnl < worstPnl or (math.abs(pnl - worstPnl) < 0.0001 and rk < worstRank)
                weakestIdx := i
                worstPnl := pnl
                worstRank := rk
    weakestIdx

f_find_oldest_idx() =>
    int oldestIdx = na
    int oldestBar = na
    if array.size(slotEntryBar) > 0
        for i = 0 to array.size(slotEntryBar) - 1
            int eb = array.get(slotEntryBar, i)
            if na(oldestIdx) or eb < oldestBar
                oldestIdx := i
                oldestBar := eb
    oldestIdx

f_close_slot(int idx) =>
    if idx >= 0 and idx < array.size(slotIds)
        string idToClose = array.get(slotIds, idx)
        strategy.close(idToClose, immediately=true)
        array.remove(slotIds, idx)
        array.remove(slotEntry, idx)
        array.remove(slotRank, idx)
        array.remove(slotEntryBar, idx)

if strategy.position_size == 0 and array.size(slotIds) > 0 and (na(lastOrderBar) or bar_index > lastOrderBar)
    array.clear(slotIds)
    array.clear(slotEntry)
    array.clear(slotRank)
    array.clear(slotEntryBar)
else
    f_sync_slot_entries()

if array.size(slotIds) > 0
    bool continueTimeExitLoop = true
    for step = 0 to 49
        if continueTimeExitLoop and array.size(slotIds) > 0
            int oldestIdx = f_find_oldest_idx()
            if not na(oldestIdx)
                int heldBars = bar_index - array.get(slotEntryBar, oldestIdx)
                if heldBars >= maxHoldBars
                    f_close_slot(oldestIdx)
                    lastOrderBar := bar_index
                else
                    continueTimeExitLoop := false
            else
                continueTimeExitLoop := false

canEnterLong = na(lastLongEntryBar) or (bar_index - lastLongEntryBar >= entryCooldownBars + 1)
slotAvailable = array.size(slotIds) < maxSlots
qtyNow = f_entry_qty(slotPct)
qtyOK = qtyNow > 0

if entryPass and routeRiskAllowance and canEnterLong and qtyOK
    if slotAvailable
        string newId = "L_" + str.tostring(nextSlotNo)
        nextSlotNo += 1
        strategy.entry(newId, strategy.long, qty=qtyNow)
        array.push(slotIds, newId)
        array.push(slotEntry, close)
        array.push(slotRank, math.max(lastBullEventRank, 1))
        array.push(slotEntryBar, bar_index)
        lastLongEntryBar := bar_index
        lastOrderBar := bar_index
    else if useReplacement and math.max(lastBullEventRank, 1) >= replaceMinRank
        int weakIdx = f_find_weakest_idx()
        if not na(weakIdx)
            float weakPnl = f_slot_pnl_pct(weakIdx)
            int weakRank = array.get(slotRank, weakIdx)
            int weakHeld = bar_index - array.get(slotEntryBar, weakIdx)
            bool canReplace = weakHeld >= maxHoldBars or weakPnl <= replaceIfPnlBelow or math.max(lastBullEventRank, 1) > weakRank
            if canReplace
                f_close_slot(weakIdx)
                lastOrderBar := bar_index
                string newId = "L_" + str.tostring(nextSlotNo)
                nextSlotNo += 1
                strategy.entry(newId, strategy.long, qty=qtyNow)
                array.push(slotIds, newId)
                array.push(slotEntry, close)
                array.push(slotRank, math.max(lastBullEventRank, 1))
                array.push(slotEntryBar, bar_index)
                lastLongEntryBar := bar_index
                lastOrderBar := bar_index

if enableWeakRangeExit and array.size(slotIds) > 0 and atr > 0
    int szWeak = array.size(slotIds)
    bool weakExitArmed = false
    for i = 0 to szWeak - 1
        float ep = array.get(slotEntry, i)
        int eb = array.get(slotEntryBar, i)
        int held = bar_index - eb
        float pnlAtr = (close - ep) / atr
        float slopeAtr = math.abs(ema - ema[math.min(weakExitBars, bar_index)]) / atr
        if held >= weakExitBars and pnlAtr <= -weakLossAtrMin and slopeAtr <= weakSlopeAtrMax
            weakExitArmed := true
    if weakExitArmed
        int weakIdx = f_find_weakest_idx()
        if not na(weakIdx)
            f_close_slot(weakIdx)
            lastOrderBar := bar_index

if riskOff and array.size(slotIds) > 0
    int weakIdxRisk = f_find_weakest_idx()
    if not na(weakIdxRisk)
        float weakPnlRisk = f_slot_pnl_pct(weakIdxRisk)
        if weakPnlRisk < 0
            f_close_slot(weakIdxRisk)
            lastOrderBar := bar_index

if allowBear and array.size(slotIds) > 0
    if finalBearEvent == 1 or finalBearEvent == 2
        int weakIdx1 = f_find_weakest_idx()
        if not na(weakIdx1)
            f_close_slot(weakIdx1)
            lastOrderBar := bar_index
    if finalBearEvent == 3
        for step = 0 to 1
            if array.size(slotIds) > 0
                int weakIdx2 = f_find_weakest_idx()
                if not na(weakIdx2)
                    f_close_slot(weakIdx2)
                    lastOrderBar := bar_index
    if finalBearEvent == 4
        bool keepClosingLoss = true
        for step = 0 to 49
            if keepClosingLoss and array.size(slotIds) > 0
                int weakIdx3 = f_find_weakest_idx()
                if not na(weakIdx3)
                    float pnl3 = f_slot_pnl_pct(weakIdx3)
                    if pnl3 < 0
                        f_close_slot(weakIdx3)
                        lastOrderBar := bar_index
                    else
                        keepClosingLoss := false
        if closeAllOnBearConfRiskOff and riskOff
            for step = 0 to 49
                if array.size(slotIds) > 0
                    int weakIdx4 = f_find_weakest_idx()
                    if not na(weakIdx4)
                        f_close_slot(weakIdx4)
                        lastOrderBar := bar_index

if resetOnL3 and (bull == L3v or bear == L3v)
    bull := 0
    bear := 0
    cycle := 0

plot(showEMAs ? ema : na, "EMA", color=color.orange, linewidth=1)
plot(showEMAs ? baseEMA : na, "Base EMA", color=color.red, linewidth=2)

plotshape(showSignals and bullL1, title="B1", location=location.belowbar, color=color.new(color.green, 65), style=shape.circle, size=size.tiny, text="B1")
plotshape(showSignals and bullCandidate, title="B2", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small, text="B2")
plotshape(showSignals and bullStrong, title="B3", location=location.belowbar, color=color.lime, style=shape.diamond, size=size.small, text="B3")
plotshape(showSignals and bearL1, title="S1", location=location.abovebar, color=color.new(color.red, 65), style=shape.circle, size=size.tiny, text="S1")
plotshape(showSignals and bearCandidate, title="S2", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small, text="S2")
plotshape(showSignals and bearStrong, title="S3", location=location.abovebar, color=color.maroon, style=shape.diamond, size=size.small, text="S3")
plotshape(showConfMark and bullConfirmed, title="BCONF", location=location.belowbar, color=color.blue, style=shape.labelup, size=size.small, text="BC")
plotshape(showConfMark and bearConfirmed, title="SCONF", location=location.abovebar, color=color.orange, style=shape.labeldown, size=size.small, text="SC")

plotchar(showDebugMarks ? primaryEntryTrigger : na, title="primaryEntryTrigger", char="P", location=location.top, color=color.lime, size=size.tiny)
plotchar(showDebugMarks ? entryPass : na, title="entryPass", char="E", location=location.top, color=color.green, size=size.tiny)
plotchar(showDebugMarks ? bullRotationWindow : na, title="bullRotationWindow", char="W", location=location.top, color=color.aqua, size=size.tiny)
plotchar(showDebugMarks ? bearReboundActive : na, title="bearReboundActive", char="R", location=location.top, color=color.yellow, size=size.tiny)
plotchar(showDebugMarks ? riskOff : na, title="riskOff", char="X", location=location.bottom, color=color.red, size=size.tiny)

alertcondition(newBullL1, title="New B1", message="New B1: {{ticker}}")
alertcondition(newBullCandidate, title="New B2", message="New B2: {{ticker}}")
alertcondition(newBullStrong, title="New B3", message="New B3: {{ticker}}")
alertcondition(newBullConfirmed, title="New BCONF", message="New BCONF: {{ticker}}")
alertcondition(newBearL1, title="New S1", message="New S1: {{ticker}}")
alertcondition(newBearCandidate, title="New S2", message="New S2: {{ticker}}")
alertcondition(newBearStrong, title="New S3", message="New S3: {{ticker}}")
alertcondition(newBearConfirmed, title="New SCONF", message="New SCONF: {{ticker}}")
