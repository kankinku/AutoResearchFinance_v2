//@version=5
strategy("AF Mock Candidate [cand-3c7d9856]-mut1 [cand-9a1f23a1]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0, process_orders_on_close=true)

fastLength = input.int(21, "Fast EMA", minval=2)
slowLength = input.int(55, "Slow EMA", minval=3)
rsiLength = input.int(14, "RSI Length", minval=2)
adxLength = input.int(14, "ADX Length", minval=2)
adxFloor = input.float(16.0, "ADX Floor", minval=1.0, step=0.5)
atrLength = input.int(14, "ATR Length", minval=2)
atrStopMult = input.float(2.2, "ATR Stop Mult", minval=0.5, step=0.1)
atrTrailMult = input.float(2.8, "ATR Trail Mult", minval=0.5, step=0.1)
extLookback = input.int(6, "Extension Lookback Bars", minval=2)
extPctMax = input.float(2.2, "Max Short-Window Extension %", minval=0.2, step=0.1)
pullbackPctMax = input.float(1.8, "Max Distance Above Fast EMA %", minval=0.1, step=0.1)
failBars = input.int(5, "Fail Exit Bars", minval=1)
minRunupForTrail = input.float(0.8, "Min Runup % For Trail", minval=0.1, step=0.1)
bbLength = input.int(20, "BB Length", minval=5)
bbMult = input.float(2.0, "BB Mult", minval=0.5, step=0.1)
minBbWidthPct = input.float(3.0, "Min BB Width %", minval=0.2, step=0.1)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
trur = ta.rma(ta.tr(true), adxLength)
plusDI = trur == 0.0 ? 0.0 : 100.0 * ta.rma(plusDM, adxLength) / trur
minusDI = trur == 0.0 ? 0.0 : 100.0 * ta.rma(minusDM, adxLength) / trur
dx = (plusDI + minusDI == 0.0) ? 0.0 : 100.0 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adx = ta.rma(dx, adxLength)

basis = ta.sma(close, bbLength)
dev = bbMult * ta.stdev(close, bbLength)
bbUpper = basis + dev
bbLower = basis - dev
bbWidthPct = basis == 0.0 ? 0.0 : (bbUpper - bbLower) / basis * 100.0

highestRecent = ta.highest(high, extLookback)
extensionPct = close == 0.0 ? 0.0 : (highestRecent - close) / close * 100.0
priceVsFastPct = fastEma == 0.0 ? 0.0 : (close - fastEma) / fastEma * 100.0
slowSlopeUp = slowEma > slowEma[3]
trendOk = fastEma > slowEma and slowSlopeUp and adx > adxFloor and plusDI > minusDI
notSqueeze = bbWidthPct > minBbWidthPct
notLate = priceVsFastPct < pullbackPctMax and extensionPct < extPctMax
momentumOk = rsiValue > 53

longEntry = ta.crossover(fastEma, slowEma) and momentumOk and trendOk and notSqueeze and notLate

var int entryBarIndex = na
var float peakSinceEntry = na
var float entryPriceMem = na

if strategy.position_size <= 0
    entryBarIndex := na
    peakSinceEntry := na
    entryPriceMem := na

if longEntry and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    entryBarIndex := na(entryBarIndex) ? bar_index : entryBarIndex
    entryPriceMem := na(entryPriceMem) ? strategy.position_avg_price : entryPriceMem
    peakSinceEntry := na(peakSinceEntry) ? high : math.max(peakSinceEntry, high)

barsInTrade = strategy.position_size > 0 and not na(entryBarIndex) ? (bar_index - entryBarIndex) : 0
runupPct = strategy.position_size > 0 and strategy.position_avg_price != 0.0 and not na(peakSinceEntry) ? (peakSinceEntry - strategy.position_avg_price) / strategy.position_avg_price * 100.0 : 0.0
hardStop = strategy.position_size > 0 ? strategy.position_avg_price - atrValue * atrStopMult : na
trailStop = strategy.position_size > 0 and runupPct >= minRunupForTrail ? peakSinceEntry - atrValue * atrTrailMult : na
activeStop = strategy.position_size > 0 ? (na(trailStop) ? hardStop : math.max(hardStop, trailStop)) : na

weakMomentumExit = strategy.position_size > 0 and (rsiValue < 47 or (adx < adxFloor * 0.9 and close < fastEma))
failExit = strategy.position_size > 0 and barsInTrade >= failBars and close < strategy.position_avg_price and close < fastEma
trendExit = strategy.position_size > 0 and (ta.crossunder(fastEma, slowEma) or plusDI < minusDI)
stopExit = strategy.position_size > 0 and low <= activeStop

if strategy.position_size > 0
    strategy.exit("XL", "Long", stop=activeStop)

if weakMomentumExit or failExit or trendExit
    strategy.close("Long")

plot(fastEma, color=color.new(color.teal, 0), title="Fast EMA")
plot(slowEma, color=color.new(color.orange, 0), title="Slow EMA")
plot(strategy.position_size > 0 ? activeStop : na, color=color.new(color.red, 0), title="Active Stop", style=plot.style_linebr)
plotchar(longEntry, title="Long Entry", char="▲", location=location.belowbar, color=color.new(color.green, 0), size=size.tiny)
plotchar(weakMomentumExit or failExit or trendExit, title="Close Signal", char="▼", location=location.abovebar, color=color.new(color.red, 0), size=size.tiny)
