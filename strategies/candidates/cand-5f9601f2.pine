//@version=5
strategy("AF Mutation QQQ 120m Gate Seeker [cand-5f9601f2]", overlay=true, initial_capital=100000, pyramiding=0, commission_type=strategy.commission.percent, commission_value=0.1, process_orders_on_close=true)

fastLength = input.int(20, "Fast EMA", minval=2)
slowLength = input.int(50, "Slow EMA", minval=5)
rsiLength = input.int(14, "RSI Length", minval=2)
atrLength = input.int(14, "ATR Length", minval=2)
lookbackBreakout = input.int(10, "Breakout Lookback", minval=2)
pullbackLookback = input.int(4, "Pullback Lookback", minval=1)
minAdx = input.float(15.0, "Min ADX", minval=1.0, step=0.5)
minRsi = input.float(51.0, "Min RSI Reclaim", minval=1.0, maxval=99.0, step=0.5)
stopATR = input.float(2.1, "Stop ATR", minval=0.5, step=0.1)
targetATR = input.float(4.4, "Target ATR", minval=0.5, step=0.1)
trailATR = input.float(2.6, "Trail ATR", minval=0.5, step=0.1)
breakevenATR = input.float(1.5, "Breakeven Trigger ATR", minval=0.5, step=0.1)
maxBarsInTrade = input.int(28, "Max Bars In Trade", minval=2)
useBreakoutEntry = input.bool(true, "Enable Breakout Entry")
usePullbackEntry = input.bool(true, "Enable Pullback Reclaim Entry")

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
trur = ta.rma(ta.tr(true), 14)
plusDI = trur != 0 ? 100 * ta.rma(plusDM, 14) / trur : 0.0
minusDI = trur != 0 ? 100 * ta.rma(minusDM, 14) / trur : 0.0
dx = (plusDI + minusDI != 0) ? 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI) : 0.0
adx = ta.rma(dx, 14)

trendUp = close > slowEma and fastEma > slowEma and slowEma > slowEma[1]
trendStrength = adx > minAdx and plusDI > minusDI

pullbackTouched = ta.lowest(low, pullbackLookback) <= fastEma
reclaimSignal = close > fastEma and close > open and rsiValue > minRsi and rsiValue > rsiValue[1]
breakoutSignal = close > ta.highest(high[1], lookbackBreakout) and rsiValue > 55

entryPullback = usePullbackEntry and trendUp and trendStrength and pullbackTouched and reclaimSignal
entryBreakout = useBreakoutEntry and trendUp and trendStrength and breakoutSignal
longEntry = strategy.position_size == 0 and (entryPullback or entryBreakout)

var int barsInTrade = 0
barsInTrade := strategy.position_size != 0 ? nz(barsInTrade[1]) + 1 : 0

if longEntry
    strategy.entry("Long", strategy.long)

avgPrice = strategy.position_avg_price
profitATR = strategy.position_size > 0 ? (close - avgPrice) / atrValue : 0.0
stopPriceBase = avgPrice - atrValue * stopATR
stopPriceBE = profitATR >= breakevenATR ? avgPrice : stopPriceBase
trailStop = close - atrValue * trailATR
stopPrice = strategy.position_size > 0 ? math.max(stopPriceBE, trailStop) : na
targetPrice = strategy.position_size > 0 ? avgPrice + atrValue * targetATR : na

if strategy.position_size > 0
    strategy.exit("XL", "Long", stop=stopPrice, limit=targetPrice)

exitTrendFail = strategy.position_size > 0 and (close < slowEma or fastEma < slowEma or plusDI < minusDI)
exitRsiFail = strategy.position_size > 0 and rsiValue < 47
exitTime = strategy.position_size > 0 and barsInTrade >= maxBarsInTrade

if exitTrendFail or exitRsiFail or exitTime
    strategy.close("Long")

plot(fastEma, color=color.new(color.teal, 0), title="Fast EMA")
plot(slowEma, color=color.new(color.orange, 0), title="Slow EMA")
plot(strategy.position_size > 0 ? stopPrice : na, color=color.new(color.red, 0), title="Dynamic Stop", style=plot.style_linebr)
plot(strategy.position_size > 0 ? targetPrice : na, color=color.new(color.green, 0), title="Target", style=plot.style_linebr)
plotshape(longEntry, title="Long Entry", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), size=size.tiny, text="L")