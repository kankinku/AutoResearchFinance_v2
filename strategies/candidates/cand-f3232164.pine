//@version=5
strategy("AF Mutation Trend Gate QQQ 120m [cand-f3232164]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0, process_orders_on_close=true)

fastLength = input.int(21, "Fast EMA", minval=2)
slowLength = input.int(55, "Slow EMA", minval=3)
trendLength = input.int(200, "Trend EMA", minval=20)
rsiLength = input.int(14, "RSI Length", minval=2)
adxLength = input.int(14, "ADX Length", minval=2)
adxMin = input.float(16.0, "Min ADX", minval=1.0, step=0.5)
htfTf = input.timeframe("D", "Higher Timeframe")
htfEmaLen = input.int(100, "HTF EMA Length", minval=10)
pullbackLookback = input.int(6, "Pullback Lookback", minval=2)
extensionPct = input.float(2.2, "Max Extension % Above Fast EMA", minval=0.2, step=0.1)
atrLength = input.int(14, "ATR Length", minval=1)
stopAtrMult = input.float(2.2, "Stop ATR Mult", minval=0.5, step=0.1)
targetAtrMult = input.float(4.2, "Target ATR Mult", minval=0.5, step=0.1)
trailAtrMult = input.float(2.6, "Trail ATR Mult", minval=0.5, step=0.1)
maxBarsInTrade = input.int(18, "Max Bars In Trade", minval=2)
minRsi = input.float(52.0, "Min RSI", minval=1, maxval=99, step=0.5)
exitRsi = input.float(47.0, "Exit RSI", minval=1, maxval=99, step=0.5)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
trendEma = ta.ema(close, trendLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
trur = ta.rma(ta.tr(true), adxLength)
plusDI = trur == 0.0 ? 0.0 : 100.0 * ta.rma(plusDM, adxLength) / trur
minusDI = trur == 0.0 ? 0.0 : 100.0 * ta.rma(minusDM, adxLength) / trur
dx = (plusDI + minusDI == 0.0) ? 0.0 : 100.0 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adx = ta.rma(dx, adxLength)

htfClose = request.security(syminfo.tickerid, htfTf, close)
htfEma = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen))
htfTrendUp = htfClose > htfEma and htfEma > htfEma[1]

emaTrendUp = fastEma > slowEma and slowEma > trendEma and trendEma >= trendEma[1]
priceTrendUp = close > slowEma and close > trendEma
trendStrength = adx > adxMin and plusDI > minusDI
recentPullback = ta.lowest(low, pullbackLookback) <= fastEma
notOverextended = close <= fastEma * (1.0 + extensionPct / 100.0)
entryMomentum = rsiValue > minRsi
freshCross = ta.crossover(fastEma, slowEma)
continuationSetup = emaTrendUp and ta.crossover(close, fastEma)

longEntry = (freshCross or continuationSetup) and emaTrendUp and priceTrendUp and htfTrendUp and trendStrength and recentPullback and notOverextended and entryMomentum

weakTrendExit = (ta.crossunder(fastEma, slowEma) or close < slowEma) and (rsiValue < exitRsi or plusDI < minusDI)

var int barsInTrade = 0
barsInTrade := strategy.position_size > 0 ? nz(barsInTrade[1]) + 1 : 0
timeExit = strategy.position_size > 0 and barsInTrade >= maxBarsInTrade and close < fastEma

if longEntry and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    stopPrice = strategy.position_avg_price - atrValue * stopAtrMult
    limitPrice = strategy.position_avg_price + atrValue * targetAtrMult
    trailOffset = atrValue * trailAtrMult
    strategy.exit("Long Risk", "Long", stop=stopPrice, limit=limitPrice, trail_offset=trailOffset)

if weakTrendExit or timeExit
    strategy.close("Long")

plot(fastEma, "Fast EMA", color=color.new(color.teal, 0))
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0))
plot(trendEma, "Trend EMA", color=color.new(color.blue, 0))