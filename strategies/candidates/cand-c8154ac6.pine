//@version=5
strategy("AF Mock Candidate [cand-mut-extgate-exit] [cand-c8154ac6]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0, process_orders_on_close=true)

fastLength = input.int(21, "Fast EMA", minval=2)
slowLength = input.int(55, "Slow EMA", minval=3)
rsiLength = input.int(14, "RSI Length", minval=2)
atrLength = input.int(14, "ATR Length", minval=2)
extLookback = input.int(6, "Extension Lookback", minval=2)
extAtrMult = input.float(1.1, "Max Short-Window Extension ATR", minval=0.2, step=0.1)
maxBarsHold = input.int(24, "Max Bars Hold", minval=2)
stopAtrMult = input.float(2.0, "Initial Stop ATR", minval=0.5, step=0.1)
trailAtrMult = input.float(2.2, "Trailing Stop ATR", minval=0.5, step=0.1)
profitArmAtr = input.float(1.3, "Trail Arm Profit ATR", minval=0.2, step=0.1)
adxLen = input.int(14, "ADX Length", minval=2)
adxMin = input.float(16.0, "Min ADX", minval=5.0, step=0.5)
bbLen = input.int(20, "BB Length", minval=5)
bbMult = input.float(2.0, "BB Mult", minval=0.5, step=0.1)
minBbWidthPct = input.float(0.035, "Min BB Width %", minval=0.005, step=0.005)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

highestShort = ta.highest(high, extLookback)
shortWindowExtension = highestShort - fastEma
notOverextended = shortWindowExtension <= atrValue * extAtrMult

basis = ta.sma(close, bbLen)
dev = ta.stdev(close, bbLen) * bbMult
upper = basis + dev
lower = basis - dev
bbWidthPct = basis != 0.0 ? (upper - lower) / basis : 0.0
notSqueeze = bbWidthPct >= minBbWidthPct

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
tr = ta.tr(true)
trRma = ta.rma(tr, adxLen)
plusDI = trRma != 0 ? 100 * ta.rma(plusDM, adxLen) / trRma : 0.0
minusDI = trRma != 0 ? 100 * ta.rma(minusDM, adxLen) / trRma : 0.0
dx = (plusDI + minusDI) != 0 ? 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI) : 0.0
adx = ta.rma(dx, adxLen)
trendOkay = adx >= adxMin and plusDI > minusDI

emaSlopeOkay = fastEma > fastEma[1] and slowEma >= slowEma[1]
entrySignal = ta.crossover(fastEma, slowEma) and rsiValue > 54 and trendOkay and emaSlopeOkay and notOverextended and notSqueeze

var int entryBarIndex = na
var float peakSinceEntry = na
var float trailStop = na
var float stopPrice = na

if entrySignal and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0 and strategy.position_size[1] <= 0
    entryBarIndex := bar_index
    peakSinceEntry := high
    stopPrice := strategy.position_avg_price - atrValue * stopAtrMult
    trailStop := na

if strategy.position_size > 0
    peakSinceEntry := na(peakSinceEntry) ? high : math.max(peakSinceEntry, high)
    openProfitAtr = (close - strategy.position_avg_price) / atrValue
    armedTrail = openProfitAtr >= profitArmAtr
    calcTrail = peakSinceEntry - atrValue * trailAtrMult
    trailStop := armedTrail ? (na(trailStop) ? calcTrail : math.max(trailStop, calcTrail)) : na
    stopPrice := math.max(strategy.position_avg_price - atrValue * stopAtrMult, na(trailStop) ? strategy.position_avg_price - atrValue * stopAtrMult : trailStop)
    strategy.exit("XL", "Long", stop=stopPrice)

barsInTrade = strategy.position_size > 0 and not na(entryBarIndex) ? (bar_index - entryBarIndex) : 0
momentumWeak = rsiValue < 48 or (close < fastEma and rsiValue < 52) or (plusDI < minusDI and adx > adxMin)
timeExit = strategy.position_size > 0 and barsInTrade >= maxBarsHold
crossExit = ta.crossunder(fastEma, slowEma)
weakExit = strategy.position_size > 0 and (momentumWeak or crossExit or timeExit)

if weakExit
    strategy.close("Long")

if strategy.position_size <= 0
    entryBarIndex := na
    peakSinceEntry := na
    trailStop := na
    stopPrice := na

plot(fastEma, color=color.new(color.teal, 0), title="Fast EMA")
plot(slowEma, color=color.new(color.orange, 0), title="Slow EMA")
plot(strategy.position_size > 0 ? stopPrice : na, color=color.new(color.red, 0), title="Active Stop", style=plot.style_linebr)
plotshape(entrySignal, title="Long Signal", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny)