//@version=5
strategy("AF Seed 01 Mutation [exhaustion-seq-reclaim-tight-exit] [cand-af-rsq-restore-01] [cand-77734469]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=2, default_qty_type=strategy.percent_of_equity, default_qty_value=25)

fastLength = input.int(21, "Fast EMA", minval=2)
slowLength = input.int(55, "Slow EMA", minval=3)
rsiLength = input.int(14, "RSI Length", minval=2)
adxLength = input.int(14, "ADX Length", minval=2)
atrLength = input.int(14, "ATR Length", minval=2)
trendLookback = input.int(20, "Trend Slope Lookback", minval=2)
exhaustionLookback = input.int(4, "Exhaustion Compare Lookback", minval=1)
setupCountNeeded = input.int(2, "Exhaustion Count Needed", minval=1, maxval=9)
maxSetupAge = input.int(6, "Max Setup Age", minval=1)
confirmBars = input.int(2, "Confirmation Window Bars", minval=1, maxval=5)
reclaimAtrFrac = input.float(0.2, "Reclaim ATR Fraction", minval=0.0, step=0.05)
slot2DrawdownAtr = input.float(-0.45, "Slot2 Add Drawdown ATR", maxval=0, step=0.05)
replacementBetterAtr = input.float(0.15, "Replacement Better Price ATR", minval=0.0, step=0.05)
maxExtensionPct = input.float(4.0, "Max Short-Term Extension %", minval=0.2, step=0.1)
maxFastDistPct = input.float(2.5, "Max Distance Above Fast EMA %", minval=0.1, step=0.1)
maxEntryRsi = input.int(74, "Max RSI For Entry Stretch Filter", minval=50, maxval=95)
minRsi = input.int(49, "Min RSI For Entry", minval=1, maxval=99)
minAdx = input.float(12.0, "Min ADX For Entry", minval=1, step=0.5)
stopAtrMult = input.float(2.2, "Stop ATR Mult", minval=0.5, step=0.1)
trailAtrMult = input.float(2.6, "Trail ATR Mult", minval=0.5, step=0.1)
maxBarsInTrade = input.int(18, "Max Bars In Trade", minval=1)
lossBarsExit = input.int(5, "Lose-After Bars Exit", minval=1)
retraceExitAtr = input.float(0.95, "Peak Retrace Exit ATR", minval=0.2, step=0.1)
quickLossAtr = input.float(-0.6, "Quick Loss ATR Threshold", maxval=0, step=0.05)
rangeAdxMax = input.float(18.0, "Range ADX Max", minval=5, step=0.5)
squeezeWidthPctMax = input.float(2.2, "Squeeze Width % Max", minval=0.2, step=0.1)
rangeWeakLossAtr = input.float(-0.18, "Range Weak Loss ATR", maxval=0, step=0.05)
rangeQuickLossAtr = input.float(-0.32, "Range Quick Loss ATR", maxval=0, step=0.05)
deepDrawdownAtr = input.float(-0.95, "Deep Drawdown ATR Exit", maxval=0, step=0.05)
weakMomentumRsi = input.int(49, "Weak Momentum RSI Exit", minval=1, maxval=99)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
trur = ta.rma(ta.tr(true), adxLength)
plusDI = trur == 0.0 ? 0.0 : 100.0 * ta.rma(plusDM, adxLength) / trur
minusDI = trur == 0.0 ? 0.0 : 100.0 * ta.rma(minusDM, adxLength) / trur
dx = (plusDI + minusDI == 0.0) ? 0.0 : 100.0 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adx = ta.rma(dx, adxLength)

slowSlopeUp = slowEma > slowEma[trendLookback]
trendDownRegime = fastEma < slowEma and slowEma < slowEma[trendLookback] and minusDI > plusDI
shortTermExtensionPct = ((close / ta.lowest(close, 8)) - 1.0) * 100.0
fastDistPct = fastEma == 0.0 ? 0.0 : ((close / fastEma) - 1.0) * 100.0
bandBasis = ta.sma(close, 20)
bandDev = ta.stdev(close, 20)
bandUpper = bandBasis + bandDev * 2.0
bandLower = bandBasis - bandDev * 2.0
bandWidthPct = bandBasis == 0.0 ? 0.0 : ((bandUpper - bandLower) / bandBasis) * 100.0
rangeRegime = adx < rangeAdxMax and math.abs(fastEma - slowEma) / close < 0.012
rangeSqueezeRegime = rangeRegime and bandWidthPct < squeezeWidthPctMax
notLateExtension = shortTermExtensionPct < maxExtensionPct and fastDistPct < maxFastDistPct and rsiValue < maxEntryRsi
trendQualified = fastEma > slowEma and slowSlopeUp and adx > minAdx and plusDI >= minusDI
softTrendQualified = fastEma > slowEma and slowSlopeUp and plusDI >= minusDI * 0.9

bullExhaustBar = close < close[exhaustionLookback] and low < low[1]
resetExhaust = close > fastEma and close > close[1]
var int bullExhaustCount = 0
bullExhaustCount := resetExhaust ? 0 : (bullExhaustBar ? bullExhaustCount[1] + 1 : bullExhaustCount[1])
setupReady = bullExhaustCount >= setupCountNeeded
setupFresh = ta.barssince(setupReady) <= maxSetupAge
reclaimLevel = fastEma - atrValue * reclaimAtrFrac
confirmReclaim = close > reclaimLevel and close > close[1]
confirmMomentum = rsiValue > minRsi and (rsiValue > rsiValue[1] or ta.rising(rsiValue, 2))
confirmationLogic = ta.barssince(confirmReclaim and confirmMomentum) <= confirmBars
seedConfirmation = setupFresh and confirmationLogic
baseCross = ta.crossover(fastEma, slowEma)
pullbackContinuation = low < fastEma and close > fastEma and close[1] <= fastEma[1]
slot1Entry = (seedConfirmation or baseCross or pullbackContinuation) and softTrendQualified and not trendDownRegime and notLateExtension

var int posEntryBarIndex = na
var float peakOpenPnLAtr = na
var int entryCountInCycle = 0
var float slot1Price = na
var float slot2Price = na
var int slot1Bar = na
var int slot2Bar = na

newPos = strategy.position_size > 0 and strategy.position_size[1] <= 0
flatNow = strategy.position_size <= 0
if flatNow
    posEntryBarIndex := na
    peakOpenPnLAtr := na
    entryCountInCycle := 0
    slot1Price := na
    slot2Price := na
    slot1Bar := na
    slot2Bar := na

if slot1Entry and strategy.position_size <= 0
    strategy.entry("L1", strategy.long, qty_percent=25)

avgPrice = strategy.position_avg_price
barsInTrade = na(posEntryBarIndex) ? 0 : bar_index - posEntryBarIndex
openPnLAtr = strategy.position_size > 0 ? (close - avgPrice) / atrValue : 0.0
peakOpenPnLAtr := strategy.position_size > 0 ? math.max(nz(peakOpenPnLAtr, openPnLAtr), openPnLAtr) : na
profitRetraceAtr = strategy.position_size > 0 ? nz(peakOpenPnLAtr, 0.0) - openPnLAtr : 0.0

if newPos
    posEntryBarIndex := bar_index
    peakOpenPnLAtr := 0.0
    entryCountInCycle := 1
    slot1Price := strategy.position_avg_price
    slot1Bar := bar_index

slot2Signal = strategy.position_size > 0 and entryCountInCycle == 1 and seedConfirmation and openPnLAtr <= slot2DrawdownAtr and close > slowEma and not trendDownRegime
if slot2Signal
    strategy.entry("L2", strategy.long, qty_percent=25)
    entryCountInCycle += 1
    slot2Price := close
    slot2Bar := bar_index

replaceSlot2 = strategy.position_size > 0 and entryCountInCycle >= 2 and setupFresh and confirmReclaim and close < nz(slot2Price, close) - atrValue * replacementBetterAtr and barsInTrade >= 1
if replaceSlot2
    strategy.close("L2")
    strategy.entry("L2", strategy.long, qty_percent=25)
    slot2Price := close
    slot2Bar := bar_index

hardStop = strategy.position_size > 0 ? avgPrice - atrValue * stopAtrMult : na
trailStop = strategy.position_size > 0 ? close - atrValue * trailAtrMult : na
activeStop = strategy.position_size > 0 ? math.max(hardStop, trailStop) : na
strategy.exit("XL1", "L1", stop=activeStop)
strategy.exit("XL2", "L2", stop=activeStop)

stage1Bearish = strategy.position_size > 0 and close < fastEma and (rsiValue < weakMomentumRsi or minusDI > plusDI)
stage2Bearish = strategy.position_size > 0 and close < slowEma and minusDI > plusDI and adx > minAdx
emaFailureExit = strategy.position_size > 0 and stage2Bearish and rsiValue < 47
stalledLoserExit = strategy.position_size > 0 and barsInTrade >= lossBarsExit and openPnLAtr < -0.3 and close < fastEma
quickTrendLossExit = strategy.position_size > 0 and barsInTrade >= 2 and openPnLAtr <= quickLossAtr and (minusDI > plusDI or close < slowEma)
rangeWeakExit = strategy.position_size > 0 and barsInTrade >= 2 and (rangeRegime or rangeSqueezeRegime) and openPnLAtr <= rangeWeakLossAtr and close < fastEma and rsiValue < weakMomentumRsi
rangeSqueezeMomentumExit = strategy.position_size > 0 and barsInTrade >= 1 and rangeSqueezeRegime and openPnLAtr <= 0.1 and (rsiValue < weakMomentumRsi or rsiValue < rsiValue[1] or not ta.rising(close, 2)) and close < fastEma
compressionQuickLossExit = strategy.position_size > 0 and barsInTrade >= 2 and rangeSqueezeRegime and openPnLAtr <= rangeQuickLossAtr
deeperDrawdownExit = strategy.position_size > 0 and barsInTrade >= 3 and openPnLAtr <= deepDrawdownAtr and (close < fastEma or minusDI > plusDI)
timeExit = strategy.position_size > 0 and barsInTrade >= maxBarsInTrade and openPnLAtr < 0.6
trendReversalExit = strategy.position_size > 0 and stage2Bearish
profitProtectionExit = strategy.position_size > 0 and peakOpenPnLAtr > 0.9 and profitRetraceAtr >= retraceExitAtr and close < fastEma
stage1Reduce = strategy.position_size > 0 and entryCountInCycle >= 2 and stage1Bearish and rangeSqueezeRegime and openPnLAtr < 0.35
if stage1Reduce
    strategy.close("L2")

manualExit = emaFailureExit or stalledLoserExit or quickTrendLossExit or rangeWeakExit or rangeSqueezeMomentumExit or compressionQuickLossExit or deeperDrawdownExit or timeExit or trendReversalExit or profitProtectionExit
if manualExit
    strategy.close("L1")
    strategy.close("L2")

plot(fastEma, "Fast EMA", color=color.new(color.teal, 0))
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0))
plot(reclaimLevel, "Reclaim Level", color=color.new(color.blue, 70))