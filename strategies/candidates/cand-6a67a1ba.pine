//@version=5
strategy("AF Seed 01 - Event Reclaim Reversal [cand-6a67a1ba]", overlay=true, pyramiding=30, process_orders_on_close=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=5, commission_type=strategy.commission.percent, commission_value=0.05)

groupSig = "1. Exhaustion"
L1 = input.int(9, "L1", minval=2, group=groupSig)
L2 = input.int(12, "L2", minval=3, group=groupSig)
L3 = input.int(14, "L3", minval=4, group=groupSig)
confirmBars = input.int(2, "confirmBars", minval=1, maxval=5, group=groupSig)

groupFilter = "2. Filters"
emaLen = input.int(21, "emaLen", minval=1, group=groupFilter)
baseEmaLen = input.int(55, "baseEmaLen", minval=1, group=groupFilter)
rsiLen = input.int(14, "rsiLen", minval=2, group=groupFilter)
maxExtPct = input.float(6.0, "maxExtPct", minval=1.0, step=0.5, group=groupFilter)
riskOffRsi = input.float(45.0, "riskOffRsi", minval=5.0, maxval=95.0, step=0.5, group=groupFilter)

groupPos = "3. Slots"
slotPct = input.float(5.0, "slotPct", minval=0.1, maxval=100.0, step=0.5, group=groupPos)
maxSlots = input.int(8, "maxSlots", minval=1, maxval=50, group=groupPos)
useReplacement = input.bool(true, "useReplacement", group=groupPos)
replaceMinRank = input.int(2, "replaceMinRank", minval=1, maxval=4, group=groupPos)
replaceIfPnlBelow = input.float(-0.5, "replaceIfPnlBelow", step=0.1, group=groupPos)
applyFilterToB1 = input.bool(false, "applyFilterToB1", group=groupPos)
minQty = input.float(1.0, "minQty", minval=0.000001, step=0.1, group=groupPos)

groupExit = "4. Exits"
closeAllOnBearConfRiskOff = input.bool(true, "closeAllOnBearConfRiskOff", group=groupExit)

groupExec = "5. Execution"
sameBarConflictMode = input.string("StrongWins", "sameBarConflictMode", options=["StrongWins", "SkipBoth", "BearPriority"], group=groupExec)
trendMode = input.string("Balanced", "trendMode", options=["Strict", "Balanced", "Loose"], group=groupExec)
allowStrongCounterTrend = input.bool(true, "allowStrongCounterTrend", group=groupExec)
entryCooldownBars = input.int(1, "entryCooldownBars", minval=0, maxval=20, group=groupExec)
useRealFillSync = input.bool(true, "useRealFillSync", group=groupExec)
resetOnL3 = input.bool(false, "resetOnL3", group=groupExec)

groupST = "6. Supertrend"
useSupertrendFilter = input.bool(false, "useSupertrendFilter", group=groupST)
supertrendAtrPeriod = input.int(10, "supertrendAtrPeriod", minval=1, group=groupST)
supertrendFactor = input.float(3.0, "supertrendFactor", minval=0.1, step=0.1, group=groupST)
supertrendBlocksWeakBull = input.bool(false, "supertrendBlocksWeakBull", group=groupST)
supertrendRiskOffEnabled = input.bool(false, "supertrendRiskOffEnabled", group=groupST)

groupWeak = "7. Weak Range Exit"
enableWeakRangeExit = input.bool(true, "enableWeakRangeExit", group=groupWeak)
weakExitAtrLen = input.int(14, "weakExitAtrLen", minval=1, group=groupWeak)
weakExitBars = input.int(5, "weakExitBars", minval=1, maxval=20, group=groupWeak)
weakRunupAtrMax = input.float(1.2, "weakRunupAtrMax", minval=0.1, step=0.1, group=groupWeak)
weakLossAtrMin = input.float(-0.3, "weakLossAtrMin", step=0.1, group=groupWeak)
weakSlopeAtrMax = input.float(0.15, "weakSlopeAtrMax", minval=0.0, step=0.05, group=groupWeak)

groupRoute = "8. Event Reclaim Route"
reclaimLookback = input.int(3, "reclaimLookback", minval=1, maxval=10, group=groupRoute)
reclaimWindowBars = input.int(5, "reclaimWindowBars", minval=1, maxval=20, group=groupRoute)
maxHoldBars = input.int(10, "maxHoldBars", minval=1, maxval=50, group=groupRoute)
minReclaimBodyPct = input.float(0.15, "minReclaimBodyPct", minval=0.0, maxval=1.0, step=0.05, group=groupRoute)
useProfitGateOnBear2 = input.bool(true, "useProfitGateOnBear2", group=groupRoute)

groupView = "9. View"
showEMAs = input.bool(true, "showEMAs", group=groupView)
showSignals = input.bool(true, "showSignals", group=groupView)
showConfMark = input.bool(true, "showConfMark", group=groupView)
showDebugMarks = input.bool(false, "showDebugMarks", group=groupView)

L2v = math.max(L2, L1 + 1)
L3v = math.max(L3, L2v + 1)
ema = ta.ema(close, emaLen)
baseEMA = ta.ema(close, baseEmaLen)
rsi = ta.rsi(close, rsiLen)
atrWeak = ta.atr(weakExitAtrLen)
atrSt = ta.atr(supertrendAtrPeriod)

overextended = close > ema * (1.0 + maxExtPct / 100.0)
emaUp = not na(ema[1]) and ema >= ema[1]
emaDown = not na(ema[1]) and ema <= ema[1]

upperBasic = hl2 + supertrendFactor * atrSt
lowerBasic = hl2 - supertrendFactor * atrSt
var float finalUpper = na
var float finalLower = na
var bool stUpTrend = true
finalUpper := na(finalUpper[1]) ? upperBasic : (upperBasic < finalUpper[1] or close[1] > finalUpper[1] ? upperBasic : finalUpper[1])
finalLower := na(finalLower[1]) ? lowerBasic : (lowerBasic > finalLower[1] or close[1] < finalLower[1] ? lowerBasic : finalLower[1])
stUpTrend := na(stUpTrend[1]) ? true : (stUpTrend[1] ? close < finalLower[1] ? false : true : close > finalUpper[1] ? true : false)
supertrendBull = stUpTrend

riskOffBase = close < baseEMA and rsi < riskOffRsi and emaDown
riskOff = riskOffBase or (supertrendRiskOffEnabled and useSupertrendFilter and not supertrendBull)

var int cycle = 0
var int bull = 0
var int bear = 0
has4 = bar_index >= 4 and not na(close[4])
has2 = bar_index >= 2 and not na(close[2])

f_reset() =>
    int nb = 0
    int ns = 0
    int nc = 0
    if has4
        if close < close[4]
            nb := 1
            nc := 1
        else if close > close[4]
            ns := 1
            nc := 1
    [nb, ns, nc]

if not has4
    bull := 0
    bear := 0
    cycle := 0
else
    if cycle < L1
        if close < close[4]
            bull := bull + 1
            bear := 0
            cycle := bull
        else if close > close[4]
            bear := bear + 1
            bull := 0
            cycle := bear
        else
            [nb, ns, nc] = f_reset()
            bull := nb
            bear := ns
            cycle := nc
    else
        if bull > 0
            if has2 and close < close[2]
                bull := bull + 1
                cycle := bull
            else
                [nb, ns, nc] = f_reset()
                bull := nb
                bear := ns
                cycle := nc
        else if bear > 0
            if has2 and close > close[2]
                bear := bear + 1
                cycle := bear
            else
                [nb, ns, nc] = f_reset()
                bull := nb
                bear := ns
                cycle := nc
        else
            [nb, ns, nc] = f_reset()
            bull := nb
            bear := ns
            cycle := nc

bullL1 = bull == L1
bullL2 = bull == L2v
bullL3 = bull == L3v
bearL1 = bear == L1
bearL2 = bear == L2v
bearL3 = bear == L3v

var int bullSignalBar = na
var int bearSignalBar = na
if bullL2 or bullL3
    bullSignalBar := bar_index
if bearL2 or bearL3
    bearSignalBar := bar_index

bullConfirmed = not na(bullSignalBar) and bar_index > bullSignalBar and (bar_index - bullSignalBar <= confirmBars) and close > high[1]
bearConfirmed = not na(bearSignalBar) and bar_index > bearSignalBar and (bar_index - bearSignalBar <= confirmBars) and close < low[1]

if bullConfirmed or (not na(bullSignalBar) and bar_index - bullSignalBar > confirmBars)
    bullSignalBar := na
if bearConfirmed or (not na(bearSignalBar) and bar_index - bearSignalBar > confirmBars)
    bearSignalBar := na

newBullL1 = bullL1 and not nz(bullL1[1], false)
newBullL2 = bullL2 and not nz(bullL2[1], false)
newBullL3 = bullL3 and not nz(bullL3[1], false)
newBullConf = bullConfirmed and not nz(bullConfirmed[1], false)
newBearL1 = bearL1 and not nz(bearL1[1], false)
newBearL2 = bearL2 and not nz(bearL2[1], false)
newBearL3 = bearL3 and not nz(bearL3[1], false)
newBearConf = bearConfirmed and not nz(bearConfirmed[1], false)

bullEventRaw = newBullConf ? 4 : newBullL3 ? 3 : newBullL2 ? 2 : newBullL1 ? 1 : 0
bearEventRaw = newBearConf ? 4 : newBearL3 ? 3 : newBearL2 ? 2 : newBearL1 ? 1 : 0

f_resolve_conflict(int bullEv, int bearEv) =>
    int resolvedBull = 0
    int resolvedBear = 0
    if bullEv > 0 and bearEv > 0
        if sameBarConflictMode == "BearPriority"
            resolvedBear := bearEv
        else if sameBarConflictMode == "SkipBoth"
            resolvedBull := 0
            resolvedBear := 0
        else
            if bullEv > bearEv
                resolvedBull := bullEv
            else if bearEv > bullEv
                resolvedBear := bearEv
            else
                if close > ema and rsi >= 50
                    resolvedBull := bullEv
                else
                    resolvedBear := bearEv
    else
        resolvedBull := bullEv
        resolvedBear := bearEv
    [resolvedBull, resolvedBear]

[finalBullEvent, finalBearEvent] = f_resolve_conflict(bullEventRaw, bearEventRaw)

var int lastBullEventBar = na
var int lastBearEventBar = na
var int lastBullEventRank = 0
var int lastBearEventRank = 0
if finalBullEvent > 0
    lastBullEventBar := bar_index
    lastBullEventRank := finalBullEvent
if finalBearEvent > 0
    lastBearEventBar := bar_index
    lastBearEventRank := finalBearEvent

bullWindowActive = not na(lastBullEventBar) and bar_index >= lastBullEventBar and bar_index - lastBullEventBar <= reclaimWindowBars
bearWindowActive = not na(lastBearEventBar) and bar_index >= lastBearEventBar and bar_index - lastBearEventBar <= reclaimWindowBars

bodyPct = high != low ? math.abs(close - open) / (high - low) : 0.0
recentLowest = ta.lowest(low, reclaimLookback)
reclaimFromBullEvent = bullWindowActive and close > ema and close > open and bodyPct >= minReclaimBodyPct and (not applyFilterToB1 or lastBullEventRank >= 2 or not overextended)
failedBreakdownReclaim = bearWindowActive and low <= recentLowest and close > low[1] and close > open and bodyPct >= minReclaimBodyPct and not overextended

trendPass = trendMode == "Loose" ? true : trendMode == "Balanced" ? close >= ema or emaUp : close >= ema and emaUp
counterTrendPass = allowStrongCounterTrend and lastBearEventRank >= 3 and close >= ema
supertrendPass = not useSupertrendFilter or supertrendBull or (allowStrongCounterTrend and lastBearEventRank >= 3 and not supertrendBlocksWeakBull)
primaryEntryTrigger = ((reclaimFromBullEvent and trendPass) or (failedBreakdownReclaim and (trendPass or counterTrendPass))) and supertrendPass
entryPass = primaryEntryTrigger and not riskOff

var slotIds = array.new_string()
var slotEntry = array.new_float()
var slotRank = array.new_int()
var slotEntryBar = array.new_int()
var slotSource = array.new_int()
var int nextSlotNo = 1
var int lastLongEntryBar = na
var int lastOrderBar = na

f_entry_qty(float pct) =>
    float rawQty = close > 0 ? (strategy.equity * (pct * 0.01)) / close : 0.0
    math.max(rawQty, minQty)

f_slot_pnl_pct(int idx) =>
    float ep = array.get(slotEntry, idx)
    ep > 0 ? (close - ep) / ep * 100.0 : 0.0

f_find_open_trade_idx(string entryId) =>
    int foundIdx = na
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            if na(foundIdx) and strategy.opentrades.entry_id(i) == entryId
                foundIdx := i
    foundIdx

f_sync_slot_entries() =>
    if useRealFillSync and array.size(slotIds) > 0 and strategy.opentrades > 0
        for i = 0 to array.size(slotIds) - 1
            string sid = array.get(slotIds, i)
            int openIdx = f_find_open_trade_idx(sid)
            if not na(openIdx)
                array.set(slotEntry, i, strategy.opentrades.entry_price(openIdx))

f_find_weakest_idx() =>
    int weakestIdx = na
    float worstPnl = na
    int worstRank = na
    if array.size(slotEntry) > 0
        for i = 0 to array.size(slotEntry) - 1
            float pnl = f_slot_pnl_pct(i)
            int rk = array.get(slotRank, i)
            if na(weakestIdx)
                weakestIdx := i
                worstPnl := pnl
                worstRank := rk
            else if pnl < worstPnl or (math.abs(pnl - worstPnl) < 0.0001 and rk < worstRank)
                weakestIdx := i
                worstPnl := pnl
                worstRank := rk
    weakestIdx

f_close_slot(int idx) =>
    if idx >= 0 and idx < array.size(slotIds)
        string idToClose = array.get(slotIds, idx)
        strategy.close(idToClose, immediately=true)
        array.remove(slotIds, idx)
        array.remove(slotEntry, idx)
        array.remove(slotRank, idx)
        array.remove(slotEntryBar, idx)
        array.remove(slotSource, idx)

if strategy.position_size == 0 and array.size(slotIds) > 0 and (na(lastOrderBar) or bar_index > lastOrderBar)
    array.clear(slotIds)
    array.clear(slotEntry)
    array.clear(slotRank)
    array.clear(slotEntryBar)
    array.clear(slotSource)
else
    f_sync_slot_entries()

canEnterLong = na(lastLongEntryBar) or bar_index - lastLongEntryBar >= entryCooldownBars + 1
slotAvailable = array.size(slotIds) < maxSlots
qtyNow = f_entry_qty(slotPct)
qtyOK = qtyNow > 0
entryRank = reclaimFromBullEvent ? math.max(lastBullEventRank, 2) : failedBreakdownReclaim ? math.max(lastBearEventRank, 2) : 1
entrySourceCode = reclaimFromBullEvent ? 1 : failedBreakdownReclaim ? 2 : 0

if entryPass and canEnterLong and qtyOK
    if slotAvailable
        string newId = "L_" + str.tostring(nextSlotNo)
        nextSlotNo += 1
        strategy.entry(newId, strategy.long, qty=qtyNow)
        array.push(slotIds, newId)
        array.push(slotEntry, close)
        array.push(slotRank, entryRank)
        array.push(slotEntryBar, bar_index)
        array.push(slotSource, entrySourceCode)
        lastLongEntryBar := bar_index
        lastOrderBar := bar_index
    else if useReplacement and entryRank >= replaceMinRank
        int weakIdx = f_find_weakest_idx()
        if not na(weakIdx)
            float weakPnl = f_slot_pnl_pct(weakIdx)
            int weakRank = array.get(slotRank, weakIdx)
            bool canReplace = weakPnl <= replaceIfPnlBelow or entryRank > weakRank
            if canReplace
                f_close_slot(weakIdx)
                lastOrderBar := bar_index
                string newId = "L_" + str.tostring(nextSlotNo)
                nextSlotNo += 1
                strategy.entry(newId, strategy.long, qty=qtyNow)
                array.push(slotIds, newId)
                array.push(slotEntry, close)
                array.push(slotRank, entryRank)
                array.push(slotEntryBar, bar_index)
                array.push(slotSource, entrySourceCode)
                lastLongEntryBar := bar_index
                lastOrderBar := bar_index

if array.size(slotIds) > 0
    for step = 0 to 49
        if step < array.size(slotIds)
            int idx = array.size(slotIds) - 1 - step
            if idx >= 0 and idx < array.size(slotIds)
                int heldBars = bar_index - array.get(slotEntryBar, idx)
                float ep = array.get(slotEntry, idx)
                float pnlAtr = atrWeak > 0 ? (close - ep) / atrWeak : 0.0
                float slopeAtr = atrWeak > 0 and not na(ema[weakExitBars]) ? (ema - ema[weakExitBars]) / atrWeak : 0.0
                float runupAtr = atrWeak > 0 ? (high - ep) / atrWeak : 0.0
                bool weakRangeExit = enableWeakRangeExit and heldBars >= weakExitBars and runupAtr <= weakRunupAtrMax and pnlAtr <= weakLossAtrMin and slopeAtr <= weakSlopeAtrMax
                bool timedExit = heldBars >= maxHoldBars
                bool bearPressureExit = finalBearEvent >= 3 or (finalBearEvent == 2 and (not useProfitGateOnBear2 or f_slot_pnl_pct(idx) > 0))
                if weakRangeExit or timedExit or bearPressureExit
                    f_close_slot(idx)
                    lastOrderBar := bar_index

if finalBearEvent > 0 and array.size(slotIds) > 0
    if finalBearEvent == 1
        int weakIdx1 = f_find_weakest_idx()
        if not na(weakIdx1) and f_slot_pnl_pct(weakIdx1) < 0
            f_close_slot(weakIdx1)
            lastOrderBar := bar_index
    if finalBearEvent == 4 and closeAllOnBearConfRiskOff and riskOff
        for step = 0 to 49
            if array.size(slotIds) > 0
                int weakIdx4 = f_find_weakest_idx()
                if not na(weakIdx4)
                    f_close_slot(weakIdx4)
                    lastOrderBar := bar_index

if resetOnL3 and (bull == L3v or bear == L3v)
    bull := 0
    bear := 0
    cycle := 0

plot(showEMAs ? ema : na, "EMA", color=color.orange, linewidth=1)
plot(showEMAs ? baseEMA : na, "Base EMA", color=color.red, linewidth=2)
plot(showEMAs and useSupertrendFilter ? finalLower : na, "ST Lower", color=color.new(color.green, 60), linewidth=1)
plot(showEMAs and useSupertrendFilter ? finalUpper : na, "ST Upper", color=color.new(color.red, 60), linewidth=1)

plotshape(showSignals and bullL1, title="B1", location=location.belowbar, color=color.new(color.green, 65), style=shape.circle, size=size.tiny, text="B1")
plotshape(showSignals and bullL2, title="B2", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small, text="B2")
plotshape(showSignals and bullL3, title="B3", location=location.belowbar, color=color.lime, style=shape.diamond, size=size.small, text="B3")
plotshape(showSignals and bearL1, title="S1", location=location.abovebar, color=color.new(color.red, 65), style=shape.circle, size=size.tiny, text="S1")
plotshape(showSignals and bearL2, title="S2", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small, text="S2")
plotshape(showSignals and bearL3, title="S3", location=location.abovebar, color=color.maroon, style=shape.diamond, size=size.small, text="S3")
plotshape(showConfMark and bullConfirmed, title="BCONF", location=location.belowbar, color=color.blue, style=shape.labelup, size=size.small, text="BC")
plotshape(showConfMark and bearConfirmed, title="SCONF", location=location.abovebar, color=color.orange, style=shape.labeldown, size=size.small, text="SC")

plotchar(showDebugMarks ? primaryEntryTrigger : na, title="primaryEntryTrigger", char="P", location=location.top, color=color.lime, size=size.tiny)
plotchar(showDebugMarks ? entryPass : na, title="entryPass", char="E", location=location.top, color=color.green, size=size.tiny)
plotchar(showDebugMarks ? riskOff : na, title="riskOff", char="R", location=location.bottom, color=color.red, size=size.tiny)
plotchar(showDebugMarks ? reclaimFromBullEvent : na, title="reclaimFromBullEvent", char="U", location=location.top, color=color.aqua, size=size.tiny)
plotchar(showDebugMarks ? failedBreakdownReclaim : na, title="failedBreakdownReclaim", char="F", location=location.top, color=color.yellow, size=size.tiny)

alertcondition(newBullL1, title="New B1", message="New B1: {{ticker}}")
alertcondition(newBullL2, title="New B2", message="New B2: {{ticker}}")
alertcondition(newBullL3, title="New B3", message="New B3: {{ticker}}")
alertcondition(newBullConf, title="New BCONF", message="New BCONF: {{ticker}}")
alertcondition(newBearL1, title="New S1", message="New S1: {{ticker}}")
alertcondition(newBearL2, title="New S2", message="New S2: {{ticker}}")
alertcondition(newBearL3, title="New S3", message="New S3: {{ticker}}")
alertcondition(newBearConf, title="New SCONF", message="New SCONF: {{ticker}}")
