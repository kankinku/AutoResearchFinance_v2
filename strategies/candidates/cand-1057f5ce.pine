//@version=5
strategy("AF Mutation QQQ 120m [ext-gate+dmi-exit] [cand-1057f5ce]", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.1, pyramiding=0, process_orders_on_close=true)

fastLength = input.int(21, "Fast EMA", minval=1)
slowLength = input.int(55, "Slow EMA", minval=2)
rsiLength = input.int(14, "RSI Length", minval=2)
adxLen = input.int(14, "ADX Length", minval=2)
adxMin = input.float(16.0, "ADX Min", step=0.1)
entryRsiMin = input.float(53.0, "Entry RSI Min", step=0.1)
exitRsiMin = input.float(47.0, "Exit RSI Threshold", step=0.1)
extLookback = input.int(8, "Extension Lookback", minval=2)
extAtrMult = input.float(0.9, "Max Extension ATR Multiple", step=0.1)
stopAtrMult = input.float(2.0, "Initial Stop ATR Multiple", step=0.1)
profitAtrMult = input.float(3.2, "Target ATR Multiple", step=0.1)
breakEvenTriggerAtr = input.float(1.2, "Break-even Trigger ATR", step=0.1)
timeStopBars = input.int(22, "Max Bars In Trade", minval=2)
weakBarsArmed = input.int(4, "Weak Momentum Exit Bars", minval=1)

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(14)

upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0
tr = ta.tr(true)
trRma = ta.rma(tr, adxLen)
plusDI = trRma == 0.0 ? 0.0 : 100.0 * ta.rma(plusDM, adxLen) / trRma
minusDI = trRma == 0.0 ? 0.0 : 100.0 * ta.rma(minusDM, adxLen) / trRma
dx = (plusDI + minusDI == 0.0) ? 0.0 : 100.0 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adxValue = ta.rma(dx, adxLen)

emaSpread = fastEma - slowEma
emaSpreadRising = emaSpread > emaSpread[1]
trendFilter = close > slowEma and fastEma > slowEma and emaSpreadRising

overExtended = close >= ta.highest(close, extLookback) - syminfo.mintick and (close - fastEma) > atrValue * extAtrMult
notLateEntry = not overExtended
trendStrengthOk = adxValue > adxMin and plusDI > minusDI

longEntry = ta.crossover(fastEma, slowEma) and rsiValue > entryRsiMin and trendFilter and trendStrengthOk and notLateEntry

var int barsInTrade = 0
var int weakCount = 0
if strategy.position_size > 0
    barsInTrade += 1
else
    barsInTrade := 0
    weakCount := 0

entryPrice = strategy.position_avg_price
openProfitAtr = strategy.position_size > 0 ? (close - entryPrice) / atrValue : 0.0
breakEvenArmed = strategy.position_size > 0 and openProfitAtr >= breakEvenTriggerAtr

initialStop = strategy.position_size > 0 ? entryPrice - atrValue * stopAtrMult : na
breakEvenStop = strategy.position_size > 0 ? entryPrice + syminfo.mintick : na
activeStop = strategy.position_size > 0 ? (breakEvenArmed ? math.max(initialStop, breakEvenStop) : initialStop) : na
targetPrice = strategy.position_size > 0 ? entryPrice + atrValue * profitAtrMult : na

weakMomentum = strategy.position_size > 0 and (rsiValue < 50 or plusDI < minusDI or close < fastEma)
if strategy.position_size > 0
    weakCount := weakMomentum ? weakCount + 1 : 0

momentumExit = strategy.position_size > 0 and weakCount >= weakBarsArmed
crossExit = strategy.position_size > 0 and ta.crossunder(fastEma, slowEma)
rsiExit = strategy.position_size > 0 and rsiValue < exitRsiMin and close < fastEma
timeExit = strategy.position_size > 0 and barsInTrade >= timeStopBars
hardExit = crossExit or rsiExit or momentumExit or timeExit

if longEntry and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0
    strategy.exit("XL", "Long", stop=activeStop, limit=targetPrice)

if hardExit
    strategy.close("Long")

plot(fastEma, "Fast EMA", color=color.new(color.teal, 0))
plot(slowEma, "Slow EMA", color=color.new(color.orange, 0))
plot(strategy.position_size > 0 ? activeStop : na, "Active Stop", color=color.new(color.red, 0), style=plot.style_linebr)
plot(strategy.position_size > 0 ? targetPrice : na, "Target", color=color.new(color.green, 0), style=plot.style_linebr)
plotshape(longEntry, title="Long Entry", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny)
plotshape(overExtended, title="Blocked Late Entry", style=shape.circle, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny)
